:"We compare reconstruction MSE and convergence behaviour.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"ldhxaoKBTb"}],"key":"LA1Mhrcq8f"}],"identifier":"a6e234ec","html_id":"a6e234ec","key":"qfsHrpsK5H"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:31:47.035320Z","iopub.status.busy":"2026-11-10T15:31:47.035131Z","iopub.status.idle":"2026-11-10T15:31:49.279772Z","shell.execute_reply":"2026-11-10T15:31:49.278828Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import jax\nimport jax.numpy as jnp\nimport matplotlib.pyplot as plt\n\nimport vardax\nfrom vardax import (\n    Batch1D,\n    BilinAEPrior1D,\n    FourDVarNet1D,\n    variational_cost,\n    variational_cost_grad,\n    decomposed_loss,\n)\nfrom vardax._src.utils.dynamical_systems import simulate_lorenz63\nfrom vardax._src.utils.patches import trajectory_to_xr_dataset, extract_patches\nfrom vardax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import xr_to_batch1d\nfrom vardax._src.utils.standardize import compute_scaler_params, apply_standardization","key":"KcRBZkx3k9"},{"type":"outputs","id":"R3fBA87G_P0jgMg7Cl3M5","children":[],"key":"ooeda7aidN"}],"identifier":"8feaff54","html_id":"8feaff54","key":"qCE2KKFifi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Prepare L63 data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E5h5uE5m4s"}],"identifier":"id-1-prepare-l63-data","label":"1. Prepare L63 data","html_id":"id-1-prepare-l63-data","implicit":true,"key":"MN6hSivFQB"}],"identifier":"7afda007","html_id":"7afda007","key":"n81ApAuhgU"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:31:49.282076Z","iopub.status.busy":"2026-11-10T15:31:49.281555Z","iopub.status.idle":"2026-11-10T15:31:50.460980Z","shell.execute_reply":"2026-11-10T15:31:50.460122Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\ntime_coords, states = simulate_lorenz63(\n    key, sigma=10.0, rho=28.0, beta=8.0 / 3.0, dt=0.01, n_steps=5000, n_burn_in=1000\n)\nds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\n# Split the trajectory in time *before* cutting windows, so no window\n# straddles the boundary: windows drawn at random from one trajectory and\n# split afterwards would leak test timesteps into the training set.\nn_time = ds.sizes[\"time\"]\nds_train = extract_patches(ds.isel(time=slice(0, int(0.8 * n_time))), n_patches=160, n_timesteps=20, seed=42)\nds_test = extract_patches(ds.isel(time=slice(int(0.8 * n_time), None)), n_patches=40, n_timesteps=20, seed=43)\nds_train = regular_mask(ds_train, variable=\"state\", obs_interval=2)\nds_test = regular_mask(ds_test, variable=\"state\", obs_interval=2)\nds_train = add_gaussian_noise(ds_train, variable=\"state\", sigma=0.5, seed=0, name=\"obs\")\nds_test = add_gaussian_noise(ds_test, variable=\"state\", sigma=0.5, seed=1, name=\"obs\")\nmean, std = compute_scaler_params(ds_train, variable=\"state\", mask_variable=\"mask\")\nds_train = apply_standardization(ds_train, variables=[\"state\", \"obs\"], mean=mean, std=std)\nds_test = apply_standardization(ds_test, variables=[\"state\", \"obs\"], mean=mean, std=std)\n\nbatch_train = xr_to_batch1d(ds_train, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nbatch_test = xr_to_batch1d(ds_test, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nB, T, N = batch_test.input.shape\nprint(f\"Test batch shape: {batch_test.input.shape}\")","key":"SOHrxS3TaQ"},{"type":"outputs","id":"vwGtW8IlFGqv8iiZH9cG8","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Test batch shape: (40, 20, 3)\n"},"children":[],"key":"GTTzDLuSz0"}],"key":"iPOnbINUAq"}],"identifier":"8ab88ebd","html_id":"8ab88ebd","key":"sPw3QbrV8r"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Classical 4DVar — gradient descent on ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iMhsuGwIaJ"},{"type":"inlineMath","value":"x","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"OSyra0Erka"}],"identifier":"id-2-classical-4dvar-gradient-descent-on-x","label":"2. Classical 4DVar — gradient descent on x","html_id":"id-2-classical-4dvar-gradient-descent-on-x","implicit":true,"key":"s6yCfjbcL4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"We use a fixed prior — a bilinear autoencoder pre-trained on clean training\nwindows, as in notebook ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kYYzxP3Chu"},{"type":"link","url":"/notebooks/prior-pretraining-l63","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"07","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wuMj7b390b"}],"urlSource":"07_prior_pretraining_L63.ipynb","dataUrl":"/notebooks.prior-pretraining-l63.json","internal":true,"protocol":"file","key":"CT1g3YFIeJ"},{"type":"text","value":" — and minimise\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EvVf2R6MpN"},{"type":"inlineMath","value":"U(x)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>U</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">U(x)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10903em;\">U</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span></span></span></span>","key":"sLFtWMnAWh"},{"type":"text","value":" with respect to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yIpAEi0Bgq"},{"type":"inlineMath","value":"x","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"MbQUjAmDJp"},{"type":"text","value":" directly, running a manual gradient-descent loop\nso we can track the convergence trajectory.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CTHnCKiol0"}],"key":"KgRfujkrgR"}],"identifier":"f6ee41ad","html_id":"f6ee41ad","key":"Oy6yzMacWq"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:31:50.462551Z","iopub.status.busy":"2026-11-10T15:31:50.462377Z","iopub.status.idle":"2026-11-10T15:31:52.246275Z","shell.execute_reply":"2026-11-10T15:31:52.245532Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import equinox as eqx\nimport optax\n\nprior = BilinAEPrior1D(state_dim=N, latent_dim=8, n_time=T, key=jax.random.PRNGKey(5))\npre_opt = optax.adam(1e-2)\npre_state = pre_opt.init(eqx.filter(prior, eqx.is_array))\n\n\n@eqx.filter_jit\ndef pretrain_step(prior, opt_state, x):\n    loss, grads = eqx.filter_value_and_grad(lambda p: jnp.mean((x - p(x)) ** 2))(prior)\n    updates, opt_state = pre_opt.update(grads, opt_state, prior)\n    return eqx.apply_updates(prior, updates), opt_state, loss\n\n\nfor _ in range(300):\n    prior, pre_state, pre_loss = pretrain_step(prior, pre_state, batch_train.target)\nprint(f\"prior reconstruction MSE after pre-training: {float(pre_loss):.4f}\")\n\n\n# Initialise x from masked observations\nx_classical = batch_test.input * batch_test.mask\n\nclassical_losses = []\n# `variational_cost` is a *mean* over all B*T*N elements, so its gradient per\n# element is tiny. Scaling the step by the element count gives a per-element\n# step size `eta` (gradient descent on the equivalent sum cost), which lets\n# the baseline actually converge within the step budget.\neta_classical = 0.2\nn_classical_steps = 50\nn_elem = x_classical.size\n\ngrad_fn = jax.jit(jax.value_and_grad(variational_cost))\n\nfor step in range(n_classical_steps):\n    loss_val, grad = grad_fn(\n        x_classical, batch_test, prior, alpha_obs=0.5, alpha_prior=0.5\n    )\n    x_classical = x_classical - eta_classical * n_elem * grad\n    classical_losses.append(float(loss_val))\n\nmse_classical = float(jnp.mean((x_classical - batch_test.target) ** 2))\nprint(f\"Classical 4DVar MSE after {n_classical_steps} steps: {mse_classical:.4f}\")\n\n# Decomposed loss at convergence\ndl = decomposed_loss(x_classical, batch_test, prior)\nprint(\n    f\"  obs={float(dl['obs']):.4f}, prior={float(dl['prior']):.4f}, total={float(dl['total']):.4f}\"\n)","key":"CHzc8tr1kr"},{"type":"outputs","id":"V4kgeM2f-k3XDYUuNEiYk","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"prior reconstruction MSE after pre-training: 0.0057\n"},"children":[],"key":"HK4VYsEsc5"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Classical 4DVar MSE after 50 steps: 0.0067\n"},"children":[],"key":"bhhHx96QOY"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  obs=0.0007, prior=0.0009, total=0.0016\n"},"children":[],"key":"RRHmoVeOpt"}],"key":"d5j6uBjPwJ"}],"identifier":"aa0948a6","html_id":"aa0948a6","key":"rKYVEEoZnP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. 4DVarNet — trained end-to-end","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"I6lALk7O7I"}],"identifier":"id-3-4dvarnet-trained-end-to-end","label":"3. 4DVarNet — trained end-to-end","html_id":"id-3-4dvarnet-trained-end-to-end","implicit":true,"key":"w1ghIEd8sY"}],"identifier":"b5bdfdfa","html_id":"b5bdfdfa","key":"kWhgnUKJBy"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:31:52.248200Z","iopub.status.busy":"2026-11-10T15:31:52.248022Z","iopub.status.idle":"2026-11-10T15:31:58.064451Z","shell.execute_reply":"2026-11-10T15:31:58.063720Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = FourDVarNet1D(\n    state_dim=N, n_time=T, latent_dim=8, hidden_dim=16, n_solver_steps=10,\n    key=jax.random.PRNGKey(1),\n)\n\nmodel, train_losses, _ = vardax.examples.fit_demo(\n    model,\n    [batch_train],\n    n_epochs=10,\n    lr=1e-3,\n    verbose=False,\n)\nprint(f\"4DVarNet final train loss: {train_losses[-1]:.4f}\")\n\nout_4dvarnet = model(batch_test)\nmse_4dvarnet = float(jnp.mean((out_4dvarnet - batch_test.target) ** 2))\nprint(f\"4DVarNet test MSE: {mse_4dvarnet:.4f}\")","key":"noTsmzktiC"},{"type":"outputs","id":"U1g9taiXcAl-IIFipZxZn","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"4DVarNet final train loss: 0.3292\n"},"children":[],"key":"KJMHAdw9bD"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"4DVarNet test MSE: 0.4065\n"},"children":[],"key":"xhUowI38e9"}],"key":"onEzRtic1K"}],"identifier":"8b9e82ad","html_id":"8b9e82ad","key":"T5pYd1AclB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Comparison: convergence and reconstruction quality","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NtGhEBXwM1"}],"identifier":"id-4-comparison-convergence-and-reconstruction-quality","label":"4. Comparison: convergence and reconstruction quality","html_id":"id-4-comparison-convergence-and-reconstruction-quality","implicit":true,"key":"xQyxRS5Cyx"}],"identifier":"62232f61","html_id":"62232f61","key":"fhXkvjCOc5"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:31:58.066153Z","iopub.status.busy":"2026-11-10T15:31:58.065978Z","iopub.status.idle":"2026-11-10T15:31:58.439939Z","shell.execute_reply":"2026-11-10T15:31:58.439203Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Convergence of classical 4DVar\naxes[0].semilogy(classical_losses, color=\"steelblue\")\naxes[0].set_xlabel(\"Gradient-descent step\")\naxes[0].set_ylabel(\"Variational cost U(x)\")\naxes[0].set_title(\"Classical 4DVar convergence\")\n\n# 4DVarNet learning curve\naxes[1].semilogy(train_losses, color=\"tomato\")\naxes[1].set_xlabel(\"Epoch\")\naxes[1].set_ylabel(\"Train loss\")\naxes[1].set_title(\"4DVarNet learning curve\")\n\n# MSE bar chart\nbars = axes[2].bar(\n    [\"Classical 4DVar\\n(pre-trained prior)\", \"4DVarNet\\n(trained)\"],\n    [mse_classical, mse_4dvarnet],\n    color=[\"steelblue\", \"tomato\"],\n)\naxes[2].set_ylabel(\"Test MSE\")\naxes[2].set_title(\"Reconstruction MSE\")\nfor bar, val in zip(bars, [mse_classical, mse_4dvarnet]):\n    axes[2].text(\n        bar.get_x() + bar.get_width() / 2.0,\n        bar.get_height() + 0.001,\n        f\"{val:.4f}\",\n        ha=\"center\",\n        va=\"bottom\",\n    )\n\nplt.tight_layout()\nplt.show()","key":"wkkVxglGWn"},{"type":"outputs","id":"t_NYcc1-OTe8PVrsfjIYR","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5fd525045272ed26d05cd69da70145b4","path":"/vardax/build/5fd525045272ed26d05cd69da70145b4.png"},"text/plain":{"content":"<Figure size 1500x400 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"rP0YjRK1lG"}],"key":"pdLPa0Z4R9"}],"identifier":"65c7845e","html_id":"65c7845e","key":"NI10a5guDH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Visualise reconstructions side by side","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rg8aoCU0R1"}],"identifier":"id-5-visualise-reconstructions-side-by-side","label":"5. Visualise reconstructions side by side","html_id":"id-5-visualise-reconstructions-side-by-side","implicit":true,"key":"OLTdNf5T85"}],"identifier":"aaa438a2","html_id":"aaa438a2","key":"TeqewZpvAQ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:31:58.441966Z","iopub.status.busy":"2026-11-10T15:31:58.441754Z","iopub.status.idle":"2026-11-10T15:31:58.766814Z","shell.execute_reply":"2026-11-10T15:31:58.765923Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"sample_idx = 0\nfeature_idx = 0\n\nfig, axes = plt.subplots(1, 3, figsize=(14, 3), sharey=True)\nt_axis = range(T)\n\nfor ax, recon, label, color in zip(\n    axes,\n    [\n        x_classical[sample_idx, :, feature_idx],\n        out_4dvarnet[sample_idx, :, feature_idx],\n        batch_test.target[sample_idx, :, feature_idx],\n    ],\n    [\"Classical 4DVar\", \"4DVarNet\", \"Ground truth\"],\n    [\"steelblue\", \"tomato\", \"black\"],\n):\n    ax.plot(t_axis, recon, color=color, linewidth=1.5, label=label)\n    ax.scatter(\n        t_axis,\n        batch_test.input[sample_idx, :, feature_idx],\n        c=\"gray\",\n        s=20,\n        zorder=5,\n        label=\"Obs\",\n    )\n    ax.set_title(label)\n    ax.set_xlabel(\"Time step\")\n\naxes[0].set_ylabel(\"State (X)\")\nplt.suptitle(f\"Reconstruction comparison — sample {sample_idx}, feature X\")\nplt.tight_layout()\nplt.show()","key":"vylnaPuydE"},{"type":"outputs","id":"GmdXjuj6ad48bnNaYEbWi","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4040d71366df2fef6013b590ed7fa42a","path":"/vardax/build/4040d71366df2fef6013b590ed7fa42a.png"},"text/plain":{"content":"<Figure size 1400x300 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"MAzAeWYYZy"}],"key":"nLe8UKnGWt"}],"identifier":"4dc262fc","html_id":"4dc262fc","key":"U7TBXshlOA"}],"key":"LnE3FqHGZH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"07 — Prior Pre-training for Lorenz-63","url":"/notebooks/prior-pretraining-l63","group":"Tutorials"},"next":{"title":"09 — Parameter Estimation on Lorenz-63","url":"/notebooks/param-estimation-l63","group":"Tutorials"}}},"domain":"http://localhost:3000"}