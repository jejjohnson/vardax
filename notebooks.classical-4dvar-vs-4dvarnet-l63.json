tPGC"},{"type":"inlineMath","value":"x","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"qWrhI8nwut"},{"type":"text","value":" using a gradient-descent optimisation loop in JAX.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"hzUxc6j0AG"}],"key":"GioSZrKXC6"}],"key":"Fc3uINRNlA"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"4DVarNet (learned)","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"wTMCzwZr3Y"}],"key":"lIEKvjtlzc"},{"type":"text","value":" — ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"kXjG6wiusE"},{"type":"inlineCode","value":"FourDVarNet1D","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Q1v0CwO9dc"},{"type":"text","value":" trained end-to-end.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"gxQeaSR24B"}],"key":"gAnIhA0nMS"}],"key":"FcE0nDUKGu"}],"key":"MjSYHcPpgJ"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"We compare reconstruction MSE and convergence behaviour.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"r9bWO2rXSo"}],"key":"mENEEBpKMz"}],"identifier":"51f732c1","html_id":"51f732c1","key":"HUMAGff4x5"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:46.923300Z","iopub.status.busy":"2026-10-30T18:19:46.923099Z","iopub.status.idle":"2026-10-30T18:19:49.362247Z","shell.execute_reply":"2026-10-30T18:19:49.361398Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import jax\nimport jax.numpy as jnp\nimport matplotlib.pyplot as plt\n\nimport vardax\nfrom vardax import (\n    Batch1D,\n    BilinAEPrior1D,\n    FourDVarNet1D,\n    variational_cost,\n    variational_cost_grad,\n    decomposed_loss,\n)\nfrom vardax._src.utils.dynamical_systems import simulate_lorenz63\nfrom vardax._src.utils.patches import trajectory_to_xr_dataset, extract_patches\nfrom vardax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import xr_to_batch1d\nfrom vardax._src.utils.standardize import compute_scaler_params, apply_standardization","key":"JBvpz9p7pe"},{"type":"outputs","id":"GpC24MYv9-gJwUU11APH6","children":[],"key":"r5eLtdqfwS"}],"identifier":"8a465b50","html_id":"8a465b50","key":"IYD8XxoGym"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Prepare L63 data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Gv6RIWzOMA"}],"identifier":"id-1-prepare-l63-data","label":"1. Prepare L63 data","html_id":"id-1-prepare-l63-data","implicit":true,"key":"UthOXbDNku"}],"identifier":"f3c22ca6","html_id":"f3c22ca6","key":"DmR7UTbqtS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:49.364316Z","iopub.status.busy":"2026-10-30T18:19:49.363982Z","iopub.status.idle":"2026-10-30T18:19:50.670332Z","shell.execute_reply":"2026-10-30T18:19:50.669424Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\ntime_coords, states = simulate_lorenz63(\n    key, sigma=10.0, rho=28.0, beta=8.0 / 3.0, dt=0.01, n_steps=5000, n_burn_in=1000\n)\nds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\n# Split the trajectory in time *before* cutting windows, so no window\n# straddles the boundary: windows drawn at random from one trajectory and\n# split afterwards would leak test timesteps into the training set.\nn_time = ds.sizes[\"time\"]\nds_train = extract_patches(ds.isel(time=slice(0, int(0.8 * n_time))), n_patches=160, n_timesteps=20, seed=42)\nds_test = extract_patches(ds.isel(time=slice(int(0.8 * n_time), None)), n_patches=40, n_timesteps=20, seed=43)\nds_train = regular_mask(ds_train, variable=\"state\", obs_interval=2)\nds_test = regular_mask(ds_test, variable=\"state\", obs_interval=2)\nds_train = add_gaussian_noise(ds_train, variable=\"state\", sigma=0.5, seed=0, name=\"obs\")\nds_test = add_gaussian_noise(ds_test, variable=\"state\", sigma=0.5, seed=1, name=\"obs\")\nmean, std = compute_scaler_params(ds_train, variable=\"state\", mask_variable=\"mask\")\nds_train = apply_standardization(ds_train, variables=[\"state\", \"obs\"], mean=mean, std=std)\nds_test = apply_standardization(ds_test, variables=[\"state\", \"obs\"], mean=mean, std=std)\n\nbatch_train = xr_to_batch1d(ds_train, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nbatch_test = xr_to_batch1d(ds_test, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nB, T, N = batch_test.input.shape\nprint(f\"Test batch shape: {batch_test.input.shape}\")","key":"qjGljhTIfo"},{"type":"outputs","id":"FsmxFXVkFkPhqPlycIqtq","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Test batch shape: (40, 20, 3)\n"},"children":[],"key":"bLxBl35gsi"}],"key":"il0DiUsNtj"}],"identifier":"28e5221e","html_id":"28e5221e","key":"xaTYLqRdw6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Classical 4DVar — gradient descent on ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Be4TNh8Xnd"},{"type":"inlineMath","value":"x","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"PSNLKjnV4N"}],"identifier":"id-2-classical-4dvar-gradient-descent-on-x","label":"2. Classical 4DVar — gradient descent on x","html_id":"id-2-classical-4dvar-gradient-descent-on-x","implicit":true,"key":"gmlooGYUhS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"We use a fixed prior — a bilinear autoencoder pre-trained on clean training\nwindows, as in notebook ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eOe3veDfHB"},{"type":"link","url":"/notebooks/prior-pretraining-l63","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"07","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ftQQRG924G"}],"urlSource":"07_prior_pretraining_L63.ipynb","dataUrl":"/notebooks.prior-pretraining-l63.json","internal":true,"protocol":"file","key":"tE8aEiYGd4"},{"type":"text","value":" — and minimise\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aitNztL3GZ"},{"type":"inlineMath","value":"U(x)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>U</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">U(x)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10903em;\">U</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span></span></span></span>","key":"pBpHa1P6d5"},{"type":"text","value":" with respect to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DVwQcXZyqc"},{"type":"inlineMath","value":"x","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"HwThMqJqCI"},{"type":"text","value":" directly, running a manual gradient-descent loop\nso we can track the convergence trajectory.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GQPaoJxpos"}],"key":"Im6MWFa7hi"}],"identifier":"cf9ec5c6","html_id":"cf9ec5c6","key":"Gf4YlnpJQv"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:50.671921Z","iopub.status.busy":"2026-10-30T18:19:50.671743Z","iopub.status.idle":"2026-10-30T18:19:52.561590Z","shell.execute_reply":"2026-10-30T18:19:52.560759Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import equinox as eqx\nimport optax\n\nprior = BilinAEPrior1D(state_dim=N, latent_dim=8, n_time=T, key=jax.random.PRNGKey(5))\npre_opt = optax.adam(1e-2)\npre_state = pre_opt.init(eqx.filter(prior, eqx.is_array))\n\n\n@eqx.filter_jit\ndef pretrain_step(prior, opt_state, x):\n    loss, grads = eqx.filter_value_and_grad(lambda p: jnp.mean((x - p(x)) ** 2))(prior)\n    updates, opt_state = pre_opt.update(grads, opt_state, prior)\n    return eqx.apply_updates(prior, updates), opt_state, loss\n\n\nfor _ in range(300):\n    prior, pre_state, pre_loss = pretrain_step(prior, pre_state, batch_train.target)\nprint(f\"prior reconstruction MSE after pre-training: {float(pre_loss):.4f}\")\n\n\n# Initialise x from masked observations\nx_classical = batch_test.input * batch_test.mask\n\nclassical_losses = []\n# `variational_cost` is a *mean* over all B*T*N elements, so its gradient per\n# element is tiny. Scaling the step by the element count gives a per-element\n# step size `eta` (gradient descent on the equivalent sum cost), which lets\n# the baseline actually converge within the step budget.\neta_classical = 0.2\nn_classical_steps = 50\nn_elem = x_classical.size\n\ngrad_fn = jax.jit(jax.value_and_grad(variational_cost))\n\nfor step in range(n_classical_steps):\n    loss_val, grad = grad_fn(\n        x_classical, batch_test, prior, alpha_obs=0.5, alpha_prior=0.5\n    )\n    x_classical = x_classical - eta_classical * n_elem * grad\n    classical_losses.append(float(loss_val))\n\nmse_classical = float(jnp.mean((x_classical - batch_test.target) ** 2))\nprint(f\"Classical 4DVar MSE after {n_classical_steps} steps: {mse_classical:.4f}\")\n\n# Decomposed loss at convergence\ndl = decomposed_loss(x_classical, batch_test, prior)\nprint(\n    f\"  obs={float(dl['obs']):.4f}, prior={float(dl['prior']):.4f}, total={float(dl['total']):.4f}\"\n)","key":"CQIsHT4DvS"},{"type":"outputs","id":"fAYz_LcU8WTJkzbApJxAf","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"prior reconstruction MSE after pre-training: 0.0058\n"},"children":[],"key":"ocqX4gJ0zV"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Classical 4DVar MSE after 50 steps: 0.0068\n"},"children":[],"key":"pNqca1ocQm"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  obs=0.0008, prior=0.0010, total=0.0017\n"},"children":[],"key":"wG7RST9iOZ"}],"key":"ookxJ2UbYP"}],"identifier":"186860e3","html_id":"186860e3","key":"ecAI2PWBFy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. 4DVarNet — trained end-to-end","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dyWDNqHIKZ"}],"identifier":"id-3-4dvarnet-trained-end-to-end","label":"3. 4DVarNet — trained end-to-end","html_id":"id-3-4dvarnet-trained-end-to-end","implicit":true,"key":"VjI5LI6Y37"}],"identifier":"6be0f881","html_id":"6be0f881","key":"XDRH6lceSB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:52.563164Z","iopub.status.busy":"2026-10-30T18:19:52.562978Z","iopub.status.idle":"2026-10-30T18:19:58.892276Z","shell.execute_reply":"2026-10-30T18:19:58.891479Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = FourDVarNet1D(\n    state_dim=N, n_time=T, latent_dim=8, hidden_dim=16, n_solver_steps=10,\n    key=jax.random.PRNGKey(1),\n)\n\nmodel, train_losses, _ = vardax.examples.fit_demo(\n    model,\n    [batch_train],\n    n_epochs=10,\n    lr=1e-3,\n    verbose=False,\n)\nprint(f\"4DVarNet final train loss: {train_losses[-1]:.4f}\")\n\nout_4dvarnet = model(batch_test)\nmse_4dvarnet = float(jnp.mean((out_4dvarnet - batch_test.target) ** 2))\nprint(f\"4DVarNet test MSE: {mse_4dvarnet:.4f}\")","key":"NSij7UH8rF"},{"type":"outputs","id":"ZmngfmbLZmsPnegWycU2l","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"4DVarNet final train loss: 0.3292\n"},"children":[],"key":"aVwv1wg3ZA"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"4DVarNet test MSE: 0.4065\n"},"children":[],"key":"KRLlnHgIEQ"}],"key":"OdwrafXbjK"}],"identifier":"3f739de0","html_id":"3f739de0","key":"XDL7sJjKBQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Comparison: convergence and reconstruction quality","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iXh9bLmHdP"}],"identifier":"id-4-comparison-convergence-and-reconstruction-quality","label":"4. Comparison: convergence and reconstruction quality","html_id":"id-4-comparison-convergence-and-reconstruction-quality","implicit":true,"key":"NXlyd9TLAi"}],"identifier":"216e179a","html_id":"216e179a","key":"YZDDkFQ4Pj"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:58.894072Z","iopub.status.busy":"2026-10-30T18:19:58.893897Z","iopub.status.idle":"2026-10-30T18:19:59.282725Z","shell.execute_reply":"2026-10-30T18:19:59.281785Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Convergence of classical 4DVar\naxes[0].semilogy(classical_losses, color=\"steelblue\")\naxes[0].set_xlabel(\"Gradient-descent step\")\naxes[0].set_ylabel(\"Variational cost U(x)\")\naxes[0].set_title(\"Classical 4DVar convergence\")\n\n# 4DVarNet learning curve\naxes[1].semilogy(train_losses, color=\"tomato\")\naxes[1].set_xlabel(\"Epoch\")\naxes[1].set_ylabel(\"Train loss\")\naxes[1].set_title(\"4DVarNet learning curve\")\n\n# MSE bar chart\nbars = axes[2].bar(\n    [\"Classical 4DVar\\n(pre-trained prior)\", \"4DVarNet\\n(trained)\"],\n    [mse_classical, mse_4dvarnet],\n    color=[\"steelblue\", \"tomato\"],\n)\naxes[2].set_ylabel(\"Test MSE\")\naxes[2].set_title(\"Reconstruction MSE\")\nfor bar, val in zip(bars, [mse_classical, mse_4dvarnet]):\n    axes[2].text(\n        bar.get_x() + bar.get_width() / 2.0,\n        bar.get_height() + 0.001,\n        f\"{val:.4f}\",\n        ha=\"center\",\n        va=\"bottom\",\n    )\n\nplt.tight_layout()\nplt.show()","key":"DpAgIHvm74"},{"type":"outputs","id":"JNDPz3jW-nn3GsL-a_43M","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"a720cf63bcbddc1f4b85eb7b6ac91754","path":"/vardax/build/a720cf63bcbddc1f4b85eb7b6ac91754.png"},"text/plain":{"content":"<Figure size 1500x400 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"mNKS1HTXv5"}],"key":"Z8Do9nhcCo"}],"identifier":"adccc009","html_id":"adccc009","key":"bVVOMpjLRF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Visualise reconstructions side by side","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tGGAZ6cQln"}],"identifier":"id-5-visualise-reconstructions-side-by-side","label":"5. Visualise reconstructions side by side","html_id":"id-5-visualise-reconstructions-side-by-side","implicit":true,"key":"yLwxvZ0uHb"}],"identifier":"682e346c","html_id":"682e346c","key":"FiXftFLGyt"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:59.284294Z","iopub.status.busy":"2026-10-30T18:19:59.284114Z","iopub.status.idle":"2026-10-30T18:19:59.617145Z","shell.execute_reply":"2026-10-30T18:19:59.616339Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"sample_idx = 0\nfeature_idx = 0\n\nfig, axes = plt.subplots(1, 3, figsize=(14, 3), sharey=True)\nt_axis = range(T)\n\nfor ax, recon, label, color in zip(\n    axes,\n    [\n        x_classical[sample_idx, :, feature_idx],\n        out_4dvarnet[sample_idx, :, feature_idx],\n        batch_test.target[sample_idx, :, feature_idx],\n    ],\n    [\"Classical 4DVar\", \"4DVarNet\", \"Ground truth\"],\n    [\"steelblue\", \"tomato\", \"black\"],\n):\n    ax.plot(t_axis, recon, color=color, linewidth=1.5, label=label)\n    ax.scatter(\n        t_axis,\n        batch_test.input[sample_idx, :, feature_idx],\n        c=\"gray\",\n        s=20,\n        zorder=5,\n        label=\"Obs\",\n    )\n    ax.set_title(label)\n    ax.set_xlabel(\"Time step\")\n\naxes[0].set_ylabel(\"State (X)\")\nplt.suptitle(f\"Reconstruction comparison — sample {sample_idx}, feature X\")\nplt.tight_layout()\nplt.show()","key":"zeNSH155vM"},{"type":"outputs","id":"_H3ZFE7vz8o8U4afGP_nw","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"084fa9c6e89565fd80cfe3f7fee99839","path":"/vardax/build/084fa9c6e89565fd80cfe3f7fee99839.png"},"text/plain":{"content":"<Figure size 1400x300 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"hCL6mpgUwS"}],"key":"GBaNTWL8LJ"}],"identifier":"3dab2372","html_id":"3dab2372","key":"Hszv3YgMQS"}],"key":"p86KZMtxXW"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"07 — Prior Pre-training for Lorenz-63","url":"/notebooks/prior-pretraining-l63","group":"Tutorials"},"next":{"title":"09 — Parameter Estimation on Lorenz-63","url":"/notebooks/param-estimation-l63","group":"Tutorials"}}},"domain":"http://localhost:3000"}