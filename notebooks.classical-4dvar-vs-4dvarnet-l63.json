e":"We compare reconstruction MSE and convergence behaviour.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"wzXqCnn0Uj"}],"key":"gi6nZszIdP"}],"identifier":"a371242e","html_id":"a371242e","key":"oh7TMR6boR"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:42.705047Z","iopub.status.busy":"2026-11-27T16:07:42.704893Z","iopub.status.idle":"2026-11-27T16:07:44.963822Z","shell.execute_reply":"2026-11-27T16:07:44.963000Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import jax\nimport jax.numpy as jnp\nimport matplotlib.pyplot as plt\n\nimport vardax\nfrom vardax import (\n    Batch1D,\n    BilinAEPrior1D,\n    FourDVarNet1D,\n    variational_cost,\n    variational_cost_grad,\n    decomposed_loss,\n)\nfrom vardax._src.utils.dynamical_systems import simulate_lorenz63\nfrom vardax._src.utils.patches import trajectory_to_xr_dataset, extract_patches\nfrom vardax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import xr_to_batch1d\nfrom vardax._src.utils.standardize import compute_scaler_params, apply_standardization","key":"rwjpvqZdTP"},{"type":"outputs","id":"Ub26MPiPTjEfq16JClAds","children":[],"key":"TzZE2dSMbl"}],"identifier":"1c3587bd","html_id":"1c3587bd","key":"IHAOZG4wqM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Prepare L63 data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lxs57RNsj2"}],"identifier":"id-1-prepare-l63-data","label":"1. Prepare L63 data","html_id":"id-1-prepare-l63-data","implicit":true,"key":"lqiXswUEkF"}],"identifier":"69239e10","html_id":"69239e10","key":"adCOV9ojGp"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:44.965561Z","iopub.status.busy":"2026-11-27T16:07:44.965269Z","iopub.status.idle":"2026-11-27T16:07:46.280324Z","shell.execute_reply":"2026-11-27T16:07:46.279401Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\ntime_coords, states = simulate_lorenz63(\n    key, sigma=10.0, rho=28.0, beta=8.0 / 3.0, dt=0.01, n_steps=5000, n_burn_in=1000\n)\nds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\n# Split the trajectory in time *before* cutting windows, so no window\n# straddles the boundary: windows drawn at random from one trajectory and\n# split afterwards would leak test timesteps into the training set.\nn_time = ds.sizes[\"time\"]\nds_train = extract_patches(ds.isel(time=slice(0, int(0.8 * n_time))), n_patches=160, n_timesteps=20, seed=42)\nds_test = extract_patches(ds.isel(time=slice(int(0.8 * n_time), None)), n_patches=40, n_timesteps=20, seed=43)\nds_train = regular_mask(ds_train, variable=\"state\", obs_interval=2)\nds_test = regular_mask(ds_test, variable=\"state\", obs_interval=2)\nds_train = add_gaussian_noise(ds_train, variable=\"state\", sigma=0.5, seed=0, name=\"obs\")\nds_test = add_gaussian_noise(ds_test, variable=\"state\", sigma=0.5, seed=1, name=\"obs\")\nmean, std = compute_scaler_params(ds_train, variable=\"state\", mask_variable=\"mask\")\nds_train = apply_standardization(ds_train, variables=[\"state\", \"obs\"], mean=mean, std=std)\nds_test = apply_standardization(ds_test, variables=[\"state\", \"obs\"], mean=mean, std=std)\n\nbatch_train = xr_to_batch1d(ds_train, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nbatch_test = xr_to_batch1d(ds_test, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nB, T, N = batch_test.input.shape\nprint(f\"Test batch shape: {batch_test.input.shape}\")","key":"eOvLI1zraR"},{"type":"outputs","id":"TN-WfbagHpKlf0UAFDidF","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Test batch shape: (40, 20, 3)\n"},"children":[],"key":"PTR9dcZ96w"}],"key":"LQu1DyPnYE"}],"identifier":"983e312d","html_id":"983e312d","key":"SoU61rjcsE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Classical 4DVar — gradient descent on ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kFUS93SZpo"},{"type":"inlineMath","value":"x","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"eygTp3qztv"}],"identifier":"id-2-classical-4dvar-gradient-descent-on-x","label":"2. Classical 4DVar — gradient descent on x","html_id":"id-2-classical-4dvar-gradient-descent-on-x","implicit":true,"key":"ocxnwWjuRw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"We use a fixed prior — a bilinear autoencoder pre-trained on clean training\nwindows, as in notebook ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"unazb1BkBf"},{"type":"link","url":"/notebooks/prior-pretraining-l63","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"07","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PQJm0A8gPH"}],"urlSource":"07_prior_pretraining_L63.ipynb","dataUrl":"/notebooks.prior-pretraining-l63.json","internal":true,"protocol":"file","key":"KnF5kjYHIl"},{"type":"text","value":" — and minimise\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oWOiEMLnej"},{"type":"inlineMath","value":"U(x)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>U</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">U(x)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10903em;\">U</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span></span></span></span>","key":"u8Jk6IVVAn"},{"type":"text","value":" with respect to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KpPy3MxgmF"},{"type":"inlineMath","value":"x","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"JhCOtdXDON"},{"type":"text","value":" directly, running a manual gradient-descent loop\nso we can track the convergence trajectory.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Nxc1PT4ynd"}],"key":"b5RbIzEzeD"}],"identifier":"125d1a59","html_id":"125d1a59","key":"w6vESplbyw"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:46.281798Z","iopub.status.busy":"2026-11-27T16:07:46.281640Z","iopub.status.idle":"2026-11-27T16:07:48.661920Z","shell.execute_reply":"2026-11-27T16:07:48.661117Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import equinox as eqx\nimport optax\n\nprior = BilinAEPrior1D(state_dim=N, latent_dim=8, n_time=T, key=jax.random.PRNGKey(5))\npre_opt = optax.adam(1e-2)\npre_state = pre_opt.init(eqx.filter(prior, eqx.is_array))\n\n\n@eqx.filter_jit\ndef pretrain_step(prior, opt_state, x):\n    loss, grads = eqx.filter_value_and_grad(lambda p: jnp.mean((x - p(x)) ** 2))(prior)\n    updates, opt_state = pre_opt.update(grads, opt_state, prior)\n    return eqx.apply_updates(prior, updates), opt_state, loss\n\n\nfor _ in range(300):\n    prior, pre_state, pre_loss = pretrain_step(prior, pre_state, batch_train.target)\nprint(f\"prior reconstruction MSE after pre-training: {float(pre_loss):.4f}\")\n\n\n# Initialise x from masked observations\nx_classical = batch_test.input * batch_test.mask\n\nclassical_losses = []\n# `variational_cost` is a *mean* over all B*T*N elements, so its gradient per\n# element is tiny. Scaling the step by the element count gives a per-element\n# step size `eta` (gradient descent on the equivalent sum cost), which lets\n# the baseline actually converge within the step budget.\neta_classical = 0.2\nn_classical_steps = 50\nn_elem = x_classical.size\n\ngrad_fn = jax.jit(jax.value_and_grad(variational_cost))\n\nfor step in range(n_classical_steps):\n    loss_val, grad = grad_fn(\n        x_classical, batch_test, prior, alpha_obs=0.5, alpha_prior=0.5\n    )\n    x_classical = x_classical - eta_classical * n_elem * grad\n    classical_losses.append(float(loss_val))\n\nmse_classical = float(jnp.mean((x_classical - batch_test.target) ** 2))\nprint(f\"Classical 4DVar MSE after {n_classical_steps} steps: {mse_classical:.4f}\")\n\n# Decomposed loss at convergence\ndl = decomposed_loss(x_classical, batch_test, prior)\nprint(\n    f\"  obs={float(dl['obs']):.4f}, prior={float(dl['prior']):.4f}, total={float(dl['total']):.4f}\"\n)","key":"qNB9Vyp1MD"},{"type":"outputs","id":"iY3FADxO0MCfmbdf3dY9x","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"prior reconstruction MSE after pre-training: 0.0056\n"},"children":[],"key":"yBywYoFbGr"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Classical 4DVar MSE after 50 steps: 0.0067\n  obs=0.0007, prior=0.0009, total=0.0016\n"},"children":[],"key":"H5GwQ99ymn"}],"key":"NW6tACJXSZ"}],"identifier":"31e7077b","html_id":"31e7077b","key":"SuG773VkTD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. 4DVarNet — trained end-to-end","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V0UH1ZVod6"}],"identifier":"id-3-4dvarnet-trained-end-to-end","label":"3. 4DVarNet — trained end-to-end","html_id":"id-3-4dvarnet-trained-end-to-end","implicit":true,"key":"xPGksYu8Kp"}],"identifier":"c40d2fbf","html_id":"c40d2fbf","key":"NKTUrljPEh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:48.663566Z","iopub.status.busy":"2026-11-27T16:07:48.663361Z","iopub.status.idle":"2026-11-27T16:07:55.875107Z","shell.execute_reply":"2026-11-27T16:07:55.874327Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = FourDVarNet1D(\n    state_dim=N, n_time=T, latent_dim=8, hidden_dim=16, n_solver_steps=10,\n    key=jax.random.PRNGKey(1),\n)\n\nmodel, train_losses, _ = vardax.examples.fit_demo(\n    model,\n    [batch_train],\n    n_epochs=10,\n    lr=1e-3,\n    verbose=False,\n)\nprint(f\"4DVarNet final train loss: {train_losses[-1]:.4f}\")\n\nout_4dvarnet = model(batch_test)\nmse_4dvarnet = float(jnp.mean((out_4dvarnet - batch_test.target) ** 2))\nprint(f\"4DVarNet test MSE: {mse_4dvarnet:.4f}\")","key":"RG4bkzFvSs"},{"type":"outputs","id":"J5JaXBQRJxTmMYB9YJn5J","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"4DVarNet final train loss: 0.3292\n"},"children":[],"key":"c2IdRnQOGb"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"4DVarNet test MSE: 0.4065\n"},"children":[],"key":"bwGv2hMqBP"}],"key":"XvSuFPURNx"}],"identifier":"c74cd50d","html_id":"c74cd50d","key":"KkR0uXJaej"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Comparison: convergence and reconstruction quality","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DXV5HAeX5W"}],"identifier":"id-4-comparison-convergence-and-reconstruction-quality","label":"4. Comparison: convergence and reconstruction quality","html_id":"id-4-comparison-convergence-and-reconstruction-quality","implicit":true,"key":"GYSliPq2m3"}],"identifier":"031e3ddb","html_id":"031e3ddb","key":"ZW4YqyPaH3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:55.876638Z","iopub.status.busy":"2026-11-27T16:07:55.876446Z","iopub.status.idle":"2026-11-27T16:07:56.265861Z","shell.execute_reply":"2026-11-27T16:07:56.265019Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Convergence of classical 4DVar\naxes[0].semilogy(classical_losses, color=\"steelblue\")\naxes[0].set_xlabel(\"Gradient-descent step\")\naxes[0].set_ylabel(\"Variational cost U(x)\")\naxes[0].set_title(\"Classical 4DVar convergence\")\n\n# 4DVarNet learning curve\naxes[1].semilogy(train_losses, color=\"tomato\")\naxes[1].set_xlabel(\"Epoch\")\naxes[1].set_ylabel(\"Train loss\")\naxes[1].set_title(\"4DVarNet learning curve\")\n\n# MSE bar chart\nbars = axes[2].bar(\n    [\"Classical 4DVar\\n(pre-trained prior)\", \"4DVarNet\\n(trained)\"],\n    [mse_classical, mse_4dvarnet],\n    color=[\"steelblue\", \"tomato\"],\n)\naxes[2].set_ylabel(\"Test MSE\")\naxes[2].set_title(\"Reconstruction MSE\")\nfor bar, val in zip(bars, [mse_classical, mse_4dvarnet]):\n    axes[2].text(\n        bar.get_x() + bar.get_width() / 2.0,\n        bar.get_height() + 0.001,\n        f\"{val:.4f}\",\n        ha=\"center\",\n        va=\"bottom\",\n    )\n\nplt.tight_layout()\nplt.show()","key":"tlydIo0azg"},{"type":"outputs","id":"K5uiHV6VVfsPWF-1EjUCe","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"461ce1f53b9a769ce2ab68952e1cb62a","path":"/vardax/_public/461ce1f53b9a769ce2ab68952e1cb62a.png"},"text/plain":{"content":"<Figure size 1500x400 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"Mf841c1xgC"}],"key":"ehRY3D8AZZ"}],"identifier":"26aa1177","html_id":"26aa1177","key":"YHOmwEEtoc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Visualise reconstructions side by side","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"grP1slPn0n"}],"identifier":"id-5-visualise-reconstructions-side-by-side","label":"5. Visualise reconstructions side by side","html_id":"id-5-visualise-reconstructions-side-by-side","implicit":true,"key":"qdKs7ijF3V"}],"identifier":"fa49608a","html_id":"fa49608a","key":"YPxhiX1owD"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:56.267313Z","iopub.status.busy":"2026-11-27T16:07:56.267152Z","iopub.status.idle":"2026-11-27T16:07:56.579415Z","shell.execute_reply":"2026-11-27T16:07:56.578490Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"sample_idx = 0\nfeature_idx = 0\n\nfig, axes = plt.subplots(1, 3, figsize=(14, 3), sharey=True)\nt_axis = range(T)\n\nfor ax, recon, label, color in zip(\n    axes,\n    [\n        x_classical[sample_idx, :, feature_idx],\n        out_4dvarnet[sample_idx, :, feature_idx],\n        batch_test.target[sample_idx, :, feature_idx],\n    ],\n    [\"Classical 4DVar\", \"4DVarNet\", \"Ground truth\"],\n    [\"steelblue\", \"tomato\", \"black\"],\n):\n    ax.plot(t_axis, recon, color=color, linewidth=1.5, label=label)\n    ax.scatter(\n        t_axis,\n        batch_test.input[sample_idx, :, feature_idx],\n        c=\"gray\",\n        s=20,\n        zorder=5,\n        label=\"Obs\",\n    )\n    ax.set_title(label)\n    ax.set_xlabel(\"Time step\")\n\naxes[0].set_ylabel(\"State (X)\")\nplt.suptitle(f\"Reconstruction comparison — sample {sample_idx}, feature X\")\nplt.tight_layout()\nplt.show()","key":"ishbzjHK5D"},{"type":"outputs","id":"VrZldIX0fb0zyfopR0_iF","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"995c7f9a49798d1e1ba9ebae0ff7d86c","path":"/vardax/_public/995c7f9a49798d1e1ba9ebae0ff7d86c.png"},"text/plain":{"content":"<Figure size 1400x300 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"KxaMhxf4oW"}],"key":"b8k8TnSA07"}],"identifier":"ffc019b1","html_id":"ffc019b1","key":"XyuSu648xu"}],"key":"fxFBb5lUU6"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"07 — Prior Pre-training for Lorenz-63","url":"/notebooks/prior-pretraining-l63","group":"Tutorials"},"next":{"title":"09 — Parameter Estimation on Lorenz-63","url":"/notebooks/param-estimation-l63","group":"Tutorials"}}},"domain":"http://pre.render"}