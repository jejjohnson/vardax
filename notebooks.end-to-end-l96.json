nz96,\n    plot_l96_grid,\n    plot_l96_trajectories,\n    plot_reconstruction_comparison,\n)\nfrom vardax._src.utils.patches import trajectory_to_xr_dataset, extract_patches\nfrom vardax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import xr_to_batch1d\nfrom vardax._src.utils.standardize import (\n    compute_scaler_params,\n    apply_standardization,\n    inverse_standardization,\n)","key":"tDSOkPRSGO"},{"type":"outputs","id":"n0vDgUNhZPd8EAR9pE7z5","children":[],"key":"bpEScsMJEK"}],"identifier":"768f61a1","html_id":"768f61a1","key":"S11bYR1oga"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Simulate Lorenz-96","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YIHUQbJqdb"}],"identifier":"id-1-simulate-lorenz-96","label":"1. Simulate Lorenz-96","html_id":"id-1-simulate-lorenz-96","implicit":true,"key":"HWXPrj8axw"}],"identifier":"e60cb0f3","html_id":"e60cb0f3","key":"Uno9ZSgr89"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:39:31.244669Z","iopub.status.busy":"2026-11-06T14:39:31.244426Z","iopub.status.idle":"2026-11-06T14:39:32.363633Z","shell.execute_reply":"2026-11-06T14:39:32.362932Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\nN = 40\ntime_coords, states = simulate_lorenz96(\n    key,\n    n_sites=N,\n    forcing=8.0,\n    dt=0.01,\n    n_steps=5000,\n    n_burn_in=1000,\n)\nprint(f\"states shape: {states.shape}, time range: [{time_coords[0]:.2f}, {time_coords[-1]:.2f}]\")","key":"ymq6kkFr7T"},{"type":"outputs","id":"RdNMCWJB2RWzp6hRv_u4Y","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"states shape: (5001, 40), time range: [0.00, 50.00]\n"},"children":[]