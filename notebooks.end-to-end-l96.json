ax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import xr_to_batch1d\nfrom vardax._src.utils.standardize import (\n    compute_scaler_params,\n    apply_standardization,\n    inverse_standardization,\n)","key":"y5RdJj3TLg"},{"type":"outputs","id":"dYp_9vqkB7PPXh1rxfbKN","children":[],"key":"CabPDXwgwF"}],"identifier":"aede750a","html_id":"aede750a","key":"V4sTtL3DLo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Simulate Lorenz-96","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AkYCzZFPQU"}],"identifier":"id-1-simulate-lorenz-96","label":"1. Simulate Lorenz-96","html_id":"id-1-simulate-lorenz-96","implicit":true,"key":"NpKNzRhNAO"}],"identifier":"9ae9e5c6","html_id":"9ae9e5c6","key":"UgbYBUK4g2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:17.272717Z","iopub.status.busy":"2026-10-30T18:19:17.272367Z","iopub.status.idle":"2026-10-30T18:19:18.684728Z","shell.execute_reply":"2026-10-30T18:19:18.683922Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\nN = 40\ntime_coords, states = simulate_lorenz96(\n    key,\n    n_sites=N,\n    forcing=8.0,\n    dt=0.01,\n    n_steps=5000,\n    n_burn_in=1000,\n)\nprint(f\"states shape: {states.shape}, time range: [{time_coords[0]:.2f}, {time_coords[-1]:.2f}]\")","key":"xSy8Szptvi"},{"type":"outputs","id":"lrzA60c5oPpIAeVpqZyJB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"states shape: (5001, 40), time range: [0.00, 50.00]\n"},"children":[],"key":"DUt0dKavfE"}],"key":"FjRO6fFfNu"}],"identifier":"b89b2450","html_id":"b89b2450","key":"SuJwHGJyRe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","dept