n    rho=28.0,\n    beta=8.0 / 3.0,\n    dt=0.01,\n    n_steps=5000,\n    n_burn_in=1000,\n)\nprint(f\"states shape: {states.shape}, time range: [{time_coords[0]:.2f}, {time_coords[-1]:.2f}]\")","key":"KvqNiaZopB"},{"type":"outputs","id":"2-j0toN4eT-mGL0o4x6o_","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"states shape: (5001, 3), time range: [0.00, 50.00]\n"},"children":[],"key":"svKYOXZJZQ"}],"key":"seVNvcqj4G"}],"identifier":"2c88ab78","html_id":"2c88ab78","key":"ODrdn83zxD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Build xarray Dataset and Extract Patches","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jlymDD8gFK"}],"identifier":"id-2-build-xarray-dataset-and-extract-patches","label":"2. Build xarray Dataset and Extract Patches","html_id":"id-2-build-xarray-dataset-and-extract-patches","implicit":true,"key":"FUkjfDexHy"}],"identifier":"31e4bef0","html_id":"31e4bef0","key":"QWNRD9WgJA"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:39:21.881449Z","iopub.status.busy":"2026-11-06T14:39:21.881314Z","iopub.status.idle":"2026-11-06T14:39:21.887433Z","shell.execute_reply":"2026-11-06T14:39:21.886864Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\nprint(ds)","key":"iel1ni7bGo"},{"type":"outputs","id":"myP_C72cTLZAh20-FFv02","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<xarray.Dataset> Size: 80kB\nDimensions:  (time: 5001, feature: 3)\nCoordinates:\n  * time     (time) float32 20kB 0.0 0.01 0.02 0.03 ... 49.97 49.98 49.99 50.0\n  * feature  (feature) <U1 12B 'X' 'Y' 'Z'\nData variables:\n    state    (time, feature) float32 60kB -4.885 -3