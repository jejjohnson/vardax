.numpy as jnp\nimport matplotlib.pyplot as plt\n\nimport vardax\nfrom vardax import Batch1D, FourDVarNet1D\nfrom vardax._src.utils.dynamical_systems import simulate_lorenz63\nfrom vardax._src.utils.patches import trajectory_to_xr_dataset, extract_patches\nfrom vardax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import xr_to_batch1d\nfrom vardax._src.utils.standardize import (\n    compute_scaler_params,\n    apply_standardization,\n    inverse_standardization,\n)\nfrom vardax._src.utils.viz import (\n    plot_3d_attractor,\n    plot_state_grid,\n    plot_trajectories,\n    plot_reconstruction_comparison,\n)","key":"HlV8RT6T7P"},{"type":"outputs","id":"_BoAfx3QIfBUemO77uNnf","children":[],"key":"ozMXyHImXk"}],"identifier":"c2184928","html_id":"c2184928","key":"X4y2UKZ5EP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Simulate Lorenz-63","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g4xReflsPg"}],"identifier":"id-1-simulate-lorenz-63","label":"1. Simulate Lorenz-63","html_id":"id-1-simulate-lorenz-63","implicit":true,"key":"axQSfZhFj6"}],"identifier":"e9f9030d","html_id":"e9f9030d","key":"ek2STxy8aH"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:04.088226Z","iopub.status.busy":"2026-10-30T18:19:04.087890Z","iopub.status.idle":"2026-10-30T18:19:05.367226Z","shell.execute_reply":"2026-10-30T18:19:05.366344Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\ntime_coords, states = simulate_lorenz63(\n    key,\n    sigma=10.0,\n    rho=28.0,\n    beta=8.0 / 3.0,\n    dt=0.01,\n    n_steps=5000,\n    n_burn_in=1000,\n)\nprint(f\"states shape: {states.shape}, time range: [{time_coords[0]:.2f}, {time_coords[-1]:.2f}]\")","key":"VPbD2zFt3R"},{"type":"outputs","id":"ZYgu5a3yrLENWQKicnx2T","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"states shape: (5001, 3), time range: [0.00, 50.00]\n"},"children":[],"key":"NyHQcsgbfa"}],"key":"SbsKsWyEaQ"}],"identifier":"0837708c","html_id":"0837708c","key":"kzIj9dfyGG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Build xarray Dataset and Extract Patches","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"thoSetn6sL"}],"identifier":"id-2-build-xarray-dataset-and-extract-patches","label":"2. Build xarray Dataset and Extract Patches","html_id":"id-2-build-xarray-dataset-and-extract-patches","implicit":true,"key":"lwYiZeGCfO"}],"identifier":"9c6edd04","html_id":"9c6edd04","key":"bzJve29sDs"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:05.368877Z","iopub.status.busy":"2026-10-30T18:19:05.368683Z","iopub.status.idle":"2026-10-30T18:19:05.376390Z","shell.execute_reply":"2026-10-30T18:19:05.375719Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\nprint(ds)","key":"UG0Sjz08fk"},{"type":"outputs","id":"l-hKj36_G1iwy-lZfFwfn","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<xarray.Dataset> Size: 80kB\nDimensions:  (time: 5001, feature: 3)\nCoordinates:\n  * time     (time) float32 20kB 0.0 0.01 0.02 0.03 ... 49.97 49.98 49.99 50.0\n  * feature  (feature) <U1 12B 'X' 'Y' 'Z'\nData variables:\n    state    (time, feature) float32 60kB -4.885 -3.767 24.61 ... -1.112 17.2\n"},"children":[],"key":"LlLV3r0xwx"}],"key":"CgkbdfTyzV"}],"identifier":"a6131da2","html_id":"a6131da2","key":"pcR5LF1Uxa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Train/Test Split in Time, Then Extract Patches","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GCuU4xCgG5"}],"identifier":"id-3-train-test-split-in-time-then-extract-patches","label":"3. Train/Test Split in Time, Then Extract Patches","html_id":"id-3-train-test-split-in-time-then-extract-patches","implicit":true,"key":"lJXRfT0N8E"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The trajectory is split in time ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZfA16QBXqR"},{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"before","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"f54B7bT4pF"}],"key":"pKb6Za6bQj"},{"type":"text","value":" cutting windows, so no window\nstraddles the boundary. Windows drawn at random from one trajectory and\nsplit afterwards would leak test timesteps into the training set.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X9KuiwRec7"}],"key":"ByIQMWYS4a"}],"identifier":"a08ac914","html_id":"a08ac914","key":"l0gfWcGZOh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:05.378189Z","iopub.status.busy":"2026-10-30T18:19:05.378018Z","iopub.status.idle":"2026-10-30T18:19:05.394216Z","shell.execute_reply":"2026-10-30T18:19:05.393412Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"n_time = ds.sizes[\"time\"]\nds_train = extract_patches(ds.isel(time=slice(0, int(0.8 * n_time))), n_patches=160, n_timesteps=20, seed=42)\nds_test = extract_patches(ds.isel(time=slice(int(0.8 * n_time), None)), n_patches=40, n_timesteps=20, seed=43)\nprint(f\"train patches: {ds_train.sizes['patch']}, test patches: {ds_test.sizes['patch']}\")","key":"I1XAOBkgvk"},{"type":"outputs","id":"dhz8PJ6rZQUnbK5QU0o7B","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"train patches: 160, test patches: 40\n"},"children":[],"key":"sYOspfdjfN"}],"key":"KvQwxZ5edC"}],"identifier":"33074717","html_id":"33074717","key":"yhDBBKZtPS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Add Observation Masks and Gaussian Noise","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pAiPHfD7bI"}],"identifier":"id-4-add-observation-masks-and-gaussian-noise","label":"4. Add Observation Masks and Gaussian Noise","html_id":"id-4-add-observation-masks-and-gaussian-noise","implicit":true,"key":"U5UbYQsltB"}],"identifier":"52b56acb","html_id":"52b56acb","key":"PmJk4hklN1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:19:05.395785Z","iopub.status.busy":"2026-10-30T18:19:05.395600Z","iopub.status.idle":"2026-10-30T18:19:05.405742Z","shell.execute_reply":"2026-10-30T18:19:05.405003Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ds_train = regular_mask(ds_train, variable=\"state\", obs_interval=2)\nds_test = regular_mask(ds_test, variable=\"state\", obs_interval=2)\nds_train = add_gaussian_noise(ds_train, variable=\"state\", sigma=0.5, seed=0, name=\"obs\")\nds_test = add_gaussian_noise(ds_test, variable=\"state\", sigma=0.5, seed=1, name=\"obs\")\nprint(ds_train)","key":"eTkMNgmYDn"},{"type":"outputs","id":"EGXmC00kgUB2gcZjpke1q","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"<xarray.Dataset> Size: 117kB\nDimensions:  (patch: 160, time: 20, feature: 3)\nCoordinates:\n  * patch    (patch) int64 1kB 0 1 2 3 4 5 6 7 ... 153 154 155 156 15