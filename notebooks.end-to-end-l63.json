native)\n\nN = batch_train.input.shape[-1]   # 3 (X, Y, Z)\nT = batch_train.input.shape[1]    # 20\n\nmodel = FourDVarNet1D(\n    state_dim=N,\n    n_time=T,\n    latent_dim=8,\n    hidden_dim=16,\n    n_solver_steps=5,\n    key=jax.random.PRNGKey(1),\n)\n\nmodel, train_losses, _ = vardax.examples.fit_demo(\n    model,\n    [batch_train],\n    n_epochs=5,\n    lr=1e-3,\n    verbose=True,\n)\nprint(\"Final train loss:\", train_losses[-1])","key":"Nydw4DAv32"},{"type":"outputs","id":"quJyNbF44cJeWZhDcaJOl","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"epoch 1/5 — train loss: 0.508443\nepoch 2/5 — train loss: 0.493830\nepoch 3/5 — train loss: 0.479898\nepoch 4/5 — train loss: 0.466532\nepoch 5/5 — train loss: 0.453614\nFinal train loss: 0.4536140561103821\n"},"children":[],"key":"fYc56FfrYc"}],"key":"f9OFbuMQwj"}],"identifier":"abe96acc","html_id":"abe96acc","key":"TLdDj5B98F"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"9. Evaluate and Visualize Reconstruction","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q3W2ZgdEwY"}],"identifier":"id-9-evaluate-and-visualize-reconstruction","label":"9. Evaluate and Visualize Reconstruction","html_id":"id-9-evaluate-and-visualize-reconstruction","implicit":true,"key":"eLoKERtRte"}],"identifier":"f95a393e","html_id":"f95a393e","key":"o6ZYoJYtCE"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:39:25.638458Z","iopub.status.busy":"2026-11-06T14:39:25.638304Z","iopub.status.idle":"2026-11-06T14:39:27.320609Z","shell.execute_reply":"2026-11-06T14:39:27.319964Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"recon = model(batch_test)\n\ntarget_np = jnp.array(batch_test.target)\ninput_np = jnp.array(batch_test.input)\nrecon_np = jnp.array(recon)\n\