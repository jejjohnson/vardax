],"identifier":"5526262d","html_id":"5526262d","key":"aCgnhyQ3PM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CErF1yjMKq"}],"identifier":"create-model","label":"Create model","html_id":"create-model","implicit":true,"key":"Ds8A6koXHd"}],"identifier":"bf4ec809","html_id":"bf4ec809","key":"nq4XaFVELr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:58.344803Z","iopub.status.busy":"2026-11-10T15:30:58.344637Z","iopub.status.idle":"2026-11-10T15:31:02.258318Z","shell.execute_reply":"2026-11-10T15:31:02.257414Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = FourDVarNet2D(\n    n_time=T,\n    height=H,\n    width=W,\n    latent_dim=16,\n    hidden_dim=8,\n    n_solver_steps=3,\n    key=jax.random.PRNGKey(1),\n)\n\nout = model(batch)\nprint(f\"Output shape: {out.shape}\")\n\nmse = float(jnp.mean((out - target) ** 2))\nprint(f\"MSE (untrained): {mse:.4f}\")","key":"FBmPeS5er2"},{"type":"outputs","id":"cPRJ0L6GIBqYpvf_UWK6t","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Output shape: (2, 5, 16, 16)\nMSE (untrained): 0.3954\n"},"children":[],"key":"ikZFzTjPBo"}],"key":"zWXED6VDAp"}],"identifier":"747bcfc0","html_id":"747bcfc0","key":"N71osnSxwt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualise a single time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r07omkSYl0"}],"identifier":"visualise-a-single-time-step","label":"Visualise a single time step","html_id":"visualise-a-single-time-step","implicit":true,"key":"qa4ryD9Eo1"}],"i