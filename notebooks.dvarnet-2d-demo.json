"executable":true,"value":"# (NNX removed in Epic 0 — vardax is now equinox-native)\nimport jax\nimport jax.numpy as jnp\nimport matplotlib.pyplot as plt\n\nimport vardax\nfrom vardax import Batch2D, FourDVarNet2D","key":"sIVjCjiFzG"},{"type":"outputs","id":"o_CLVcuIBEm9f47fMo-PF","children":[],"key":"aGoBSWP5a5"}],"identifier":"6f66d43e","html_id":"6f66d43e","key":"pcrfkoWORM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Generate synthetic 2-D data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tmjzJ3FEIn"}],"identifier":"generate-synthetic-2-d-data","label":"Generate synthetic 2-D data","html_id":"generate-synthetic-2-d-data","implicit":true,"key":"ZSTQoNgVmO"}],"identifier":"68316021","html_id":"68316021","key":"Nd7klwXuZb"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:18:48.920733Z","iopub.status.busy":"2026-10-30T18:18:48.920457Z","iopub.status.idle":"2026-10-30T18:18:54.751646Z","shell.execute_reply":"2026-10-30T18:18:54.750904Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\nB, T, H, W = 2, 5, 16, 16\nk1, k2 = jax.random.split(key)\ntarget = jax.random.normal(k1, (B, T, H, W))\nmask = (jax.random.uniform(k2, (B, T, H, W)) > 0.4).astype(jnp.float32)\nbatch = Batch2D(input=target * mask, mask=mask, target=target)\n\nprint(f\"Input shape: {batch.input.shape}\")","key":"WuPNbnvgyP"},{"type":"outputs","id":"mr3YtOzCJEpwDc442-raO","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Input shape: (2, 5, 16, 16)\n"},"children":[],"key":"DEuuqSsNmm"}],"key":"CrpckAdfEn"}],"identifier":"eb3d2b1e","html_id":"eb3d2b1e","key":"z37qpChcqb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jOPMeNjcOV"}],"identifier":"create-model","label":"Create model","html_id":"create-model","implicit":true,"key":"hBHjEfydjz"}],"identifier":"4b225d5a","html_id":"4b225d5a","key":"QZJ65oPU1a"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:18:54.753229Z","iopub.status.busy":"2026-10-30T18:18:54.753062Z","iopub.status.idle":"2026-10-30T18:18:58.842207Z","shell.execute_reply":"2026-10-30T18:18:58.841374Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = FourDVarNet2D(\n    n_time=T,\n    height=H,\n    width=W,\n    latent_dim=16,\n    hidden_dim=8,\n    n_solver_steps=3,\n    key=jax.random.PRNGKey(1),\n)\n\nout = model(batch)\nprint(f\"Output shape: {out.shape}\")\n\nmse = float(jnp.mean((out - target) ** 2))\nprint(f\"MSE (untrained): {mse:.4f}\")","key":"CPf2AXnYjn"},{"type":"outputs","id":"cdaaiNiWv13Er56FshPe-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Output shape: (2, 5, 16, 16)\nMSE (untrained): 0.3954\n"},"children":[],"key":"XE5i8sL0bN"}],"key":"mAa1gH69xq"}],"identifier":"5fa2747d","html_id":"5fa2747d","key":"bIRpisQ6PT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualise a single time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KcZMrogeF8"}],"identifier":"visualise-a-single-time-step","label":"Visualise a single time step","html_id":"visualise-a-single-time-step","implicit":true,"key":"kJ5PjfJ6jw"}],"identifier":"52cbd22b","html_id":"52cbd22b","key":"f2MM1z9yba"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-30T18:18:58.843816Z","iopub.status.busy":"2026-10-30T18:18:58.843633Z","iopub.status.idle":"2026-10-30T18:18:59.426951Z","shell.execute_reply":"2026-10-30T18:18:59.426148Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(12, 4))\nfor i, (ax, title) in enumerate(zip(axes, [\"Target\", \"Masked Input\", \"Reconstruction\"])):\n    data = [target, batch.input, out][i]\n    im = ax.imshow(data[0, 0], cmap=\"RdBu_r\", vmin=-2, vmax=2)\n    ax.set_title(f\"{title} (t=0)\")\n    plt.colorbar(im, ax=ax)\nplt.tight_layout()\nplt.show()","key":"q4HSyIsBCO"},{"type":"outputs","id":"_bucx-X3RokcLckM64Wpe","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"0c9ae88375bb335a0b4058f9cd05676d","path":"/vardax/build/0c9ae88375bb335a0b4058f9cd05676d.png"},"text/plain":{"content":"<Figure size 1200x400 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"VmdBgc4j2W"}],"key":"d0fA0KtBOH"}],"identifier":"cf289cb9","html_id":"cf289cb9","key":"JdatF5INYd"}],"key":"i2a3OeUOsC"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"03 — 4DVarNet End-to-End on Lorenz-63","url":"/notebooks/dvarnet-l63","group":"Tutorials"},"next":{"title":"05 — End-to-End Lorenz-63 Pipeline","url":"/notebooks/end-to-end-l63","group":"Tutorials"}}},"domain":"http://localhost:3000"}