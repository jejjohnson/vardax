tus.busy":"2026-11-27T16:06:40.655418Z","iopub.status.idle":"2026-11-27T16:06:42.743243Z","shell.execute_reply":"2026-11-27T16:06:42.742429Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# (NNX removed in Epic 0 — vardax is now equinox-native)\nimport jax\nimport jax.numpy as jnp\nimport matplotlib.pyplot as plt\n\nimport vardax\nfrom vardax import Batch2D, FourDVarNet2D","key":"g4nKmh4lXz"},{"type":"outputs","id":"YA46mcsfpy92zjAHxTsle","children":[],"key":"pCBi8aHnpu"}],"identifier":"867a1f14","html_id":"867a1f14","key":"mu0VZRBKJk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Generate synthetic 2-D data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GOdvDQTIJy"}],"identifier":"generate-synthetic-2-d-data","label":"Generate synthetic 2-D data","html_id":"generate-synthetic-2-d-data","implicit":true,"key":"CaeO3Wlfx5"}],"identifier":"7e670b9f","html_id":"7e670b9f","key":"whE3nU3xDq"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:06:42.744819Z","iopub.status.busy":"2026-11-27T16:06:42.744585Z","iopub.status.idle":"2026-11-27T16:06:45.596254Z","shell.execute_reply":"2026-11-27T16:06:45.595493Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\nB, T, H, W = 2, 5, 16, 16\nk1, k2 = jax.random.split(key)\ntarget = jax.random.normal(k1, (B, T, H, W))\nmask = (jax.random.uniform(k2, (B, T, H, W)) > 0.4).astype(jnp.float32)\nbatch = Batch2D(input=target * mask, mask=mask, target=target)\n\nprint(f\"Input shape: {batch.input.shape}\")","key":"wfL0fQRKc7"},{"type":"outputs","id":"F7JQ8qAMdHflfvK3h9E88","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Input shape: (2, 5, 16, 16)\n"},"children":[],"key":"f8Fym2Tw37"}],"key":"QyhijQQAfM"}],"identifier":"a010112f","html_id":"a010112f","key":"LJI9RBU9lw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BNXHImlccd"}],"identifier":"create-model","label":"Create model","html_id":"create-model","implicit":true,"key":"xgtSUHFrbw"}],"identifier":"4bee440a","html_id":"4bee440a","key":"hdLDwVsc0z"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:06:45.597696Z","iopub.status.busy":"2026-11-27T16:06:45.597542Z","iopub.status.idle":"2026-11-27T16:06:52.618740Z","shell.execute_reply":"2026-11-27T16:06:52.617953Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = FourDVarNet2D(\n    n_time=T,\n    height=H,\n    width=W,\n    latent_dim=16,\n    hidden_dim=8,\n    n_solver_steps=3,\n    key=jax.random.PRNGKey(1),\n)\n\nout = model(batch)\nprint(f\"Output shape: {out.shape}\")\n\nmse = float(jnp.mean((out - target) ** 2))\nprint(f\"MSE (untrained): {mse:.4f}\")","key":"z9m5E5lKLq"},{"type":"outputs","id":"n4C5j0Pj_lQeXfowUFIb1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Output shape: (2, 5, 16, 16)\nMSE (untrained): 0.3954\n"},"children":[],"key":"uUU5S6H0RO"}],"key":"HptG71IULE"}],"identifier":"9bc7dfc4","html_id":"9bc7dfc4","key":"eVbwGohAR4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualise a single time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NJG8dxHZV8"}],"identifier":"visualise-a-single-time-step","label":"Visualise a single time step","html_id":"visualise-a-single-time-step","implicit":true,"key":"v7gluLvElZ"}],"identifier":"38913282","html_id":"38913282","key":"vi0fkwRK8U"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:06:52.620211Z","iopub.status.busy":"2026-11-27T16:06:52.620040Z","iopub.status.idle":"2026-11-27T16:06:53.022914Z","shell.execute_reply":"2026-11-27T16:06:53.022092Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(12, 4))\nfor i, (ax, title) in enumerate(zip(axes, [\"Target\", \"Masked Input\", \"Reconstruction\"])):\n    data = [target, batch.input, out][i]\n    im = ax.imshow(data[0, 0], cmap=\"RdBu_r\", vmin=-2, vmax=2)\n    ax.set_title(f\"{title} (t=0)\")\n    plt.colorbar(im, ax=ax)\nplt.tight_layout()\nplt.show()","key":"AdZYui65e8"},{"type":"outputs","id":"NAxktyUUgUS_66ctMR-KT","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"0c9ae88375bb335a0b4058f9cd05676d","path":"/vardax/_public/0c9ae88375bb335a0b4058f9cd05676d.png"},"text/plain":{"content":"<Figure size 1200x400 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"LpCpbtSdKI"}],"key":"M5rSotOy9I"}],"identifier":"569d62d6","html_id":"569d62d6","key":"NjnFBBiB7K"}],"key":"C9UeMz8N2Y"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"03 — 4DVarNet End-to-End on Lorenz-63","url":"/notebooks/dvarnet-l63","group":"Tutorials"},"next":{"title":"05 — End-to-End Lorenz-63 Pipeline","url":"/notebooks/end-to-end-l63","group":"Tutorials"}}},"domain":"http://pre.render"}