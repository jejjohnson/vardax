"}],"identifier":"19e56d86","html_id":"19e56d86","key":"YkQ9jgR3lz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pCQ7eo30Ci"}],"identifier":"create-model","label":"Create model","html_id":"create-model","implicit":true,"key":"p1uyDcQadZ"}],"identifier":"05639da6","html_id":"05639da6","key":"YZxJYZyx0o"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-18T19:26:08.021281Z","iopub.status.busy":"2026-11-18T19:26:08.021074Z","iopub.status.idle":"2026-11-18T19:26:13.292796Z","shell.execute_reply":"2026-11-18T19:26:13.292277Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = FourDVarNet2D(\n    n_time=T,\n    height=H,\n    width=W,\n    latent_dim=16,\n    hidden_dim=8,\n    n_solver_steps=3,\n    key=jax.random.PRNGKey(1),\n)\n\nout = model(batch)\nprint(f\"Output shape: {out.shape}\")\n\nmse = float(jnp.mean((out - target) ** 2))\nprint(f\"MSE (untrained): {mse:.4f}\")","key":"qPsSRsIVCu"},{"type":"outputs","id":"_BOU6LK_J1waRCpx8z3Xu","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Output shape: (2, 5, 16, 16)\nMSE (untrained): 0.3954\n"},"children":[],"key":"MdbSBw8onI"}],"key":"Nud1N08Ara"}],"identifier":"2ecc0941","html_id":"2ecc0941","key":"ubxxPRtUjR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualise a single time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZoKsFIzgor"}],"identifier":"visualise-a-single-time-step","label":"Visualise a single time step","html_id":"visualise-a-single-time-step","implicit":true,"key":"dRFidEKOAn"}],"identifier":"0de5ad37","html_id":"0de5ad37","key":"YSHmLzCON9"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-18T19:26:13.294085Z","iopub.status.busy":"2026-11-18T19:26:13.293951Z","iopub.status.idle":"2026-11-18T19:26:13.582341Z","shell.execute_reply":"2026-11-18T19:26:13.581668Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 3, figsize=(12, 4))\nfor i, (ax, title) in enumerate(zip(axes, [\"Target\", \"Masked Input\", \"Reconstruction\"])):\n    data = [target, batch.input, out][i]\n    im = ax.imshow(data[0, 0], cmap=\"RdBu_r\", vmin=-2, vmax=2)\n    ax.set_title(f\"{title} (t=0)\")\n    plt.colorbar(im, ax=ax)\nplt.tight_layout()\nplt.show()","key":"rU3JdVsd47"},{"type":"outputs","id":"zCNJlanGvm2Pp5CRxBj52","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"0c9ae88375bb335a0b4058f9cd05676d","path":"/vardax/_public/0c9ae88375bb335a0b4058f9cd05676d.png"},"text/plain":{"content":"<Figure size 1200x400 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"UcmZckd5hI"}],"key":"SK99T8Vq3V"}],"identifier":"c9a33183","html_id":"c9a33183","key":"ZpezhWCW1Z"}],"key":"LBw7vb1c3G"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"03 — 4DVarNet End-to-End on Lorenz-63","url":"/notebooks/dvarnet-l63","group":"Tutorials"},"next":{"title":"05 — End-to-End Lorenz-63 Pipeline","url":"/notebooks/end-to-end-l63","group":"Tutorials"}}},"domain":"http://pre.render"}