ass=\"sizing reset-size6 size3 mtight\"><span class=\"mord text mtight\"><span class=\"mord mtight\">lon</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">16</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">16</span></span></span></span>","key":"kn90CcpYUl"},{"type":"text","value":" cells over a window of ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"WEP6SrsAq6"},{"type":"inlineMath","value":"T = 4","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>T</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding=\"application/x-tex\">T = 4</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">4</span></span></span></span>","key":"kesqI4UuUr"},{"type":"text","value":" steps (so ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"yUFtPaZ1UW"},{"type":"inlineMath","value":"T + 1 = 5","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>T</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>5</mn></mrow><annotation encoding=\"application/x-tex\">T + 1 = 5</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7667em;vertical-align:-0.0833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">5</span></span></span></span>","key":"eizIOhugO3"},{"type":"text","value":" days), observed along diagonal ground tracks. A real configuration uses ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"s0xRBUWanQ"},{"type":"inlineMath","value":"128 \\times 128","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>128</mn><mo>×</mo><mn>128</mn></mrow><annotation encoding=\"application/x-tex\">128 \\times 128</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">128</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">128</span></span></span></span>","key":"VkQAxIt5I7"},{"type":"text","value":" patches, ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"EWLvsvCh77"},{"type":"inlineCode","value":"latent_dim=32","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"J429u8qKcR"},{"type":"text","value":", ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"MGzXoXN3sZ"},{"type":"inlineCode","value":"hidden_dim=48","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"LmvDHM28XW"},{"type":"text","value":" and 15 solver steps, and is trained before use (chapter ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"ydyo1JeRN2"},{"type":"link","url":"/ssh-example","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"16","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"EwPTKGDkI0"}],"urlSource":"16_ssh_example.md","dataUrl":"/ssh-example.json","internal":true,"protocol":"file","key":"yBmyZCrqtr"},{"type":"text","value":").","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"E4LX1NQ7WI"}],"key":"LrSnStSshE"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import einx\nimport jax\nimport jax.numpy as jnp\nimport vardax as vdx\n\n# Shapes: N_batch = 1 patch; T = 4 steps, so T + 1 = 5 days\n# N_lat = N_lon = 16 cells\n\nkey = jax.random.PRNGKey(0)\nkey_model, key_noise = jax.random.split(key)\ncells = jnp.arange(16)  # (N_lat,)\ngrid = jnp.linspace(0.0, 2.0 * jnp.pi, 16)  # (N_lat,)\ndays = jnp.arange(5)  # (T + 1,)\n\n# 0.2 t\ndrift = 0.2 * days  # (T + 1,)\n# s₁ − 0.2 t\nphase = einx.subtract(\"w, t -> t w\", grid, drift)  # (T + 1, N_lon)\n# sin(s₁ − 0.2 t)\nzonal_wave = jnp.sin(phase)  # (T + 1, N_lon)\n# cos(s₂)\nmeridional_wave = jnp.cos(grid)  # (N_lat,)\n# x(t, s) = sin(s₁ − 0.2 t) cos(s₂), a toy SSH field drifting west\nssh_truth = einx.multiply(  # (T + 1, N_lat, N_lon)\n    \"t w, h -> t h w\", zonal_wave, meridional_wave\n)\n# i + j\ndiagonal_index = einx.add(\"h, w -> h w\", cells, cells)  # (N_lat, N_lon)\n# 3t\ntrack_shift = 3 * days  # (T + 1,)\n# i + j − 3t, the along-track coordinate of a diagonal ground track\ntrack_coord = einx.subtract(  # (T + 1, N_lat, N_lon)\n    \"h w, t -> t h w\", diagonal_index, track_shift\n)\n# (i + j − 3t) mod 8\ntrack_phase = track_coord % 8  # (T + 1, N_lat, N_lon)\n# i + j − 3t ≡ 0 (mod 8)\non_track = track_phase == 0  # (T + 1, N_lat, N_lon)\n# m = 1 on track, 0 in the gaps\ntrack_mask = on_track.astype(jnp.float32)  # (T + 1, N_lat, N_lon)\n# ε ~ 𝒩(0, I)\nnoise = jax.random.normal(key_noise, (5, 16, 16))  # (T + 1, N_lat, N_lon)\n# 0.02 ε\nscaled_noise = 0.02 * noise  # (T + 1, N_lat, N_lon)\n# x + 0.02 ε\nnoisy_ssh = ssh_truth + scaled_noise  # (T + 1, N_lat, N_lon)\n# y = m ⊙ (x + 0.02 ε), zero-filled gaps\nssh_tracks = track_mask * noisy_ssh  # (T + 1, N_lat, N_lon)\n\n# today (vardax)\nmodel = vdx.FourDVarNet2D(\n    n_time=5,  # T + 1: days in the assimilation window\n    height=16,  # N_lat, N_lon: regional lat-lon patch\n    width=16,\n    latent_dim=8,\n    hidden_dim=8,\n    n_solver_steps=3,\n    key=key_model,\n)\ntracks_patch = einx.id(  # (T + 1, N_lat, N_lon) → (N_batch, T + 1, N_lat, N_lon)\n    \"t h w -> 1 t h w\", ssh_tracks\n)\nmask_patch = einx.id(  # (T + 1, N_lat, N_lon) → (N_batch, T + 1, N_lat, N_lon)\n    \"t h w -> 1 t h w\", track_mask\n)\ntruth_patch = einx.id(  # (T + 1, N_lat, N_lon) → (N_batch, T + 1, N_lat, N_lon)\n    \"t h w -> 1 t h w\", ssh_truth\n)\n# today (vardax)\nbatch = vdx.Batch2D(\n    input=tracks_patch,\n    mask=mask_patch,  # 1 on-track, 0 in gaps\n    target=truth_patch,  # OSSE only\n)\n# today (vardax)\n# x⋆ = argminₓ 𝒥(x), unrolled by the learned solver\nssh_maps = model(batch)  # → (N_batch, T + 1, N_lat, N_lon)\n# mean(m), the observed fraction\nobserved_fraction = einx.mean(\"t h w ->\", track_mask)  # → ()\nprint(f\"observed fraction {observed_fraction:.3f}, maps {ssh_maps.shape}\")","key":"gbNPGcsWOS"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-oceanbench-ssh-interpolation","identifier":"code-oceanbench-ssh-interpolation","html_id":"code-oceanbench-ssh-interpolation","enumerator":"21.1","children":[{"type":"text","value":"Program ","key":"mlyPCMnz2I"},{"type":"text","value":"21.1","key":"xbEZh0kkrL"},{"type":"text","value":":","key":"Zkd3i7i4Hb"}],"template":"Program %s:","key":"uftkmmrJXn"},{"type":"text","value":"Runs an untrained 4DVarNet, the update ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"GJFhcGND7d"},{"type":"crossReference","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"(","key":"Et1imFSGlx"},{"type":"text","value":"9.2","key":"TgPvK2aP3w"},{"type":"text","value":")","key":"O1o1WhSNPf"}],"identifier":"eq-4dvarnet-update","label":"eq-4dvarnet-update","kind":"equation","template":"(%s)","enumerator":"9.2","resolved":true,"html_id":"eq-4dvarnet-update","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"ePHKocfVa4"},{"type":"text","value":" on the cost ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"EnZhzDoR9t"},{"type":"crossReference","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"(","key":"JJWLHLq2Gs"},{"type":"text","value":"9.1","key":"Ad46RiBvnp"},{"type":"text","value":")","key":"ASISQjBuaL"}],"identifier":"eq-4dvarnet-cost","label":"eq-4dvarnet-cost","kind":"equation","template