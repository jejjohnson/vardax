/span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mop\">cos</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">y</span><span class=\"mclose\">)</span></span></span></span>","key":"gnn7fldDpY"},{"type":"text","value":" on ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"dnUvzdH8vc"},{"type":"inlineMath","value":"16 \\times 16","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>16</mn><mo>×</mo><mn>16</mn></mrow><annotation encoding=\"application/x-tex\">16 \\times 16</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">16</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">16</span></span></span></span>","key":"PTZJfGdxFk"},{"type":"text","value":" cells, observed along diagonal ground tracks. A real configuration uses ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"DwxuqoxfgO"},{"type":"inlineMath","value":"128 \\times 128","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>128</mn><mo>×</mo><mn>128</mn></mrow><annotation encoding=\"application/x-tex\">128 \\times 128</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">128</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">128</span></span></span></span>","key":"zRmLEF9j7W"},{"type":"text","value":" patches, ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"QW9n00hmif"},{"type":"inlineCode","value":"latent_dim=32","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"anMvtLMgDV"},{"type":"text","value":", ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"rGcIeiuzvM"},{"type":"inlineCode","value":"hidden_dim=48","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"IWQ4T3XJX7"},{"type":"text","value":" and 15 solver steps, and is trained before use (chapter ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"u3gqkPRt5x"},{"type":"link","url":"/ssh-example","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"16","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"WCQmDBgmDx"}],"urlSource":"16_ssh_example.md","dataUrl":"/ssh-example.json","internal":true,"protocol":"file","key":"kAmRhvngLM"},{"type":"text","value":").","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"Ss4jL4eebu"}],"key":"s1ixMc0SEt"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import einx\nimport jax\nimport jax.numpy as jnp\nimport vardax as vdx\n\n# Shapes: B = 1 patch; T = 5 days; H = W = 16 lat-lon cells\n\nkey = jax.random.PRNGKey(0)\nkey_model, key_noise = jax.random.split(key)\ncells = jnp.arange(16)  # (H,)\ngrid = jnp.linspace(0.0, 2.0 * jnp.pi, 16)  # (H,)\ndays = jnp.arange(5)  # (T,)\n\n# 0.2 t\ndrift = 0.2 * days  # (T,)\n# x − 0.2 t\nphase = einx.subtract(\"w, t -> t w\", grid, drift)  # (T, W)\n# sin(x − 0.2 t)\nzonal_wave = jnp.sin(phase)  # (T, W)\n# cos(y)\nmeridional_wave = jnp.cos(grid)  # (H,)\n# η(t, y, x) = sin(x − 0.2 t) cos(y), a toy SSH field drifting west\nssh_truth = einx.multiply(  # (T, H, W)\n    \"t w, h -> t h w\", zonal_wave, meridional_wave\n)\n# i + j\ndiagonal_index = einx.add(\"h, w -> h w\", cells, cells)  # (H, W)\n# 3t\ntrack_shift = 3 * days  # (T,)\n# i + j − 3t, the along-track coordinate of a diagonal ground track\ntrack_coord = einx.subtract(  # (T, H, W)\n    \"h w, t -> t h w\", diagonal_index, track_shift\n)\n# (i + j − 3t) mod 8\ntrack_phase = track_coord % 8  # (T, H, W)\n# i + j − 3t ≡ 0 (mod 8)\non_track = track_phase == 0  # (T, H, W)\n# m = 1 on track, 0 in the gaps\ntrack_mask = on_track.astype(jnp.float32)  # (T, H, W)\n# ε ~ 𝒩(0, I)\nnoise = jax.random.normal(key_noise, (5, 16, 16))  # (T, H, W)\n# 0.02 ε\nscaled_noise = 0.02 * noise  # (T, H, W)\n# η + 0.02 ε\nnoisy_ssh = ssh_truth + scaled_noise  # (T, H, W)\n# y = m ⊙ (η + 0.02 ε), zero-filled gaps\nssh_tracks = track_mask * noisy_ssh  # (T, H, W)\n\n# today (vardax)\nmodel = vdx.FourDVarNet2D(\n    n_time=5,  # T: days in the assimilation window\n    height=16,  # H, W: regional lat-lon patch\n    width=16,\n    latent_dim=8,\n    hidden_dim=8,\n    n_solver_steps=3,\n    key=key_model,\n)\ntracks_patch = einx.id(\"t h w -> 1 t h w\", ssh_tracks)  # (T, H, W) → (B, T, H, W)\nmask_patch = einx.id(\"t h w -> 1 t h w\", track_mask)  # (T, H, W) → (B, T, H, W)\ntruth_patch = einx.id(\"t h w -> 1 t h w\", ssh_truth)  # (T, H, W) → (B, T, H, W)\n# today (vardax)\nbatch = vdx.Batch2D(\n    input=tracks_patch,\n    mask=mask_patch,  # 1 on-track, 0 in gaps\n    target=truth_patch,  # OSSE only\n)\n# today (vardax)\n# x* = argminₓ U(x), unrolled by the learned solver\nssh_maps = model(batch)  # → (B, T, H, W)\n# (1/(T H W)) Σ m\nobserved_fraction = einx.mean(\"t h w ->\", track_mask)  # → ()\nprint(f\"observed fraction {observed_fraction:.3f}, maps {ssh_maps.shape}\")","key":"QkXRJzaxnM"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-oceanbench-ssh-interpolation","identifier":"code-oceanbench-ssh-interpolation","html_id":"code-oceanbench-ssh-interpolation","enumerator":"21.1","children":[{"type":"text","value":"Program ","key":"xN8YrYINFL"},{"type":"text","value":"21.1","key":"Z9zeQUUkXR"},{"type":"text","value":":","key":"nmStQPo9Hc"}],"template":"Program %s:","key":"sSF1biscot"},{"type":"text","value":"Runs an untrained 4DVarNet, the update ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"iIu415tDPx"},{"type":"crossReference","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"(","key":"nJLnwkOElT"},{"type":"text","value":"9.2","key":"nsI0x0smK7"},{"type":"text","value":")","key":"h1h4kyM1Ah"}],"identifier":"eq-4dvarnet-update","label":"eq-4dvarnet-update","kind":"equation","template":"(%s)","enumerator":"9.2","resolved":true,"html_id":"eq-4dvarnet-update","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"k3X58LEkWd"},{"type":"text","value":" on the cost ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"fEcNC3JGKK"},{"type":"crossReference","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"(","key":"URTeGvCAQZ"},{"type":"text","value":"9.1","key":"kdwwQzPsFA"},{"type":"text","value":")","key":"JLCAqx7PBj"}],"identifier":"eq-4dvarnet-cost","label":"eq-4dvarnet-cost","kind":"equation","template":"(%s)","enumerator":"9.1","resolved":true,"html_id":"eq-4dvarnet-cost","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"tKEa8f1ogv"},{"type":"text","value":", on a toy SSH field observed along tracks through the masked identity ","position":{"start":{"line":60,"column":1},"end":{"line":60,"colum