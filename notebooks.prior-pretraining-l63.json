pe":"text","value":"\nMinimise the reconstruction loss ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"X4GZZk4UGL"},{"type":"inlineMath","value":"\\|x - \\varphi(x)\\|^2","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">∥</mi><mi>x</mi><mo>−</mo><mi>φ</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><msup><mi mathvariant=\"normal\">∥</mi><mn>2</mn></msup></mrow><annotation encoding=\"application/x-tex\">\\|x - \\varphi(x)\\|^2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">∥</span><span class=\"mord mathnormal\">x</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.0641em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">φ</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mord\"><span class=\"mord\">∥</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span>","key":"OqJHxVdTVQ"},{"type":"text","value":" on clean L63\ntrajectories to obtain a good prior without any observation masking.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"VELnZYcZA7"}],"key":"qSugmnuwpk"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Stage 2 — End-to-end fine-tuning:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"wFhDzytVkq"}],"key":"OcDcgaRCi0"},{"type":"text","value":"\nInitialise ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"L42lOR8VPI"},{"type":"inlineCode","value":"FourDVarNet1D","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"GJASYwwt55"},{"type":"text","value":" with the pre-trained prior weights and fine-tune\nend-to-end on the partially-observed reconstruction task.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"EudABKZiEo"}],"key":"qzibec49KA"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"We then compare learning curves and final reconstruction quality against\ntraining from scratch (no pre-training).","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"BOm9GBPDiJ"}],"key":"HHGEYiM5B7"}],"identifier":"2471cb20","html_id":"2471cb20","key":"b55uinmsq4"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:23.564928Z","iopub.status.busy":"2026-11-27T16:07:23.564793Z","iopub.status.idle":"2026-11-27T16:07:25.786650Z","shell.execute_reply":"2026-11-27T16:07:25.785857Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import jax\nimport jax.numpy as jnp\nimport matplotlib.pyplot as plt\nimport optax\n\nimport vardax\nfrom vardax import (\n    Batch1D,\n    BilinAEPrior1D,\n    FourDVarNet1D,\n)\nfrom vardax._src.utils.dynamical_systems import simulate_lorenz63\nfrom vardax._src.utils.patches import trajectory_to_xr_dataset, extract_patches\nfrom vardax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import xr_to_batch1d\nfrom vardax._src.utils.standardize import compute_scaler_params, apply_standardization","key":"uMeqIZGon4"},{"type":"outputs","id":"eJJYUArVDV2etlGYc_Pkr","children":[],"key":"YuJ1SuyBzc"}],"identifier":"ca7af52a","html_id":"ca7af52a","key":"zdDi0pN7mR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Simulate L63 and prepare data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VvejNSIKki"}],"identifier":"id-1-simulate-l63-and-prepare-data","label":"1. Simulate L63 and prepare data","html_id":"id-1-simulate-l63-and-prepare-data","implicit":true,"key":"ppMO90kTBl"}],"identifier":"07a80969","html_id":"07a80969","key":"T9tp1SbLi7"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:25.788512Z","iopub.status.busy":"2026-11-27T16:07:25.788227Z","iopub.status.idle":"2026-11-27T16:07:27.119979Z","shell.execute_reply":"2026-11-27T16:07:27.119206Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\ntime_coords, states = simulate_lorenz63(\n    key, sigma=10.0, rho=28.0, beta=8.0 / 3.0, dt=0.01, n_steps=5000, n_burn_in=1000\n)\nds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\n# Split the trajectory in time *before* cutting windows, so no window\n# straddles the boundary: windows drawn at random from one trajectory and\n# split afterwards would leak test timesteps into the training set.\nn_time = ds.sizes[\"time\"]\nds_train = extract_patches(ds.isel(time=slice(0, int(0.8 * n_time))), n_patches=160, n_timesteps=20, seed=42)\nds_test = extract_patches(ds.isel(time=slice(int(0.8 * n_time), None)), n_patches=40, n_timesteps=20, seed=43)\nds_train = regular_mask(ds_train, variable=\"state\", obs_interval=2)\nds_test = regular_mask(ds_test, variable=\"state\", obs_interval=2)\nds_train = add_gaussian_noise(ds_train, variable=\"state\", sigma=0.5, seed=0, name=\"obs\")\nds_test = add_gaussian_noise(ds_test, variable=\"state\", sigma=0.5, seed=1, name=\"obs\")\nmean, std = compute_scaler_params(ds_train, variable=\"state\", mask_variable=\"mask\")\nds_train = apply_standardization(ds_train, variables=[\"state\", \"obs\"], mean=mean, std=std)\nds_test = apply_standardization(ds_test, variables=[\"state\", \"obs\"], mean=mean, std=std)\n\nbatch_train = xr_to_batch1d(ds_train, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nbatch_test = xr_to_batch1d(ds_test, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nprint(f\"Train: {batch_train.input.shape}, Test: {batch_test.input.shape}\")","key":"DpRQX6cSJ5"},{"type":"outputs","id":"f59ayIOvVI7CmE5lQ0Eho","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Train: (160, 20, 3), Test: (40, 20, 3)\n"},"children":[],"key":"PIfPdc1LyX"}],"key":"fcqq4ItToE"}],"identifier":"aa92a875","html_id":"aa92a875","key":"QH9df0tcG2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Stage 1 — Pre-train the prior as an autoencoder","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Lpb1v6ak3j"}],"identifier":"id-2-stage-1-pre-train-the-prior-as-an-autoencoder","label":"2. Stage 1 — Pre-train the prior as an autoencoder","html_id":"id-2-stage-1-pre-train-the-prior-as-an-autoencoder","implicit":true,"key":"BsbDSi6yw4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Minimise ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"i0qe7YguFK"},{"type":"inlineMath","value":"\\|x - \\varphi(x)\\|^2","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">∥</mi><mi>x</mi><mo>−</mo><mi>φ</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><msup><mi mathvariant=\"normal\">∥</mi><mn>2</mn></msup></mrow><annotation encoding=\"application/x-tex\">\\|x - \\varphi(x)\\|^2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">∥</span><span class=\"mord mathnormal\">x</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.0641em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">φ</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mord\"><span class=\"mord\">∥</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span>","key":"EecYqjTCji"},{"type":"text","value":" on clean (unmasked) state trajectories.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"D30yvQr9AE"}],"key":"cDLqc2HctC"}],"identifier":"2e49c9fe","html_id":"2e49c9fe","key":"dpRLM5CYdK"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:27.121424Z","iopub.status.busy":"2026-11-27T16:07:27.121255Z","iopub.status.idle":"2026-11-27T16:07:29.965053Z","shell.execute_reply":"2026-11-27T16:07:29.964284Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# (NNX removed in Epic 0 — vardax is now equinox-native)\n\nB, T, N = batch_train.input.shape\nprior = BilinAEPrior1D(state_dim=N, latent_dim=8, n_time=T, key=jax.random.PRNGKey(10))\n\nimport equinox as eqx\n\npre_optimizer = optax.adam(1e-3)\npre_opt_state = pre_optimizer.init(eqx.filter(prior, eqx.is_array))\n\npretrain_losses = []\nn_pretrain_epochs = 20\n\n\ndef pretrain_loss_fn(prior, x):\n    x_recon = prior(x)\n    return jnp.mean((x - x_recon) ** 2)\n\n\nfor epoch in range(n_pretrain_epochs):\n    loss_val, grads = eqx.filter_value_and_grad(pretrain_loss_fn)(\n        prior, batch_train.target\n    )\n    updates, pre_opt_state = pre_optimizer.update(grads, pre_opt_state, prior)\n    prior = eqx.apply_updates(prior, updates)\n    pretrain_losses.append(float(loss_val))\n\nprint(f\"Pre-train final loss: {pretrain_losses[-1]:.6f}\")","key":"qroiobeFSy"},{"type":"outputs","id":"BvJfGNA6wlqLttnVN1GPb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Pre-train final loss: 0.817934\n"},"children":[],"key":"beZK4gEcAD"}],"key":"KslozigH4g"}],"identifier":"b89d025e","html_id":"b89d025e","key":"V1QZ6PLMGA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Stage 2a — Fine-tune with pre-trained prior","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VidUEU8uep"}],"identifier":"id-3-stage-2a-fine-tune-with-pre-trained-prior","label":"3. Stage 2a — Fine-tune with pre-trained prior","html_id":"id-3-stage-2a-fine-tune-with-pre-trained-prior","implicit":true,"key":"TrahNk4Hr2"}],"identifier":"4adb8e27","html_id":"4adb8e27","key":"mLoQ116loH"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:29.966679Z","iopub.status.busy":"2026-11-27T16:07:29.966508Z","iopub.status.idle":"2026-11-27T16:07:32.510694Z","shell.execute_reply":"2026-11-27T16:07:32.509978Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model_pretrained = FourDVarNet1D(\n    state_dim=N, n_time=T, latent_dim=8, hidden_dim=16, n_solver_steps=10,\n    key=jax.random.PRNGKey(1),\n)\n\n# Copy pre-trained prior weights into the model's prior sub-module.\n# In Equinox, replace the prior subtree in-place with the pre-trained one.\nmodel_pretrained = eqx.tree_at(lambda m: m.prior, model_pretrained, prior)","key":"d30MrCOsAA"},{"type":"outputs","id":"FNE94tWaCEFjBrVCPGBnQ","children":[],"key":"rQDncXmQJY"}],"identifier":"2a92de72","html_id":"2a92de72","key":"a5lLTxQR0t"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Stage 2b — Train from scratch (no pre-training)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FaUd66GSmm"}],"identifier":"id-4-stage-2b-train-from-scratch-no-pre-training","label":"4. Stage 2b — Train from scratch (no pre-training)","html_id":"id-4-stage-2b-train-from-scratch-no-pre-training","implicit":true,"key":"CkeWdC4cdm"}],"identifier":"596f6dea","html_id":"596f6dea","key":"aEBZBYZAwV"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:32.512484Z","iopub.status.busy":"2026-11-27T16:07:32.512304Z","iopub.status.idle":"2026-11-27T16:07:32.519001Z","shell.execute_reply":"2026-11-27T16:07:32.518342Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model_scratch = FourDVarNet1D(\n    state_dim=N, n_time=T, latent_dim=8, hidden_dim=16, n_solver_steps=10,\n    key=jax.random.PRNGKey(1),\n)","key":"hwUVGJ4S9e"},{"type":"outputs","id":"birMZOfgwPI30GZa2rXrW","children":[],"key":"wsDIKdZD2G"}],"identifier":"c383800b","html_id":"c383800b","key":"R1aTG601qS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Train both models end-to-end for the same number of epochs.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B2qDJVRMDr"}],"key":"W4zHy9oqwM"}],"identifier":"2b2d65fa","html_id":"2b2d65fa","key":"BfKf6brR0M"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:32.520502Z","iopub.status.busy":"2026-11-27T16:07:32.520326Z","iopub.status.idle":"2026-11-27T16:07:38.870248Z","shell.execute_reply":"2026-11-27T16:07:38.869508Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"n_finetune_epochs = 10\n\nmodel_pretrained, metrics_pretrained, _ = vardax.examples.fit_demo(\n    model_pretrained,\n    [batch_train],\n    n_epochs=n_finetune_epochs,\n    lr=1e-3,\n    verbose=False,\n)\n\nmodel_scratch, metrics_scratch, _ = vardax.examples.fit_demo(\n    model_scratch,\n    [batch_train],\n    n_epochs=n_finetune_epochs,\n    lr=1e-3,\n    verbose=False,\n)","key":"FpyxoYFNCA"},{"type":"outputs","id":"ULBorKi685pexhmEOWJb5","children":[],"key":"Xm0g5jpQfw"}],"identifier":"95af2bd8","html_id":"95af2bd8","key":"GjffSEwQDX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Compare learning curves and reconstruction quality","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Le3vvNGRze"}],"identifier":"id-4-compare-learning-curves-and-reconstruction-quality","label":"4. Compare learning curves and reconstruction quality","html_id":"id-4-compare-learning-curves-and-reconstruction-quality","implicit":true,"key":"B1RV5oQhX9"}],"identifier":"8ab6b407","html_id":"8ab6b407","key":"rFERQBzcVF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-27T16:07:38.872058Z","iopub.status.busy":"2026-11-27T16:07:38.871885Z","iopub.status.idle":"2026-11-27T16:07:40.754751Z","shell.execute_reply":"2026-11-27T16:07:40.753888Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\n# Learning curves\nlosses_pretrained = metrics_pretrained\nlosses_scratch = metrics_scratch\naxes[0].plot(losses_pretrained, label=\"Pre-trained prior\")\naxes[0].plot(losses_scratch, label=\"From scratch\")\naxes[0].set_xlabel(\"Epoch\")\naxes[0].set_ylabel(\"Train loss\")\naxes[0].set_title(\"Learning curves\")\naxes[0].legend()\n\n# Final test MSE\nout_pretrained = model_pretrained(batch_test)\nout_scratch = model_scratch(batch_test)\ntarget = batch_test.target\nmse_pretrained = float(jnp.mean((out_pretrained - target) ** 2))\nmse_scratch = float(jnp.mean((out_scratch - target) ** 2))\n\nbars = axes[1].bar(\n    [\"Pre-trained prior\", \"From scratch\"],\n    [mse_pretrained, mse_scratch],\n    color=[\"#77dd77\", \"#aec6cf\"],\n)\naxes[1].set_ylabel(\"Test MSE\")\naxes[1].set_title(\"Reconstruction quality\")\nfor bar, val in zip(bars, [mse_pretrained, mse_scratch]):\n    axes[1].text(\n        bar.get_x() + bar.get_width() / 2.0,\n        bar.get_height() + 0.001,\n        f\"{val:.4f}\",\n        ha=\"center\",\n        va=\"bottom\",\n    )\n\nplt.tight_layout()\nplt.show()\nprint(f\"Pre-trained MSE: {mse_pretrained:.4f}  |  From-scratch MSE: {mse_scratch:.4f}\")","key":"FoOuK61ogn"},{"type":"outputs","id":"Tk2FYymWFUrE4A3JMC-he","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9f6bbf65eed21a83ed730c498a74c0d2","path":"/vardax/_public/9f6bbf65eed21a83ed730c498a74c0d2.png"},"text/plain":{"content":"<Figure size 1200x400 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"WJ1eVnrilT"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Pre-trained MSE: 0.3993  |  From-scratch MSE: 0.4065\n"},"children":[],"key":"TBb5mSSSWY"}],"key":"nNacgYIA4V"}],"identifier":"2e838d25","html_id":"2e838d25","key":"O78qkEjlsl"}],"key":"uSZcVM3uzu"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"06 — End-to-End Lorenz-96 Pipeline","url":"/notebooks/end-to-end-l96","group":"Tutorials"},"next":{"title":"08 — Classical 4DVar vs 4DVarNet on Lorenz-63","url":"/notebooks/classical-4dvar-vs-4dvarnet-l63","group":"Tutorials"}}},"domain":"http://pre.render"}