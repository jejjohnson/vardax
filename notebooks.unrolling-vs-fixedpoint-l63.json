nlineCode","value":"solve_4dvarnet_1d_fixedpoint","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"FpqRGjz3xL"},{"type":"text","value":", K=10 steps)","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"T0ufkVVd8b"}],"key":"AO6Wjp9luu"}],"key":"so3R7m6IIN"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compare MSE across conditions with a bar chart","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"wHBWoAHB1L"}],"key":"uTf9uKU0BA"}],"key":"A66hL6fL2u"}],"key":"FwEKQIsjio"}],"identifier":"3ecd8d9f","html_id":"3ecd8d9f","key":"DhtLuhUpZ6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:26.710945Z","iopub.status.busy":"2026-11-10T15:30:26.710682Z","iopub.status.idle":"2026-11-10T15:30:30.130317Z","shell.execute_reply":"2026-11-10T15:30:30.129381Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# (NNX removed in Epic 0 — vardax is now equinox-native)\nimport jax\nimport jax.numpy as jnp\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nimport vardax\nfrom vardax import (\n    Batch1D,\n    BilinAEPrior1D,\n    FourDVarNet1D,\n    solve_4dvarnet_1d_fixedpoint,\n)\nfrom vardax._src.utils.dynamical_systems import simulate_lorenz63\nfrom vardax._src.utils.patches import trajectory_to_xr_dataset, extract_patches\nfrom vardax._src.utils.masks import regular_mask\nfrom vardax._src.utils.noise import add_gaussian_noise\nfrom vardax._src.utils.preprocessing import (\n    xr_to_batch1d,\n    obs_interpolation_init,\n)\nfrom vardax._src.utils.standardize import compute_scaler_params, apply_standardization\nimport xarray as xr","key":"v2K8MUf3r5"},{"type":"outputs","id":"bZKPEx_8jGPipgG1RGt2L","children":[],"key":"aWxckokj4A"}],"identifier":"d3caf97f","html_id":"d3caf97f","key":"ukBiLYE0g0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Simulate Lorenz-63 and build patches","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RM4VghZiMg"}],"identifier":"id-1-simulate-lorenz-63-and-build-patches","label":"1. Simulate Lorenz-63 and build patches","html_id":"id-1-simulate-lorenz-63-and-build-patches","implicit":true,"key":"h0RjynXtlW"}],"identifier":"534dda38","html_id":"534dda38","key":"z1eHdcOBx3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:30.132228Z","iopub.status.busy":"2026-11-10T15:30:30.131909Z","iopub.status.idle":"2026-11-10T15:30:31.317594Z","shell.execute_reply":"2026-11-10T15:30:31.316684Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\ntime_coords, states = simulate_lorenz63(\n    key,\n    sigma=10.0,\n    rho=28.0,\n    beta=8.0 / 3.0,\n    dt=0.01,\n    n_steps=5000,\n    n_burn_in=1000,\n)\nprint(f\"states shape: {states.shape}\")\n\nds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\n# Split the trajectory in time *before* cutting windows, so no window\n# straddles the boundary: windows drawn at random from one trajectory and\n# split afterwards would leak test timesteps into the training set.\nn_time = ds.sizes[\"time\"]\nds_train = extract_patches(ds.isel(time=slice(0, int(0.8 * n_time))), n_patches=160, n_timesteps=20, seed=42)\nds_test = extract_patches(ds.isel(time=slice(int(0.8 * n_time), None)), n_patches=40, n_timesteps=20, seed=43)\nds_train = regular_mask(ds_train, variable=\"state\", obs_interval=2)\nds_test = regular_mask(ds_test, variable=\"state\", obs_interval=2)\nds_train = add_gaussian_noise(ds_train, variable=\"state\", sigma=0.5, seed=0, name=\"obs\")\nds_test = add_gaussian_noise(ds_test, variable=\"state\", sigma=0.5, seed=1, name=\"obs\")\nmean, std = compute_scaler_params(ds_train, variable=\"state\", mask_variable=\"mask\")\nds_train = apply_standardization(ds_train, variables=[\"state\", \"obs\"], mean=mean, std=std)\nds_test = apply_standardization(ds_test, variables=[\"state\", \"obs\"], mean=mean, std=std)\n\nbatch_train = xr_to_batch1d(ds_train, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nbatch_test = xr_to_batch1d(ds_test, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nprint(f\"train batch: {batch_train.input.shape}, test batch: {batch_test.input.shape}\")","key":"hWdIqCWxnl"},{"type":"outputs","id":"T2u_2NF8q91qxRoKE3I2r","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"states shape: (5001, 3)\ntrain batch: (160, 20, 3), test batch: (40, 20, 3)\n"},"children":[],"key":"CHRjYrsOT9"}],"key":"pGTPWjxmaz"}],"identifier":"b047c885","html_id":"b047c885","key":"Le2f5ShWes"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Warm-start initialisation via ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ntW4oJ9pAM"},{"type":"inlineCode","value":"obs_interpolation_init","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"umHoY69ZVH"}],"identifier":"id-2-warm-start-initialisation-via-obs-interpolation-init","label":"2. Warm-start initialisation via obs_interpolation_init","html_id":"id-2-warm-start-initialisation-via-obs-interpolation-init","implicit":true,"key":"tx0Rq5iSFN"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Build a NaN-masked obs dataset so we can use ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tLdozndabr"},{"type":"inlineCode","value":"obs_interpolation_init","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GxLEzA7pVm"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YiENU2LVJO"}],"key":"koLxgvFf56"}],"identifier":"f9bd8677","html_id":"f9bd8677","key":"ll7bRnN7hw"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:31.319183Z","iopub.status.busy":"2026-11-10T15:30:31.318989Z","iopub.status.idle":"2026-11-10T15:30:31.434752Z","shell.execute_reply":"2026-11-10T15:30:31.433861Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"state_vals = ds_test[\"state\"].values\nmask_vals = ds_test[\"mask\"].values.astype(bool)\nobs_nan = np.where(mask_vals, ds_test[\"obs\"].values, np.nan).astype(np.float32)\nobs_nan_da = xr.DataArray(obs_nan, dims=ds_test[\"obs\"].dims, coords=ds_test[\"obs\"].coords)\nds_test_nan = ds_test.assign(obs_nan=obs_nan_da)\n\nds_test_init = obs_interpolation_init(\n    ds_test_nan, variable=\"state\", obs_variable=\"obs_nan\"\n)\nx_init = jnp.array(ds_test_init[\"state_init\"].values)\nprint(f\"Warm-start init shape: {x_init.shape}\")\n\n# MSE of warm-start vs zero init\ntarget = batch_test.target\nmse_zero_init = float(jnp.mean((batch_test.input * batch_test.mask - target) ** 2))\nmse_warm_init = float(jnp.mean((x_init - target) ** 2))\nprint(f\"Zero-init MSE: {mse_zero_init:.4f}\")\nprint(f\"Warm-start MSE: {mse_warm_init:.4f}\")","key":"HsephHh1Bz"},{"type":"outputs","id":"9r1VDu6616AsS9eDJfor-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Warm-start init shape: (40, 20, 3)\nZero-init MSE: 0.6445\nWarm-start MSE: 0.0654\n"},"children":[],"key":"wHxC7ozUtp"}],"key":"OsZ4f9eSIx"}],"identifier":"1e22c686","html_id":"1e22c686","key":"BMoDlMDFY3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Train FourDVarNet1D (unrolled solver)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hsUz66SsDl"}],"identifier":"id-3-train-fourdvarnet1d-unrolled-solver","label":"3. Train FourDVarNet1D (unrolled solver)","html_id":"id-3-train-fourdvarnet1d-unrolled-solver","implicit":true,"key":"Kkpx6JeCUX"}],"identifier":"899f4aa7","html_id":"899f4aa7","key":"uqfCmXDqNY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:31.436388Z","iopub.status.busy":"2026-11-10T15:30:31.436211Z","iopub.status.idle":"2026-11-10T15:30:36.749497Z","shell.execute_reply":"2026-11-10T15:30:36.748691Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"B, T, N = batch_train.input.shape\nmodel_unrolled = FourDVarNet1D(\n    state_dim=N,\n    n_time=T,\n    latent_dim=8,\n    hidden_dim=16,\n    n_solver_steps=10,\n    key=jax.random.PRNGKey(1),\n)\n\nmodel, train_losses, _ = vardax.examples.fit_demo(\n    model_unrolled,\n    [batch_train],\n    n_epochs=5,\n    lr=1e-3,\n    verbose=True,\n)\nprint(f\"Final unrolled train loss: {train_losses[-1]:.4f}\")","key":"aWJzBnNLWV"},{"type":"outputs","id":"9xK-e9zHBxJS_IwHEjh4j","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"epoch 1/5 — train loss: 0.562356\nepoch 2/5 — train loss: 0.524042\nepoch 3/5 — train loss: 0.489939\nepoch 4/5 — train loss: 0.459364\nepoch 5/5 — train loss: 0.431853\nFinal unrolled train loss: 0.4319\n"},"children":[],"key":"naX8QQAtSF"}],"key":"SvZQmh1U5F"}],"identifier":"b4fdd488","html_id":"b4fdd488","key":"rG3pGbfG4K"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Fixed-point solver (untrained prior)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i0vWIlhAg0"}],"identifier":"id-4-fixed-point-solver-untrained-prior","label":"4. Fixed-point solver (untrained prior)","html_id":"id-4-fixed-point-solver-untrained-prior","implicit":true,"key":"kVyv8fLhzT"}],"identifier":"7ea5859a","html_id":"7ea5859a","key":"M0QTmvS9xR"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:36.751260Z","iopub.status.busy":"2026-11-10T15:30:36.751058Z","iopub.status.idle":"2026-11-10T15:30:36.882818Z","shell.execute_reply":"2026-11-10T15:30:36.881758Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"prior = BilinAEPrior1D(state_dim=N, latent_dim=8, n_time=T, key=jax.random.PRNGKey(3))\n\nout_fp = solve_4dvarnet_1d_fixedpoint(batch_test, prior, n_fp_steps=10)\nprint(f\"Fixed-point output shape: {out_fp.shape}\")","key":"yfh2kGskl4"},{"type":"outputs","id":"a3gW1i2YycvcixHZuAAPv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Fixed-point output shape: (40, 20, 3)\n"},"children":[],"key":"O1LG2ey2iX"}],"key":"P75Y6uyCv6"}],"identifier":"f60e3546","html_id":"f60e3546","key":"GLF89d1Toj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Evaluate unrolled solver on test batch","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b8upAliOKi"}],"identifier":"id-5-evaluate-unrolled-solver-on-test-batch","label":"5. Evaluate unrolled solver on test batch","html_id":"id-5-evaluate-unrolled-solver-on-test-batch","implicit":true,"key":"lIok255W0n"}],"identifier":"a77edb4b","html_id":"a77edb4b","key":"V87msYbWuB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:36.884579Z","iopub.status.busy":"2026-11-10T15:30:36.884391Z","iopub.status.idle":"2026-11-10T15:30:38.479175Z","shell.execute_reply":"2026-11-10T15:30:38.478284Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# `fit_demo` returns a new (trained) Equinox module; `model_unrolled` is the\n# untrained initialisation.\nout_unrolled = model(batch_test)\nprint(f\"Unrolled output shape: {out_unrolled.shape}\")","key":"bxUaZKzJwI"},{"type":"outputs","id":"PCi83Qc_pngBURwFMpfKQ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Unrolled output shape: (40, 20, 3)\n"},"children":[],"key":"Fs7qhPXFmr"}],"key":"sm70HD9rX1"}],"identifier":"08861f66","html_id":"08861f66","key":"rFkxiVmwqi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Compare MSE across conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OiI7dTo16D"}],"identifier":"id-6-compare-mse-across-conditions","label":"6. Compare MSE across conditions","html_id":"id-6-compare-mse-across-conditions","implicit":true,"key":"qTWVQ7VGWn"}],"identifier":"c6ff28ec","html_id":"c6ff28ec","key":"wbcUzDeXlV"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-10T15:30:38.480758Z","iopub.status.busy":"2026-11-10T15:30:38.480585Z","iopub.status.idle":"2026-11-10T15:30:38.604758Z","shell.execute_reply":"2026-11-10T15:30:38.603922Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mse_fp = float(jnp.mean((out_fp - target) ** 2))\nmse_unrolled = float(jnp.mean((out_unrolled - target) ** 2))\n\nlabels = [\"Zero init\", \"Warm start\\n(interp)\", \"Fixed-point\\n(K=10)\", \"Unrolled\\n(trained, K=10)\"]\nvalues = [mse_zero_init, mse_warm_init, mse_fp, mse_unrolled]\n\nfig, ax = plt.subplots(figsize=(7, 4))\nbars = ax.bar(labels, values, color=[\"#aec6cf\", \"#77dd77\", \"#fdfd96\", \"#ff9999\"])\nax.set_ylabel(\"MSE\")\nax.set_title(\"Reconstruction MSE: zero init vs warm start vs fixed-point vs unrolled\")\nfor bar, val in zip(bars, values):\n    ax.text(\n        bar.get_x() + bar.get_width() / 2.0,\n        bar.get_height() + 0.002,\n        f\"{val:.4f}\",\n        ha=\"center\",\n        va=\"bottom\",\n        fontsize=9,\n    )\nplt.tight_layout()\nplt.show()\nprint(\"MSE summary:\")\nfor label, val in zip(labels, values):\n    print(f\"  {label.replace(chr(10), ' ')}: {val:.4f}\")","key":"LZqexBMyjx"},{"type":"outputs","id":"drLyzQlyhRbScjnM5AUpn","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"53eea6b1838369fb242a935089a41cda","path":"/vardax/build/53eea6b1838369fb242a935089a41cda.png"},"text/plain":{"content":"<Figure size 700x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"uM0Pn9OBIV"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MSE summary:\n  Zero init: 0.6445\n  Warm start (interp): 0.0654\n  Fixed-point (K=10): 0.6373\n  Unrolled (trained, K=10): 0.5180\n"},"children":[],"key":"hEoiR0G0cE"}],"key":"tfMyNbap4x"}],"identifier":"124f3da1","html_id":"124f3da1","key":"eyJU50Ea9v"}],"key":"Xsf19bfLZv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"01 — Model-Based 4DVar on Lorenz-63","url":"/notebooks/model-based-4dvar-l63","group":"Tutorials"},"next":{"title":"03 — 4DVarNet End-to-End on Lorenz-63","url":"/notebooks/dvarnet-l63","group":"Tutorials"}}},"domain":"http://localhost:3000"}