HQm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Simulate Lorenz-63 and build patches","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VCwwRmvMVk"}],"identifier":"id-1-simulate-lorenz-63-and-build-patches","label":"1. Simulate Lorenz-63 and build patches","html_id":"id-1-simulate-lorenz-63-and-build-patches","implicit":true,"key":"WQ7x7jmUQ8"}],"identifier":"fc6fb062","html_id":"fc6fb062","key":"ms5kDxv3fN"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:38:49.104285Z","iopub.status.busy":"2026-11-06T14:38:49.104027Z","iopub.status.idle":"2026-11-06T14:38:50.139672Z","shell.execute_reply":"2026-11-06T14:38:50.139107Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"key = jax.random.PRNGKey(0)\ntime_coords, states = simulate_lorenz63(\n    key,\n    sigma=10.0,\n    rho=28.0,\n    beta=8.0 / 3.0,\n    dt=0.01,\n    n_steps=5000,\n    n_burn_in=1000,\n)\nprint(f\"states shape: {states.shape}\")\n\nds = trajectory_to_xr_dataset(states, time_coords, feature_names=[\"X\", \"Y\", \"Z\"])\n# Split the trajectory in time *before* cutting windows, so no window\n# straddles the boundary: windows drawn at random from one trajectory and\n# split afterwards would leak test timesteps into the training set.\nn_time = ds.sizes[\"time\"]\nds_train = extract_patches(ds.isel(time=slice(0, int(0.8 * n_time))), n_patches=160, n_timesteps=20, seed=42)\nds_test = extract_patches(ds.isel(time=slice(int(0.8 * n_time), None)), n_patches=40, n_timesteps=20, seed=43)\nds_train = regular_mask(ds_train, variable=\"state\", obs_interval=2)\nds_test = regular_mask(ds_test, variable=\"state\", obs_interval=2)\nds_train = add_gaussian_noise(ds_train, variable=\"state\", sigma=0.5, seed=0, name=\"obs\")\nds_test = add_gaussian_noise(ds_test, variable=\"state\", sigma=0.5, seed=1, name=\"obs\")\nmean, std = compute_scaler_params(ds_train, variable=\"state\", mask_variable=\"mask\")\nds_train = apply_standardization(ds_train, variables=[\"state\", \"obs\"], mean=mean, std=std)\nds_test = apply_standardization(ds_test, variables=[\"state\", \"obs\"], mean=mean, std=std)\n\nbatch_train = xr_to_batch1d(ds_train, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nbatch_test = xr_to_batch1d(ds_test, state_var=\"state\", obs_var=\"obs\", mask_var=\"mask\")\nprint(f\"train batch: {batch_train.input.shape}, test batch: {batch_test.input.shape}\")","key":"CuZeRLqo4p"},{"type":"outputs","id":"a-6Sk6DC_dWGGt7juHGF3","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"states shape: (5001, 3)\ntrain batch: (160, 20, 3), test batch: (40, 20, 3)\n"},"children":[],"key":"IzLgIZz9Xc"}],"key":"Ci2arHJO9B"}],"identifier":"cd003732","html_id":"cd003732","key":"dfFLzcqXpv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Warm-start initialisation via ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dxL1pAqxjo"},{"type":"inlineCode","value":"obs_interpolation_init","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CFgUMDCf3q"}],"identifier":"id-2-warm-start-initialisation-via-obs-interpolation-init","label":"2. Warm-start initialisation via obs_interpolation_init","html_id":"id-2-warm-start-initialisation-via-obs-interpolation-init","implicit":true,"key":"U8jDofhG6a"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Build a NaN-masked obs dataset so we can use ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cqovBOiR5e"},{"type":"inlineCode","value":"obs_interpolation_init","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OPp5IiyP8K"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OxxGsrNIoc"}],"key":"LD7849r92Q"}],"identifier":"e047cb8a","html_id":"e047cb8a","key":"bphBp0tRvS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:38:50.141010Z","iopub.status.busy":"2026-11-06T14:38:50.140850Z","iopub.status.idle":"2026-11-06T14:38:50.245350Z","shell.execute_reply":"2026-11-06T14:38:50.244675Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"state_vals = ds_test[\"state\"].values\nmask_vals = ds_test[\"mask\"].values.astype(bool)\nobs_nan = np.where(mask_vals, ds_test[\"obs\"].values, np.nan).astype(np.float32)\nobs_nan_da = xr.DataArray(obs_nan, dims=ds_test[\"obs\"].dims, coords=ds_test[\"obs\"].coords)\nds_test_nan = ds_test.assign(obs_nan=obs_nan_da)\n\nds_test_init = obs_interpolation_init(\n    ds_test_nan, variable=\"state\", obs_variable=\"obs_nan\"\n)\nx_init = jnp.array(ds_test_init[\"state_init\"].values)\nprint(f\"Warm-start init shape: {x_init.shape}\")\n\n# MSE of warm-start vs zero init\ntarget = batch_test.target\nmse_zero_init = float(jnp.mean((batch_test.input * batch_test.mask - target) ** 2))\nmse_warm_init = float(jnp.mean((x_init - target) ** 2))\nprint(f\"Zero-init MSE: {mse_zero_init:.4f}\")\nprint(f\"Warm-start MSE: {mse_warm_init:.4f}\")","key":"FUOnJtcF1x"},{"type":"outputs","id":"7_aznQr-gXj4dSXqsxljf","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Warm-start init shape: (40, 20, 3)\nZero-init MSE: 0.6445\nWarm-start MSE: 0.0654\n"},"children":[],"key":"e7YNNtzXMy"}],"key":"qudjejwLHL"}],"identifier":"53c39192","html_id":"53c39192","key":"tzmeoNvZNR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Train FourDVarNet1D (unrolled solver)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NvJtO9VwKS"}],"identifier":"id-3-train-fourdvarnet1d-unrolled-solver","label":"3. Train FourDVarNet1D (unrolled solver)","html_id":"id-3-train-fourdvarnet1d-unrolled-solver","implicit":true,"key":"BBRcx09VlS"}],"identifier":"ad8cf678","html_id":"ad8cf678","key":"PJdz3LXVbv"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:38:50.246609Z","iopub.status.busy":"2026-11-06T14:38:50.246466Z","iopub.status.idle":"2026-11-06T14:38:54.524767Z","shell.execute_reply":"2026-11-06T14:38:54.524155Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"B, T, N = batch_train.input.shape\nmodel_unrolled = FourDVarNet1D(\n    state_dim=N,\n    n_time=T,\n    latent_dim=8,\n    hidden_dim=16,\n    n_solver_steps=10,\n    key=jax.random.PRNGKey(1),\n)\n\nmodel, train_losses, _ = vardax.examples.fit_demo(\n    model_unrolled,\n    [batch_train],\n    n_epochs=5,\n    lr=1e-3,\n    verbose=True,\n)\nprint(f\"Final unrolled train loss: {train_losses[-1]:.4f}\")","key":"SZ1MlmYovL"},{"type":"outputs","id":"IIh-_2criLxdaSz3WA63H","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"epoch 1/5 — train loss: 0.562356\nepoch 2/5 — train loss: 0.524042\nepoch 3/5 — train loss: 0.489939\nepoch 4/5 — train loss: 0.459364\nepoch 5/5 — train loss: 0.431853\nFinal unrolled train loss: 0.4319\n"},"children":[],"key":"GrFtekFgr2"}],"key":"VNi8xLKWui"}],"identifier":"0b3a309f","html_id":"0b3a309f","key":"P0mFGgs2xv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Fixed-point solver (untrained prior)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"logUwvjXGC"}],"identifier":"id-4-fixed-point-solver-untrained-prior","label":"4. Fixed-point solver (untrained prior)","html_id":"id-4-fixed-point-solver-untrained-prior","implicit":true,"key":"ORiYJzXPHe"}],"identifier":"654ccb72","html_id":"654ccb72","key":"lU8A4MTYp6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:38:54.526017Z","iopub.status.busy":"2026-11-06T14:38:54.525885Z","iopub.status.idle":"2026-11-06T14:38:54.632650Z","shell.execute_reply":"2026-11-06T14:38:54.631996Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"prior = BilinAEPrior1D(state_dim=N, latent_dim=8, n_time=T, key=jax.random.PRNGKey(3))\n\nout_fp = solve_4dvarnet_1d_fixedpoint(batch_test, prior, n_fp_steps=10)\nprint(f\"Fixed-point output shape: {out_fp.shape}\")","key":"Q3kNlKiWsW"},{"type":"outputs","id":"SMpoFm6CIBjR9FO8Tlb1M","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Fixed-point output shape: (40, 20, 3)\n"},"children":[],"key":"dmRcRgIjpN"}],"key":"u40fELqGwP"}],"identifier":"e1a413b8","html_id":"e1a413b8","key":"BVQP3jxZgT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Evaluate unrolled solver on test batch","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VwABye5vRx"}],"identifier":"id-5-evaluate-unrolled-solver-on-test-batch","label":"5. Evaluate unrolled solver on test batch","html_id":"id-5-evaluate-unrolled-solver-on-test-batch","implicit":true,"key":"YGJXjRJzdw"}],"identifier":"e39c9487","html_id":"e39c9487","key":"mLkpzMDdNB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:38:54.633901Z","iopub.status.busy":"2026-11-06T14:38:54.633723Z","iopub.status.idle":"2026-11-06T14:38:55.997714Z","shell.execute_reply":"2026-11-06T14:38:55.997190Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# `fit_demo` returns a new (trained) Equinox module; `model_unrolled` is the\n# untrained initialisation.\nout_unrolled = model(batch_test)\nprint(f\"Unrolled output shape: {out_unrolled.shape}\")","key":"MtaQwAf802"},{"type":"outputs","id":"IBmAhx1_gH_crYbyLBgQb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Unrolled output shape: (40, 20, 3)\n"},"children":[],"key":"R1xblCxHVo"}],"key":"MLN2e5CTDN"}],"identifier":"ae638244","html_id":"ae638244","key":"apwoC5z30G"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Compare MSE across conditions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZRjQOS32Ng"}],"identifier":"id-6-compare-mse-across-conditions","label":"6. Compare MSE across conditions","html_id":"id-6-compare-mse-across-conditions","implicit":true,"key":"Uj5UsNlftC"}],"identifier":"1ad9522f","html_id":"1ad9522f","key":"u8vJ5qeY2O"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-06T14:38:55.999149Z","iopub.status.busy":"2026-11-06T14:38:55.999004Z","iopub.status.idle":"2026-11-06T14:38:56.103007Z","shell.execute_reply":"2026-11-06T14:38:56.102383Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mse_fp = float(jnp.mean((out_fp - target) ** 2))\nmse_unrolled = float(jnp.mean((out_unrolled - target) ** 2))\n\nlabels = [\"Zero init\", \"Warm start\\n(interp)\", \"Fixed-point\\n(K=10)\", \"Unrolled\\n(trained, K=10)\"]\nvalues = [mse_zero_init, mse_warm_init, mse_fp, mse_unrolled]\n\nfig, ax = plt.subplots(figsize=(7, 4))\nbars = ax.bar(labels, values, color=[\"#aec6cf\", \"#77dd77\", \"#fdfd96\", \"#ff9999\"])\nax.set_ylabel(\"MSE\")\nax.set_title(\"Reconstruction MSE: zero init vs warm start vs fixed-point vs unrolled\")\nfor bar, val in zip(bars, values):\n    ax.text(\n        bar.get_x() + bar.get_width() / 2.0,\n        bar.get_height() + 0.002,\n        f\"{val:.4f}\",\n        ha=\"center\",\n        va=\"bottom\",\n        fontsize=9,\n    )\nplt.tight_layout()\nplt.show()\nprint(\"MSE summary:\")\nfor label, val in zip(labels, values):\n    print(f\"  {label.replace(chr(10), ' ')}: {val:.4f}\")","key":"ayIWkRmDmA"},{"type":"outputs","id":"3OUm2yq90TgGfsOlx87FZ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"53eea6b1838369fb242a935089a41cda","path":"/vardax/build/53eea6b1838369fb242a935089a41cda.png"},"text/plain":{"content":"<Figure size 700x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"DeN9I9GB0S"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MSE summary:\n  Zero init: 0.6445\n  Warm start (interp): 0.0654\n  Fixed-point (K=10): 0.6373\n  Unrolled (trained, K=10): 0.5180\n"},"children":[],"key":"tzROvN6whw"}],"key":"yb8OFaRpie"}],"identifier":"00b56cc1","html_id":"00b56cc1","key":"TEIbUnq7np"}],"key":"tuiAOkbhcB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"01 — Model-Based 4DVar on Lorenz-63","url":"/notebooks/model-based-4dvar-l63","group":"Tutorials"},"next":{"title":"03 — 4DVarNet End-to-End on Lorenz-63","url":"/notebooks/dvarnet-l63","group":"Tutorials"}}},"domain":"http://localhost:3000"}