"mord mathnormal mtight\">ε</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"rfq5hiIJbU"},{"type":"text","value":"-space forms\n(Sherman-Morrison-Woodbury) based on dimensions.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"oISeQ2ttg1"}],"key":"KklH8IqGgG"},{"type":"thematicBreak","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"g1CD3oDP2b"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Variational cost","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"SSbp8SLmof"}],"identifier":"variational-cost","label":"Variational cost","html_id":"variational-cost","implicit":true,"key":"qCjeU9X5J5"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import jax\nimport vardax as vdx\n\n# Shapes: S windows; T times; N state cells\n# Given: state x (S, T, N), batch (y, m), obs_op H, obs_precision Σ_ε⁻¹ op,\n#        background μ_x, prior_precision Σ_x⁻¹ op, ae_prior g_ae\n\n# proposed (D19)\n# 𝒥_o(x) = ½ ‖m ⊙ (y − h(x))‖²_Σ_ε⁻¹\nobs_term = vdx.obs_cost(  # → ()\n    state, batch.input, batch.mask, obs_operator=obs_op, R_inv_op=obs_precision\n)\n\n# today* (vardax)\n# 𝒥_b(x) = ½ ‖x − μ_x‖²_Σ_x⁻¹\nprior_term_classical = vdx.prior_cost(  # → ()\n    state, prior_mean=background, B_inv_op=prior_precision\n)\n\n# today* (vardax)\n# J_prior(x) = ‖x − g_ae(x)‖²\nprior_term_learned = vdx.prior_cost(state, prior_fn=ae_prior)  # → ()\n\n# today* (vardax)\n# 𝒥(x) = α_obs ½ ‖h(x) − y‖²_Σ_ε⁻¹ + α_prior ‖x − g_ae(x)‖²\ntotal_cost = vdx.variational_cost(  # → ()\n    state,\n    batch,\n    prior_fn=ae_prior,\n    obs_operator=obs_op,\n    alpha_obs=1.0,\n    alpha_prior=0.1,\n)\n\n# today* (vardax)\n# ∇ₓ𝒥(x)\ncost_grad = jax.grad(vdx.variational_cost)(  # (S, T, N)\n    state, batch, ae_prior, obs_op, 1.0, 0.1\n)","key":"eRYCk3JWar"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-variational-cost","identifier":"code-design-primitives-variational-cost","html_id":"code-design-primitives-variational-cost","enumerator":"2","children":[{"type":"text","value":"Program ","key":"CQPxFlGq6z"},{"type":"text","value":"2","key":"OsSRurdxWg"},{"type":"text","value":":","key":"gKe22AGrQy"}],"template":"Program %s:","key":"tRRrNKM8V7"},{"type":"text","value":"Evaluates the observation cost ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"wA7WeayYux"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"NL7OTw7LRR"},{"type":"text","value":"2.2","key":"MEEulWXck1"},{"type":"text","value":")","key":"x2tNtJE5Kh"}],"identifier":"eq-obs-cost","label":"eq-obs-cost","kind":"equation","template":"(%s)","enumerator":"2.2","resolved":true,"html_id":"eq-obs-cost","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"q5h2Txi8u7"},{"type":"text","value":", the classical and learned prior terms of ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"FRINLl8TD5"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"NiV2cxrIXQ"},{"type":"text","value":"5.1","key":"KphBVpDWbJ"},{"type":"text","value":")","key":"B2k58yWNZy"}],"identifier":"eq-3dvar-cost","label":"eq-3dvar-cost","kind":"equation","template":"(%s)","enumerator":"5.1","resolved":true,"html_id":"eq-3dvar-cost","remote":true,"url":"/threedvar","dataUrl":"/threedvar.json","key":"N1uyVOLFSk"},{"type":"text","value":" and ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"do9EfTPxAX"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"q2cLgMxjau"},{"type":"text","value":"9.1","key":"Jdfsp3OhhB"},{"type":"text","value":")","key":"ilPFKReJWP"}],"identifier":"eq-4dvarnet-cost","label":"eq-4dvarnet-cost","kind":"equation","template":"(%s)","enumerator":"9.1","resolved":true,"html_id":"eq-4dvarnet-cost","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"bQ3Ks5ZHfu"},{"type":"text","value":", and the gradient of the 4DVarNet cost.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"zuvlg7YeVT"}],"key":"iq89Orit3Q"}],"key":"oFIIAcCMV2"}],"label":"code-design-primitives-variational-cost","identifier":"code-design-primitives-variational-cost","enumerator":"2","html_id":"code-design-primitives-variational-cost","key":"fhSDN2bda9"},{"type":"thematicBreak","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"m98JageaXp"},{"type":"heading","depth":2,"position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Incremental 4DVar inner loop","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"B3jeypg8cD"}],"identifier":"incremental-4dvar-inner-loop","label":"Incremental 4DVar inner loop","html_id":"incremental-4dvar-inner-loop","implicit":true,"key":"OKdiIBlLPo"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import jax\nimport jax.numpy as jnp\nimport vardax as vdx\nfrom jaxtyping import Array, Float\n\n# Shapes: N state cells; M observations\n# Given: background μ_x (N,), batch, forward_model and its step length dt,\n#        obs_op, prior_precision Σ_x⁻¹ op, obs_precision Σ_ε⁻¹ op, plus\n#        initial_state, prior_cov Σ_x, obs_cov Σ_ε and config for the helper\n\n\n# user\ndef step(state: Float[Array, \" N\"]) -> Float[Array, \" N\"]:\n    \"\"\"One model step fₜ(x) of the forward.\"\"\"\n    return forward_model.step(state, dt)\n\n\n# fₜ(μ_x + δx) ≈ fₜ(μ_x) + Fₜ δx\nforward_lin = jax.linearize(step, background)  # (fₜ(μ_x), δx ↦ Fₜ δx)\n# today (vardax)\n# hₜ(z + δz) ≈ hₜ(z) + Hₜ δz\nobs_op_lin = obs_op.linearize(background)  # (N,) → (M, N) op\n# δx⁽⁰⁾ = 0\nincrement_start = jnp.zeros_like(background)  # (N,)\n\n# proposed (D11)\n# 𝐇_GN δx⋆ = −∇𝒥(μ_x), solved with at most 20 CG steps\nincrement = vdx.solver.gauss_newton_inner(  # (N,)\n    dx0=increment_start,\n    x_b=background,\n    batch=batch,\n    forward_lin=forward_lin,\n    obs_op_lin=obs_op_lin,\n    B_inv_op=prior_precision,\n    R_inv_op=obs_precision,\n    n_inner=20,\n    cg_atol=1e-5,\n    cg_rtol=1e-5,\n)\n\n# x⁽ⁱ⁺¹⁾ = x⁽ⁱ⁾ + δx⋆\nbackground = background + increment  # (N,)\n\n# proposed (D11)\n# x⋆ after config.n_outer relinearisations\nanalysis = vdx.solver.incremental_outer(  # (N,)\n    initial_state, batch, forward_model, obs_op, prior_cov, obs_cov, config\n)","key":"owEBbztK0M"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-incremental-inner","identifier":"code-design-primitives-incremental-inner","html_id":"code-design-primitives-incremental-inner","enumerator":"3","children":[{"type":"text","value":"Program ","key":"etlPM9vQpN"},{"type":"text","value":"3","key":"tcoOeKrAYj"},{"type":"text","value":":","key":"iQVbgJhKB0"}],"template":"Program %s:","key":"Rtwjt7tnQW"},{"type":"text","value":"Linearises the model and observation operator ","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"OlflIjm8K2"},{"type":"crossReference","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"(","key":"dfSEbcEUOa"},{"type":"text","value":"8.1","key":"fIhEiG9JXZ"},{"type":"text","value":")","key":"offVZ6UCzm"}],"identifier":"eq-tlm-forward","label":"eq-tlm-forward","kind":"equation","template":"(%