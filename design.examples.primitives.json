{"version":3,"kind":"Article","sha256":"91ba32fa1981b4a229ab8181d77ee0ceb2a92490e574dc59c9927808351af17c","slug":"design.examples.primitives","location":"/design/examples/primitives.md","dependencies":[],"frontmatter":{"title":"Layer 0 — Primitive Examples","content_includes_title":false,"authors":[{"nameParsed":{"literal":"J. Emmanuel Johnson","given":"J. Emmanuel","family":"Johnson"},"name":"J. Emmanuel Johnson","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/jejjohnson/vardax","numbering":{"title":{"offset":2}},"source_url":"https://github.com/jejjohnson/vardax/blob/main/docs/design/examples/primitives.md","edit_url":"https://github.com/jejjohnson/vardax/edit/main/docs/design/examples/primitives.md","exports":[{"format":"md","filename":"primitives.md","url":"/vardax/build/primitives-049417f93bd7e0e2eb1b80b9537ebf7e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Pure JAX cost terms, closed-form BLUE, control-variable transform,\nposterior primitives, adjoint composition.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"cn6ZmQlhh2"}],"key":"lZPt0pAb8h"},{"type":"thematicBreak","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"bM9uZptPVO"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Closed-form BLUE (","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"aTP9PkoAKe"},{"type":"inlineCode","value":"OptimalInterpolation","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"wfjEzPmx0E"},{"type":"text","value":")","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"mOQqxYQBP7"}],"identifier":"closed-form-blue-optimalinterpolation","label":"Closed-form BLUE (OptimalInterpolation)","html_id":"closed-form-blue-optimalinterpolation","implicit":true,"key":"uH5gFC1Xt7"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import gaussx as gx\nimport lineax as lx\nimport vardax as vdx\n\n# Shapes: N state cells; M observations; D = 2 coordinates\n# Given: coords (N, D), obs_variances (M,), background x_b (N,), obs y (M,),\n#        obs_op a linear vardax observation operator\n\n# proposed (gaussx)\n# Bᵢⱼ = k_Matérn-3/2(sᵢ, sⱼ; ℓ = 10, σ = 1)\nprior_cov = gx.MaternLinearOperator(  # (N, D) → (N, N) PSD op\n    coords, length_scale=10.0, nu=1.5, sigma=1.0\n)\n# today (lineax)\n# R = diag(σ²)\nobs_cov = lx.DiagonalLinearOperator(obs_variances)  # (M,) → (M, M) op\n# today (vardax)\n# H = H′(x_b), exact since obs_op is linear\nobs_jacobian = obs_op.linearize(background)  # (N,) → (M, N) op\n\n# proposed (D16)\n# x* = x_b + K (y − H x_b), P* = (I − K H) B\nanalysis, posterior_cov = vdx.costs.blue_analysis(  # (N,), (N, N) op\n    background, obs, prior_cov, obs_cov, obs_jacobian\n)\n# P* stays an AbstractLinearOperator: mat-vecs via lineax.CG, never materialised","key":"A9oMdgM9YA"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-blue","identifier":"code-design-primitives-blue","html_id":"code-design-primitives-blue","enumerator":"1","children":[{"type":"text","value":"Program ","key":"CT8LVWipEM"},{"type":"text","value":"1","key":"e5GyJ88365"},{"type":"text","value":":","key":"B6QT0T9eo2"}],"template":"Program %s:","key":"UctKLeFdFJ"},{"type":"text","value":"Computes the closed-form BLUE analysis ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"vhzHh1aceM"},{"type":"crossReference","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"(","key":"la5KDIuQGG"},{"type":"text","value":"4.4","key":"d8nNKsEdbB"},{"type":"text","value":")","key":"L