position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Eoaqx1F4ll"}],"identifier":"closed-form-blue-optimalinterpolation","label":"Closed-form BLUE (OptimalInterpolation)","html_id":"closed-form-blue-optimalinterpolation","implicit":true,"key":"IYbCv3P1bm"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import gaussx as gx\nimport lineax as lx\nimport vardax as vdx\n\n# Shapes: N state cells; M observations; D = 2 coordinates\n# Given: coords (N, D), obs_variances (M,), background μ_x (N,), obs y (M,),\n#        obs_op a linear vardax observation operator\n\n# proposed (gaussx)\n# (Σ_x)ᵢⱼ = k_Matérn-3/2(sᵢ, sⱼ; ℓ = 10, σ = 1)\nprior_cov = gx.MaternLinearOperator(  # (N, D) → (N, N) PSD op\n    coords, length_scale=10.0, nu=1.5, sigma=1.0\n)\n# today (lineax)\n# Σ_ε = diag(σ²)\nobs_cov = lx.DiagonalLinearOperator(obs_variances)  # (M,) → (M, M) op\n# today (vardax)\n# H = H(μ_x), exact since obs_op is linear\nobs_jacobian = obs_op.linearize(background)  # (N,) → (M, N) op\n\n# proposed (D16)\n# x⋆ = μ_x + G (y − H μ_x), Σ_x|y = (I − G H) Σ_x\nanalysis, posterior_cov = vdx.costs.blue_analysis(  # (N,), (N, N) op\n    background, obs, prior_cov, obs_cov, obs_jacobian\n)\n# Σ_x|y stays an AbstractLinearOperator: mat-vecs via lineax.CG, never materialised","key":"QsRw358kyD"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-blue","identifier":"code-design-primitives-blue","html_id":"code-design-primitives-blue","enumerator":"1","children":[{"type":"text","value":"Program ","key":"NrYYyNHT5A"},{"type":"text","value":"1","key":"TTRlQQhg4F"},{"type":"text","value":":","key":"pDLGcB9UTZ"}],"template":"Program %s:","key":"nar3FnJubT"},{"type":"text","value":"Computes the closed-form BLUE analysis ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"Ef6FK5dkkE"},{"type":"crossReference","position":{"start