/x-tex\">\\Vert \\vect{z} \\Vert^2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.0641em;vertical-align:-0.25em;\"></span><span class=\"mord\">∥</span><span class=\"mord mathbf\">z</span><span class=\"mord\"><span class=\"mord\">∥</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span>","key":"TRd77vpVTU"},{"type":"text","value":", preconditioning CG.","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"OaFObT176c"}],"key":"hiPKolaIYf"},{"type":"thematicBreak","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"key":"J8lCAxfHGX"},{"type":"heading","depth":2,"position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"Adjoint composition (Decision D15)","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"key":"mkIwwhsRbc"}],"identifier":"adjoint-composition-decision-d15","label":"Adjoint composition (Decision D15)","html_id":"adjoint-composition-decision-d15","implicit":true,"key":"nLHcNHACZC"},{"type":"paragraph","position":{"start":{"line":190,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"text","value":"Gradients through ODE integration come from ","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"TgFnaWoEOT"},{"type":"inlineCode","value":"diffrax.AbstractAdjoint","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"es5X16btKb"},{"type":"text","value":";\ngradients through inner minimisation come from\n","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"DLbN9H827C"},{"type":"inlineCode","value":"optimistix.AbstractAdjoint","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"aPNrtHwBlr"},{"type":"text","value":". Vardax exposes both as constructor slots.","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"kX1OFMXXJo"}],"key":"sdO7Ik0keQ"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import diffrax as dfx\nimport optimistix as optx\nimport vardax as vdx\n\n# Shapes: N state cells; T times\n# Given: somax_model (a diffrax-integrated forward), obs_op, background μ_x (N,),\n#        prior_cov Σ_x op, obs_cov Σ_ε op\n\n# today* (vardax; optx.GaussNewton is a least-squares solver, not an\n#   AbstractMinimiser, so the model rejects it: use optx.BFGS or NonlinearCG)\n# memory-efficient operational configuration\n# x₀⋆ = argmin 𝒥(x₀), dx₀⋆/dθ by the implicit function theorem, λ(t) by a backsolve\nmodel = vdx.StrongFourDVar(\n    forward=somax_model,\n    obs_op=obs_op,\n    prior_mean=background,\n    prior_cov_op=prior_cov,\n    obs_cov_op=obs_cov,\n    minimiser=optx.GaussNewton(rtol=1e-5, atol=1e-5),\n    minimiser_adjoint=optx.ImplicitAdjoint(),\n    # continuous adjoint, O(1) memory in T\n    forward_adjoint=dfx.BacksolveAdjoint(),\n)\n\n# today* (vardax)\n# standard configuration: backprop through both, with checkpoints\nmodel = vdx.StrongFourDVar(\n    ...,\n    minimiser_adjoint=optx.RecursiveCheckpointAdjoint(),\n    forward_adjoint=dfx.RecursiveCheckpointAdjoint(),\n)\n\n# today (diffrax)\n# forward sensitivity, good when the parameter count is far below N\nforward_adjoint = dfx.ForwardMode()","key":"xQKdmQV40r"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-adjoint-slots","identifier":"code-design-primitives-adjoint-slots","html_id":"code-design-primitives-adjoint-slots","enumerator":