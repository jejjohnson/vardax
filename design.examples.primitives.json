x) of the forward.\"\"\"\n    return forward_model.step(state, dt)\n\n\n# fₜ(μ_x + δx) ≈ fₜ(μ_x) + Fₜ δx\nforward_lin = jax.linearize(step, background)  # (fₜ(μ_x), δx ↦ Fₜ δx)\n# today (vardax)\n# hₜ(z + δz) ≈ hₜ(z) + Hₜ δz\nobs_op_lin = obs_op.linearize(background)  # (N,) → (M, N) op\n# δx⁽⁰⁾ = 0\nincrement_start = jnp.zeros_like(background)  # (N,)\n\n# proposed (D11)\n# 𝐇_GN δx⋆ = −∇𝒥(μ_x), solved with at most 20 CG steps\nincrement = vdx.solver.gauss_newton_inner(  # (N,)\n    dx0=increment_start,\n    x_b=background,\n    batch=batch,\n    forward_lin=forward_lin,\n    obs_op_lin=obs_op_lin,\n    B_inv_op=prior_precision,\n    R_inv_op=obs_precision,\n    n_inner=20,\n    cg_atol=1e-5,\n    cg_rtol=1e-5,\n)\n\n# x⁽ⁱ⁺¹⁾ = x⁽ⁱ⁾ + δx⋆\nbackground = background + increment  # (N,)\n\n# proposed (D11)\n# x⋆ after config.n_outer relinearisations\nanalysis = vdx.solver.incremental_outer(  # (N,)\n    initial_state, batch, forward_model, obs_op, prior_cov, obs_cov, config\n)","key":"IIB0leRdwu"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-incremental-inner","identifier":"code-design-primitives-incremental-inner","html_id":"code-design-primitives-incremental-inner","enumerator":"3","children":[{"type":"text","value":"Program ","key":"EZH1WY2IoA"},{"type":"text","value":"3","key":"Tlomkfyl6f"},{"type":"text","value":":","key":"BKS3jIcBRK"}],"template":"Program %s:","key":"q07PIvvQCs"},{"type":"text","value":"Linearises the model and observation operator ","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"myimARSx1E"},{"type":"crossReference","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"(","key":"mfAu1GeSdt"},{"type":"text","value":"8.1","key":"ZGdNfwjNN9"},{"type":"text","value":")","key":"zG68ky1RqA"}],"identifier":"eq-tlm-forward","label":"eq-tlm-forward","kind":"equation","template":"