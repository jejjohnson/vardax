tml_id":"eq-incremental-cost","remote":true,"url":"/incremental-4dvar","dataUrl":"/incremental-4dvar.json","key":"qrHgdSklmb"},{"type":"text","value":" with CG.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"tTeRqraxqE"}],"key":"N4J0GU5s1t"}],"key":"zJYBMdOjsI"}],"label":"code-design-primitives-incremental-inner","identifier":"code-design-primitives-incremental-inner","enumerator":"3","html_id":"code-design-primitives-incremental-inner","key":"AxSD4jMqho"},{"type":"thematicBreak","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"key":"DOLY89D0qe"},{"type":"heading","depth":2,"position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"Control-variable transform","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"GPEain2Wl0"}],"identifier":"control-variable-transform","label":"Control-variable transform","html_id":"control-variable-transform","implicit":true,"key":"Jhth7sQimH"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import gaussx as gx\nimport vardax as vdx\n\n# Shapes: N state cells; D = 2 coordinates\n# Given: coords (N, D), state x (N,), background μ_x (N,)\n\n# proposed (gaussx)\n# (Σ_x)ᵢⱼ = k_Matérn-3/2(sᵢ, sⱼ; ℓ = 10, σ = 1)\nprior_cov = gx.MaternLinearOperator(  # (N, D) → (N, N) PSD op\n    grid_coords=coords, length_scale=10.0, nu=1.5, sigma=1.0\n)\n# proposed (gaussx; gaussx ships gx.sqrt(operator))\n# S = L_x\nprior_sqrt = prior_cov.half()  # (N, N) op\n\n# proposed (D11)\n# z = L_x⁻¹ (x − μ_x)\ncontrol = vdx.cvt.cvt_transform(state, background, prior_sqrt)  # (N,) → (N,)\n# proposed (D11)\n# x = μ_x + L_x z\nstate = vdx.cvt.cvt_inverse(control, background, prior_sqrt)  # (N,) → (N,)","key":"BTpLYmw5We"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-cvt","identifier":"code-design-primitives-cvt","html_id":"code-design-primitives-cvt","enumerator":"4","children":[{"type":"text","value":"Program ","key":"jj45FqrWT3"},{"type":"text","value":"4","key":"H1bwiZP3y1"},{"type":"text","value":":","key":"K6byHT3TEO"}],"template":"Program %s:","key":"MF1xWGVJsn"},{"type":"text","value":"Maps a state to control variables and back with the Matérn square root L_x = Σ_x^{1/2} of the control-variable transform ","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"Z4e2E5H8Gt"},{"type":"crossReference","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"(","key":"gDJsMOduUY"},{"type":"text","value":"8.6","key":"AuAsSJvul2"},{"type":"text","value":")","key":"nwj4sWu4zJ"}],"identifier":"eq-cvt","label":"eq-cvt","kind":"equation","template":"(%s)","enumerator":"8.6","resolved":true,"html_id":"eq-cvt","remote":true,"url":"/incremental-4dvar","dataUrl":"/incremental-4dvar.json","key":"ysBHWqANqI"},{"type":"text","value":".","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"Ug5KFo0MSg"}],"key":"ppzAUQTgbz"}],"key":"T2EZtR2acF"}],"label":"code-design-primitives-cvt","identifier":"code-design-primitives-cvt","enumerator":"4","html_id":"code-design-primitives-cvt","key":"MtEYuHNBAx"},{"type":"paragraph","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"In CVT coordinates the prior cost is ","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"jrirfyRrTw"},{"type":"inlineMath","value":"\\Vert \\vect{z} \\Vert^2","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">∥</mi><mi mathvariant=\"bold\">z</mi><msup><mi mathvariant=\"normal\">∥</mi><mn>2</mn></msup></mrow><annotation encoding=\"application/x-tex\">\\Vert \\vect{z} \\Vert^2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.0641em;vertical-align:-0.25em;\"></span><span class=\"mord\">∥</span><span class=\"mord mathbf\">z</span><span class=\"mord\"><span class=\"mord\">∥</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span>","key":"vyLv79X56Y"},{"type":"text","value":", preconditioning CG.","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"y4hxYLgOp7"}],"key":"njA8V7RYlz"},{"type":"thematicBreak","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"key":"UnlfYpLAW2"},{"type":"heading","depth":2,"position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"Adjoint composition (Decision D15)","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"key":"dfD0mDKP2q"}],"identifier":"adjoint-composition-decision-d15","label":"Adjoint composition (Decision D15)","html_id":"adjoint-composition-decision-d15","implicit":true,"key":"rr5Ce7lne8"},{"type":"paragraph","position":{"start":{"line":190,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"text","value":"Gradients through ODE integration come from ","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"rOdcM4pi6O"},{"type":"inlineCode","value":"diffrax.AbstractAdjoint","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"jHZuXcR4Wa"},{"type":"text","value":";\ngradients through inner minimisation come from\n","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"FQgLc58I7H"},{"type":"inlineCode","value":"optimistix.AbstractAdjoint","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"SGE9qKWb4E"},{"type":"text","value":". Vardax exposes both as constructor slots.","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"G2A6FQp0Ev"}],"key":"UClikNzMnE"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import diffrax as dfx\nimport optimistix as optx\nimport vardax as vdx\n\n# Shapes: N state cells; T times\n# Given: somax_model (a diffrax-integrated forward), obs_op, background μ_x (N,),\n#        prior_cov Σ_x op, obs_cov Σ_ε op\n\n# today* (vardax; optx.GaussNewton is a least-squares solver, not an\n#   AbstractMinimiser, so the model rejects it: use optx.BFGS or NonlinearCG)\n# memory-efficient operational configuration\n# x₀⋆ = argmin 𝒥(x₀), dx₀⋆/dθ by the implicit function theorem, λ(t) by a backsolve\nmodel = vdx.StrongFourDVar(\n    forward=somax_model,\n    obs_op=obs_op,\n    prior_mean=background,\n    prior_cov_op=prior_cov,\n    obs_cov_op=obs_cov,\n    minimiser=optx.GaussNewton(rtol=1e-5, atol=1e-5),\n    minimiser_adjoint=optx.ImplicitAdjoint(),\n    # continuous adjoint, O(1) memory in T\n    forward_adjoint=dfx.BacksolveAdjoint(),\n)\n\n# today* (vardax)\n# standard configuration: backprop through both, with checkpoints\nmodel = vdx.StrongFourDVar(\n    ...,\n    minimiser_adjoint=optx.RecursiveCheckpointAdjoint(),\n    forward_adjoint=dfx.RecursiveCheckpointAdjoint(),\n)\n\n# today (diffrax)\n# forward sensitivity, good when the parameter count is far below N\nforward_adjoint = dfx.ForwardMode()","key":"HSVDDGlU2O"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-adjoint-slots","identifier":"code-design-primitives-adjoint-slots","html_id":"code-design-primitives-adjoint-slots","enumerator":"5","children":[{"type":"text","value":"Program ","key":"pxiaq5sto2"},{"type":"text","value":"5","key":"Y01qOxfBZK"},{"type":"text","value":":","key":"okTLnbhHcm"}],"template":"Program %s:","key":"afT7rUXt4C"},{"type":"text","value":"Configures StrongFourDVar for the cost ","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"VNRmz7rlf4"},{"type":"crossReference","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"(","key":"Q9vefUQRfJ"},{"type":"text","value":"6.1","key":"rgCCFu9hav"},{"type":"text","value":")","key":"JnBPTps7IZ"}],"identifier":"eq-strong4dvar-cost","label":"eq-strong4dvar-cost","kind":"equation","template":"(%s)","enumerator":"6.1","resolved":true,"html_id":"eq-strong4dvar-cost","remote":true,"url":"/strong-4dvar","dataUrl":"/strong-4dvar.json","key":"u05AcaztuL"},{"type":"text","value":" with an implicit minimiser adjoint ","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"b36yYDdKal"},{"type":"crossReference","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"(","key":"TRz1DzX1EK"},{"type":"text","value":"12.2","key":"p0c6cxwgkJ"},{"type":"text","value":")","key":"CUJDvxm2Xu"}],"identifier":"eq-implicit-grad","label":"eq-implicit-grad","kind":"equation","template":"(%s)","enumerator":"12.2","resolved":true,"html_id":"eq-implicit-grad","remote":true,"url":"/adjoint-methods","dataUrl":"/adjoint-methods.json","key":"OankKgwVcO"},{"type":"text","value":" and a continuous dynamics adjoint ","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"VhHNu4V6xH"},{"type":"crossReference","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"(","key":"KkoUGvZ8ks"},{"type":"text","value":"12.1","key":"TGBJ3RKnh6"},{"type":"text","value":")","key":"OsIaxGKQbc"}],"identifier":"eq-adjoint-ode","label":"eq-adjoint-ode","kind":"equation","template":"(%s)","enumerator":"12.1","resolved":true,"html_id":"eq-adjoint-ode","remote":true,"url":"/adjoint-methods","dataUrl":"/adjoint-methods.json","key":"FU406M8nZ3"},{"type":"text","value":", or with checkpointed backprop.","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"OMsI2O9WnY"}],"key":"F7KE70xFGw"}],"key":"YLWZR09ljO"}],"label":"code-design-primitives-adjoint-slots","identifier":"code-design-primitives-adjoint-slots","enumerator":"5","html_id":"code-design-primitives-adjoint-slots","key":"aKaR7y7KyC"},{"type":"paragraph","position":{"start":{"line":234,"column":1},"end":{"line":235,"column":1}},"children":[{"type":"text","value":"For ","position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"key":"Skubx9aXpz"},{"type":"inlineCode","value":"FourDVarNet","position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"key":"u6tN9mGbgo"},{"type":"text","value":", the inner-solver adjoint controls how training\ngradients flow through the unrolled learned iteration:","position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"key":"giwCdCqoGL"}],"key":"AHiBQMsWRD"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import optimistix as optx\nimport vardax as vdx\n\n# Shapes: K = 15 inner steps\n# Given: ae_prior g_ae, obs_op H, conv_lstm g_mod\n\n# Three adjoint options for FourDVarNet's inner solver:\n# today (optimistix)\n# O(K) memory, standard backprop through x₁ … x_K\nsolver_adjoint = optx.RecursiveCheckpointAdjoint()\n# today (vardax)\n# O(1) memory, last step only (Bolte et al. 2023)\nsolver_adjoint = vdx.adjoints.OneStepAdjoint()\n# today (optimistix)\n# O(1) memory, dx⋆/dθ = (I − ∂f/∂x)⁻¹ ∂f/∂θ, exact at a fixed point\nsolver_adjoint = optx.ImplicitAdjoint()\n\n# proposed (D14; ships today as vdx.FourDVarNet1D / vdx.FourDVarNet2D)\n# x⁽ⁱ⁺¹⁾ = x⁽ⁱ⁾ − g_mod(∇ₓ𝒥(x⁽ⁱ⁾), c⁽ⁱ⁾), i = 0 … N_iter − 1\nmodel = vdx.FourDVarNet(\n    prior=ae_prior,\n    obs_op=obs_op,\n    grad_mod=conv_lstm,\n    # proposed (D4)\n    config=vdx.SolverConfig(n_steps=15),\n    solver_adjoint=solver_adjoint,\n)","key":"Pyox6CwpaR"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-fourdvarnet-adjoint","identifier":"code-design-primitives-fourdvarnet-adjoint","html_id":"code-design-primitives-fourdvarnet-adjoint","enumerator":"6","children":[{"type":"text","value":"Program ","key":"A2y2zwdz8A"},{"type":"text","value":"6","key":"scTnuMzECl"},{"type":"text","value":":","key":"z7uIZ5AXiP"}],"template":"Program %s:","key":"KmXckGZOAC"},{"type":"text","value":"Chooses how training gradients flow back through the unrolled 4DVarNet update ","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"C7kcyOPrLM"},{"type":"crossReference","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"(","key":"crIjWH73fy"},{"type":"text","value":"9.2","key":"wBFlZdscUh"},{"type":"text","value":")","key":"fwo6u3WI31"}],"identifier":"eq-4dvarnet-update","label":"eq-4dvarnet-update","kind":"equation","template":"(%s)","enumerator":"9.2","resolved":true,"html_id":"eq-4dvarnet-update","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"RWfPYRs9kj"},{"type":"text","value":": full backprop, last step only, or the fixed-point gradient ","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"rhAK08LNiE"},{"type":"crossReference","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"(","key":"dG67KBhRcH"},{"type":"text","value":"9.4","key":"Duh7Un0yTL"},{"type":"text","value":")","key":"f8VsBkat0X"}],"identifier":"eq-fixed-point-grad","label":"eq-fixed-point-grad","kind":"equation","template":"(%s)","enumerator":"9.4","resolved":true,"html_id":"eq-fixed-point-grad","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"HuUwJf0OKY"},{"type":"text","value":".","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"sk5RXGJjnj"}],"key":"w2mOa9qkld"}],"key":"kTiW1K0AUo"}],"label":"code-design-primitives-fourdvarnet-adjoint","identifier":"code-design-primitives-fourdvarnet-adjoint","enumerator":"6","html_id":"code-design-primitives-fourdvarnet-adjoint","key":"G0stA3AmwA"},{"type":"thematicBreak","position":{"start":{"line":269,"column":1},"end":{"line":269,"column":1}},"key":"VjtqNTq1HO"},{"type":"heading","depth":2,"position":{"start":{"line":271,"column":1},"end":{"line":271,"column":1}},"children":[{"type":"text","value":"Laplace posterior covariance","position":{"start":{"line":271,"column":1},"end":{"line":271,"column":1}},"key":"zVilUdHcj3"}],"identifier":"laplace-posterior-covariance","label":"Laplace posterior covariance","html_id":"laplace-posterior-covariance","implicit":true,"key":"ILql7trFxq"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import jax\nimport vardax as vdx\n\n# Shapes: N state cells\n# Given: analysis x⋆ (N,), threedvar_cost 𝒥, batch, forward_model, obs_op,\n#        prior_precision Σ_x⁻¹ op, obs_precision Σ_ε⁻¹ op, prior_cov Σ_x op, obs_cov Σ_ε op\n\n# ∇𝒥\ncost_grad_fn = jax.grad(threedvar_cost)\n\n# proposed (D10; ships today as the vdx.LaplaceCovariance adapter)\n# Laplace at MAP, for ThreeDVar / StrongFourDVar / WeakFourDVar / FourDVarNet\n# Σ_x|y,Laplace = (∇²𝒥(x⋆))⁻¹ ≈ (Σ_x⁻¹ + Hᵀ Σ_ε⁻¹ H)⁻¹\nposterior_cov = vdx.posterior.laplace_covariance(  # (N, N) op\n    analysis,\n    cost_grad_fn=cost_grad_fn,\n    B_inv_op=prior_precision,\n    R_inv_op=obs_precision,\n)\n\n# proposed (D10; ships today as the vdx.GaussNewtonHessian adapter)\n# reused inside IncrementalFourDVar.posterior(batch)\n# Σ_x|y,GN = 𝐇_GN⁻¹, from 50 Lanczos vectors\ngn_posterior_cov = vdx.posterior.gauss_newton_hessian(  # (N, N) op\n    analysis, batch, forward_model, obs_op, prior_cov, obs_cov, n_krylov=50\n)","key":"aCiqMV4g1y"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-laplace","identifier":"code-design-primitives-laplace","html_id":"code-design-primitives-laplace","enumerator":"7","children":[{"type":"text","value":"Program ","key":"mW9o6gRhz6"},{"type":"text","value":"7","key":"iCz2WygmI5"},{"type":"text","value":":","key":"V8FmvbiHkl"}],"template":"Program %s:","key":"uI0uHKvBkE"},{"type":"text","value":"Builds the Laplace covariance ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"GE39DoksGj"},{"type":"crossReference","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"children":[{"type":"text","value":"(","key":"QbegL0HaUH"},{"type":"text","value":"13.1","key":"uw3yzAbCvI"},{"type":"text","value":")","key":"pJkHdNKHCF"}],"identifier":"eq-laplace-cov","label":"eq-laplace-cov","kind":"equation","template":"(%s)","enumerator":"13.1","resolved":true,"html_id":"eq-laplace-cov","remote":true,"url":"/posterior-covariance","dataUrl":"/posterior-covariance.json","key":"WfDaeR601P"},{"type":"text","value":" at the MAP and the inverse Gauss-Newton Hessian ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"pgrvIiI4aW"},{"type":"crossReference","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"children":[{"type":"text","value":"(","key":"wrInUKMWk6"},{"type":"text","value":"13.2","key":"bEu2vyj9k0"},{"type":"text","value":")","key":"PiiKKxPFEn"}],"identifier":"eq-gn-cov","label":"eq-gn-cov","kind":"equation","template":"(%s)","enumerator":"13.2","resolved":true,"html_id":"eq-gn-cov","remote":true,"url":"/posterior-covariance","dataUrl":"/posterior-covariance.json","key":"Mcrjw9T6Oj"},{"type":"text","value":" of ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"JsYPc1dRnL"},{"type":"crossR