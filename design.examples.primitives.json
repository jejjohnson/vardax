cost(  # → ()\n    state, prior_mean=background, B_inv_op=prior_precision\n)\n\n# today* (vardax)\n# J_prior(x) = ‖x − φ(x)‖²\nprior_term_learned = vdx.prior_cost(state, prior_fn=ae_prior)  # → ()\n\n# today* (vardax)\n# J(x) = α_obs ½ ‖H(x) − y‖²_{R⁻¹} + α_prior ‖x − φ(x)‖²\ntotal_cost = vdx.variational_cost(  # → ()\n    state,\n    batch,\n    prior_fn=ae_prior,\n    obs_operator=obs_op,\n    alpha_obs=1.0,\n    alpha_prior=0.1,\n)\n\n# today* (vardax)\n# ∇ₓJ(x)\ncost_grad = jax.grad(vdx.variational_cost)(  # (S, T, N)\n    state, batch, ae_prior, obs_op, 1.0, 0.1\n)","key":"cHg1Vonk7l"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-variational-cost","identifier":"code-design-primitives-variational-cost","html_id":"code-design-primitives-variational-cost","enumerator":"2","children":[{"type":"text","value":"Program ","key":"TOKmnS43kd"},{"type":"text","value":"2","key":"zGcc4j3Vdx"},{"type":"text","value":":","key":"fC37yF9ves"}],"template":"Program %s:","key":"oeYCSBhNRD"},{"type":"text","value":"Evaluates the observation cost ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"kGLhCGSj9x"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"Xz0ORboMOc"},{"type":"text","value":"2.2","key":"TzupL7nbCw"},{"type":"text","value":")","key":"VUzcAnl8tZ"}],"identifier":"eq-obs-cost","label":"eq-obs-cost","kind":"equation","template":"(%s)","enumerator":"2.2","resolved":true,"html_id":"eq-obs-cost","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"ylP6LEbX5S"},{"type":"text","value":", the classical and learned prior terms of ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"wO1Zca2qVG"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"d2U8zXfajQ"},{"type":"text","value":"5.1","key":"bHljH1hqHP"},{"type":"text","value":")","key":"PgNJthkxlc"}],"identifier":"eq-3dvar-cost","label":"eq-3dvar-cost","kind":"equation","template":"(%s)","enumerator":"5.1","resolved":true,"html_id":"eq-3dvar-cost","remote":true,"url":"/threedvar","dataUrl":"/threedvar.json","key":"nrUiOs87L6"},{"type":"text","value":" and ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"OoRStvZqbi"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"yO4BFtjEap"},{"type":"text","value":"9.1","key":"gwURtCjmkA"},{"type":"text","value":")","key":"LutAbvwhyF"}],"identifier":"eq-4dvarnet-cost","label":"eq-4dvarnet-cost","kind":"equation","template":"(%s)","enumerator":"9.1","resolved":true,"html_id":"eq-4dvarnet-cost","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"ApQdlKFzjO"},{"type":"text","value":", and the gradient of the 4DVarNet cost.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"SC90CEJ9sx"}],"key":"rRdG59N9JM"}],"key":"efvpo64HT6"}],"label":"code-design-primitives-variational-cost","identifier":"code-design-primitives-variational-cost","enumerator":"2","html_id":"code-design-primitives-variational-cost","key":"A450l9gS0S"},{"type":"thematicBreak","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"lDtW8TPPo6"},{"type":"heading","depth":2,"position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Incremental 4DVar inner loop","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"Du8uBkDwqy"}],"identifier":"incremental-4dvar-inner-loop","label":"Incremental 4DVar inner loop","html_id":"incremental-4dvar-inner-loop","implicit":true,"key":"fQSkr9Bitm"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import jax\nimport jax.numpy as jnp\nimport vardax as vdx\nfrom jaxtyping import Array, Float\n\n# Shapes: N state cells; M observations\n# Given: background x_b (N,), batch, forward_model and its step length dt,\n#        obs_op, prior_precision B⁻¹ op, obs_precision R⁻¹ op, plus\n#        initial_state, prior_cov B, obs_cov R and config for the helper\n\n\n# user\ndef step(state: Float[Array, \" N\"]) -> Float[Array, \" N\"]:\n    \"\"\"One model step Mₜ(x) of the forward.\"\"\"\n    return forward_model.step(state, dt)\n\n\n# Mₜ(x_b + δx) ≈ Mₜ(x_b) + M′ₜ δx\nforward_lin = jax.linearize(step, background)  # (Mₜ(x_b), δx ↦ M′ₜ δx)\n# today (vardax)\n# Hₜ(z + δz) ≈ Hₜ(z) + H′ₜ δz\nobs_op_lin = obs_op.linearize(background)  # (N,) → (M, N) op\n# δx⁽⁰⁾ = 0\nincrement_start = jnp.zeros_like(background)  # (N,)\n\n# proposed (D11)\n# 𝐇_GN δx* = −∇J(x_b), solved with at most 20 CG steps\nincrement = vdx.solver.gauss_newton_inner(  # (N,)\n    dx0=increment_start,\n    x_b=background,\n    batch=batch,\n    forward_lin=forward_lin,\n    obs_op_lin=obs_op_lin,\n    B_inv_op=prior_precision,\n    R_inv_op=obs_precision,\n    n_inner=20,\n    cg_atol=1e-5,\n    cg_rtol=1e-5,\n)\n\n# x⁽ᵏ⁺¹⁾ = x⁽ᵏ⁾ + δx*\nbackground = background + increment  # (N,)\n\n# proposed (D11)\n# x* after config.n_outer relinearisations\nanalysis = vdx.solver.incremental_outer(  # (N,)\n    initial_state, batch, forward_model, obs_op, prior_cov, obs_cov, config\n)","key":"nfy8i69rXR"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-incremental-inner","identifier":"code-design-primitives-incremental-inner","html_id":"code-design-primitives-incremental-inner","enumerator":"3","children":[{"type":"text","value":"Program ","key":"ruUOSmNMQp"},{"type":"text","value":"3","key":"rJ5SS8avMG"},{"type":"text","value":":","key":"p4Yk3CFg6y"}],"template":"Program %s:","key":"nXwM3VQKEd"},{"type":"text","value":"Linearises the m