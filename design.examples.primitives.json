"line":102,"column":1},"end":{"line":102,"column":1}},"key":"nXNquYv4DO"},{"type":"crossReference","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"(","key":"L9ZL8O6m1Z"},{"type":"text","value":"8.3","key":"JSkO6FULfc"},{"type":"text","value":")","key":"olwiov3yJe"}],"identifier":"eq-incremental-cost","label":"eq-incremental-cost","kind":"equation","template":"(%s)","enumerator":"8.3","resolved":true,"html_id":"eq-incremental-cost","remote":true,"url":"/incremental-4dvar","dataUrl":"/incremental-4dvar.json","key":"TRuaQQbRO0"},{"type":"text","value":" with CG.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"NiUaHAE8tF"}],"key":"j14ilVHcMJ"}],"key":"VxI08MMYBw"}],"label":"code-design-primitives-incremental-inner","identifier":"code-design-primitives-incremental-inner","enumerator":"3","html_id":"code-design-primitives-incremental-inner","key":"cRVscJ9GPY"},{"type":"thematicBreak","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"key":"MkgiG1jGCI"},{"type":"heading","depth":2,"position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"Control-variable transform","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"J85OOUiGSF"}],"identifier":"control-variable-transform","label":"Control-variable transform","html_id":"control-variable-transform","implicit":true,"key":"vAv71FDITR"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import gaussx as gx\nimport vardax as vdx\n\n# Shapes: N state cells; D = 2 coordinates\n# Given: coords (N, D), state x (N,), background x_b (N,)\n\n# proposed (gaussx)\n# Bᵢⱼ = k_Matérn-3/2(sᵢ, sⱼ; ℓ = 10, σ = 1)\nprior_cov = gx.MaternLinearOperator(  # (N, D) → (N, N) PSD op\n    grid_coords=coords, length_scale=10.0, nu=1.5, sigma=1.0\n)\n# proposed (gaussx; gaussx ships gx.sqrt(operator))\n# S = B^{1/2}\nprior_sqrt = prior_cov.half()  # (N, N) op\n\n# proposed (D11)\n# χ = B^{−1/2} (x − x_b)\ncontrol = vdx.cvt.cvt_transform(state, background, prior_sqrt)  # (N,) → (N,)\n# proposed (D11)\n# x = x_b + B^{1/2} χ\nstate = vdx.cvt.cvt_inverse(control, background, prior_sqrt)  # (N,) → (N,)","key":"dFNx8ZLrcC"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-cvt","identifier":"code-design-primitives-cvt","html_id":"code-design-primitives-cvt","enumerator":"4","children":[{"type":"text","value":"Program ","key":"y06aHzHgus"},{"type":"text","value":"4","key":"D1mpu4Fj8I"},{"type":"text","value":":","key":"lWcAw0ozYW"}],"template":"Program %s:","key":"G3NbDCPia7"},{"type":"text","value":"Maps a state to control variables and back with the Matérn square root S = B^{1/2} of the control-variable transform ","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"jyVYiua9yT"},{"type":"crossReference","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"(","key":"ShwgKUKQbL"},{"type":"text","value":"8.6","key":"HXCfSOwRGY"},{"type":"text","value":")","key":"WF2J2szVES"}],"identifier":"eq-cvt","label":"eq-cvt","kind":"equation","template":"(%s)","enumerator":"8.6","resolved":true,"html_id":"eq-cvt","remote":true,"url":"/incremental-4dvar","dataUrl":"/incremental-4dvar.json","key":"YguGwepTjk"},{"type":"text","value":".","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"Fc5A9sN8Re"}],"key":"hZZxU7MvgO"}],"key":"arCM0gz82v"}],"label":"code-design-primitives-cvt","identifier":"code-design-primitives-cvt","enumerator":"4","html_id":"code-design-primitives-cvt","key":"YfLe1ykLYw"},{"type":"paragraph","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"In CVT coordinates the prior cost is ","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"uQ6PiHETyF"},{"type":"inlineMath","value":"\\|\\chi\\|^2","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">∥</mi><mi>χ</mi><msup><mi mathvariant=\"normal\">∥</mi><mn>2</mn></msup></mrow><annotation encoding=\"application/x-tex\">\\|\\chi\\|^2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.0641em;vertical-align:-0.25em;\"></span><span class=\"mord\">∥</span><span class=\"mord mathnormal\">χ</span><span class=\"mord\"><span class=\"mord\">∥</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span>","key":"kQTubAYm10"},{"type":"text","value":", preconditioning CG.","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"YOZTuZDRNN"}],"key":"Oj4pfj6KdC"},{"type":"thematicBreak","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"key":"eIS1OShuWA"},{"type":"heading","depth":2,"position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"Adjoint composition (Decision D15)","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"key":"WLwibRUL2I"}],"identifier":"adjoint-composition-decision-d15","label":"Adjoint composition (Decision D15)","html_id":"adjoint-composition-decision-d15","implicit":true,"key":"K3VV0jjzLB"},{"type":"paragraph","position":{"start":{"line":190,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"text","value":"Gradients through ODE integration come from ","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"fdZorMepan"},{"type":"inlineCode","value":"diffrax.AbstractAdjoint","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"CjgTvrUaeU"},{"type":"text","value":";\ngradients through inner minimisation come from\n","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"AfGQOz5tAN"},{"type":"inlineCode","value":"optimistix.AbstractAdjoint","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"T73naQ5Fxe"},{"type":"text","value":". Vardax exposes both as constructor slots.","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"FSfJ8BRasy"}],"key":"DKRMsFFHo9"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import diffrax as dfx\nimport optimistix as optx\nimport vardax as vdx\n\n# Shapes: N state cells; T times\n# Given: somax_model (a diffrax-integrated forward), obs_op, background x_b (N,),\n#        prior_cov B op, obs_cov R op\n\n# today* (vardax; optx.GaussNewton is a least-squares solver, not an\n#   AbstractMinimiser, so the model rejects it: use optx.BFGS or NonlinearCG)\n# memory-efficient operational configuration\n# x₀* = argmin J(x₀), dx₀*/dθ by the implicit function theorem, λ(t) by a backsolve\nmodel = vdx.StrongFourDVar(\n    forward=somax_model,\n    obs_op=obs_op,\n    prior_mean=background,\n    prior_cov_op=prior_cov,\n    obs_cov_op=obs_cov,\n    minimiser=optx.GaussNewton(rtol=1e-5, atol=1e-5),\n    minimiser_adjoint=optx.ImplicitAdjoint(),\n    # continuous adjoint, O(1) memory in T\n    forward_adjoint=dfx.BacksolveAdjoint(),\n)\n\n# today* (vardax)\n# standard configuration: backprop through both, with checkpoints\nmodel = vdx.StrongFourDVar(\n    ...,\n    minimiser_adjoint=optx.RecursiveCheckpointAdjoint(),\n    forward_adjoint=dfx.RecursiveCheckpointAdjoint(),\n)\n\n# today (diffrax)\n# forward sensitivity, good when the parameter count is far below N\nforward_adjoint = dfx.ForwardMode()","key":"oVIE6NmCTt"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-adjoint-slots","identifier":"code-design-primitives-adjoint-slots","html_id":"code-design-primitives-adjoint-slots","enumerator":"5","children":[{"type":"text","value":"Program ","key":"kjbYW5Lyxz"},{"type":"text","value":"5","key":"S4fZhVDo0T"},{"type":"text","value":":","key":"ZQftB4LQCH"}],"template":"Program %s:","key":"p2W0kVoKKR"},{"type":"text","value":"Configures StrongFourDVar for the cost ","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"yxkndZG4kY"},{"type":"crossReference","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"(","key":"Tde2xFJzVc"},{"type":"text","value":"6.1","key":"H3olmGcd0l"},{"type":"text","value":")","key":"zEo3jawZe7"}],"identifier":"eq-strong4dvar-cost","label":"eq-strong4dvar-cost","kind":"equation","template":"(%s)","enumerator":"6.1","resolved":true,"html_id":"eq-strong4dvar-cost","remote":true,"url":"/strong-4dvar","dataUrl":"/strong-4dvar.json","key":"EA3CY0YU4g"},{"type":"text","value":" with an implicit minimiser adjoint ","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"JUvGayomv9"},{"type":"crossReference","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"(","key":"lhinu0eDBY"},{"type":"text","value":"12.2","key":"gHUVouZ0BX"},{"type":"text","value":")","key":"pKMMFzMRAN"}],"identifier":"eq-implicit-grad","label":"eq-implicit-grad","kind":"equation","template":"(%s)","enumerator":"12.2","resolved":true,"html_id":"eq-implicit-grad","remote":true,"url":"/adjoint-methods","dataUrl":"/adjoint-methods.json","key":"eaeXB6GHam"},{"type":"text","value":" and a continuous dynamics adjoint ","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"gU2Jwrxn2A"},{"type":"crossReference","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"text","value":"(","key":"dSbhTqd49g"},{"type":"text","value":"12.1","key":"wlp6CThuU7"},{"type":"text","value":")","key":"Y547q5KBMd"}],"identifier":"eq-adjoint-ode","label":"eq-adjoint-ode","kind":"equation","template":"(%s)","enumerator":"12.1","resolved":true,"html_id":"eq-adjoint-ode","remote":true,"url":"/adjoint-methods","dataUrl":"/adjoint-methods.json","key":"OT9RmiqVhZ"},{"type":"text","value":", or with checkpointed backprop.","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"key":"xcwEXPGd4R"}],"key":"R8JqQ8lZoQ"}],"key":"NeiUlZ8E94"}],"label":"code-design-primitives-adjoint-slots","identifier":"code-design-primitives-adjoint-slots","enumerator":"5","html_id":"code-design-primitives-adjoint-slots","key":"kqFTAlkUMZ"},{"type":"paragraph","position":{"start":{"line":234,"column":1},"end":{"line":235,"column":1}},"children":[{"type":"text","value":"For ","position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"key":"skk578xQgZ"},{"type":"inlineCode","value":"FourDVarNet","position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"key":"dwJxzh73UH"},{"type":"text","value":", the inner-solver adjoint controls how training\ngradients flow through the unrolled learned iteration:","position":{"start":{"line":234,"column":1},"end":{"line":234,"column":1}},"key":"BUOAQxQEg0"}],"key":"gHbOGXcBRq"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import optimistix as optx\nimport vardax as vdx\n\n# Shapes: K = 15 inner steps\n# Given: ae_prior φ, obs_op H, conv_lstm Φ\n\n# Three adjoint options for FourDVarNet's inner solver:\n# today (optimistix)\n# O(K) memory, standard backprop through x₁ … x_K\nsolver_adjoint = optx.RecursiveCheckpointAdjoint()\n# today (vardax)\n# O(1) memory, last step only (Bolte et al. 2023)\nsolver_adjoint = vdx.adjoints.OneStepAdjoint()\n# today (optimistix)\n# O(1) memory, dx*/dθ = (I − ∂f/∂x)⁻¹ ∂f/∂θ, exact at a fixed point\nsolver_adjoint = optx.ImplicitAdjoint()\n\n# proposed (D14; ships today as vdx.FourDVarNet1D / vdx.FourDVarNet2D)\n# x_{k+1} = x_k − Φ(∇ₓJ(x_k), h_k), k = 0 … K − 1\nmodel = vdx.FourDVarNet(\n    prior=ae_prior,\n    obs_op=obs_op,\n    grad_mod=conv_lstm,\n    # proposed (D4)\n    config=vdx.SolverConfig(n_steps=15),\n    solver_adjoint=solver_adjoint,\n)","key":"qP5aqVdeDy"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-fourdvarnet-adjoint","identifier":"code-design-primitives-fourdvarnet-adjoint","html_id":"code-design-primitives-fourdvarnet-adjoint","enumerator":"6","children":[{"type":"text","value":"Program ","key":"c2TzUG0KT4"},{"type":"text","value":"6","key":"vpFLLONoja"},{"type":"text","value":":","key":"D3QBxQTq1f"}],"template":"Program %s:","key":"G5q7q0CHLD"},{"type":"text","value":"Chooses how training gradients flow back through the unrolled 4DVarNet update ","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"rubCicBR94"},{"type":"crossReference","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"(","key":"dm9T0McPA7"},{"type":"text","value":"9.2","key":"ZlTUTpAN6I"},{"type":"text","value":")","key":"iWV1wTBLUo"}],"identifier":"eq-4dvarnet-update","label":"eq-4dvarnet-update","kind":"equation","template":"(%s)","enumerator":"9.2","resolved":true,"html_id":"eq-4dvarnet-update","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"N9hIVuSbNF"},{"type":"text","value":": full backprop, last step only, or the fixed-point gradient ","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"KbSPBBCcMw"},{"type":"crossReference","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"(","key":"pBsZB9v9FY"},{"type":"text","value":"9.4","key":"G5yB0UaeaS"},{"type":"text","value":")","key":"K7QtgZ4VXj"}],"identifier":"eq-fixed-point-grad","label":"eq-fixed-point-grad","kind":"equation","template":"(%s)","enumerator":"9.4","resolved":true,"html_id":"eq-fixed-point-grad","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"aBMyV35XT9"},{"type":"text","value":".","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"fupwADuWD3"}],"key":"m9CbWzpDgQ"}],"key":"EWgCvjuPzW"}],"label":"code-design-primitives-fourdvarnet-adjoint","identifier":"code-design-primitives-fourdvarnet-adjoint","enumerator":"6","html_id":"code-design-primitives-fourdvarnet-adjoint","key":"eP8tdGSNV7"},{"type":"thematicBreak","position":{"start":{"line":269,"column":1},"end":{"line":269,"column":1}},"key":"Bd6Q2Fo1xX"},{"type":"heading","depth":2,"position":{"start":{"line":271,"column":1},"end":{"line":271,"column":1}},"children":[{"type":"text","value":"Laplace posterior covariance","position":{"start":{"line":271,"column":1},"end":{"line":271,"column":1}},"key":"AF0KwlZS3Z"}],"identifier":"laplace-posterior-covariance","label":"Laplace posterior covariance","html_id":"laplace-posterior-covariance","implicit":true,"key":"ruvBn1B0g0"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import jax\nimport vardax as vdx\n\n# Shapes: N state cells\n# Given: analysis x* (N,), threedvar_cost J, batch, forward_model, obs_op,\n#        prior_precision B⁻¹ op, obs_precision R⁻¹ op, prior_cov B op, obs_cov R op\n\n# ∇J\ncost_grad_fn = jax.grad(threedvar_cost)\n\n# proposed (D10; ships today as the vdx.LaplaceCovariance adapter)\n# Laplace at MAP, for ThreeDVar / StrongFourDVar / WeakFourDVar / FourDVarNet\n# P*_Laplace = (∇²J(x*))⁻¹ ≈ (B⁻¹ + H′ᵀ R⁻¹ H′)⁻¹\nposterior_cov = vdx.posterior.laplace_covariance(  # (N, N) op\n    analysis,\n    cost_grad_fn=cost_grad_fn,\n    B_inv_op=prior_precision,\n    R_inv_op=obs_precision,\n)\n\n# proposed (D10; ships today as the vdx.GaussNewtonHessian adapter)\n# reused inside IncrementalFourDVar.posterior(batch)\n# P*_GN = 𝐇_GN⁻¹, from 50 Lanczos vectors\ngn_posterior_cov = vdx.posterior.gauss_newton_hessian(  # (N, N) op\n    analysis, batch, forward_model, obs_op, prior_cov, obs_cov, n_krylov=50\n)","key":"ubaYj20Pje"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-laplace","identifier":"code-design-primitives-laplace","html_id":"code-design-primitives-laplace","enumerator":"7","children":[{"type":"text","value":"Program ","key":"cksFktzt4q"},{"type":"text","value":"7","key":"AJrbdWfJGC"},{"type":"text","value":":","key":"lQCI9caV17"}],"template":"Program %s:","key":"qpWeksN6bo"},{"type":"text","value":"Builds the Laplace covariance ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"fWei7g2sv8"},{"type":"crossReference","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"children":[{"type":"text","value":"(","key":"lCe5qKAecu"},{"type":"text","value":"13.1","key":"u4Yx28xiaB"},{"type":"text","value":")","key":"VQqJbL8tdD"}],"identifier":"eq-laplace-cov","label":"eq-laplace-cov","kind":"equation","template":"(%s)","enumerator":"13.1","resolved":true,"html_id":"eq-laplace-cov","remote":true,"url":"/posterior-covariance","dataUrl":"/posterior-covariance.json","key":"Tjc6T2PIsH"},{"type":"text","value":" at the MAP and the inverse Gauss-Newton Hessian ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"c3h5Vb4VjT"},{"type":"crossReference","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"children":[{"type":"text","value":"(","key":"DFJWYp4Fob"},{"type":"text","value":"13.2","key":"kk5bIWqCQ0"},{"type":"text","value":")","key":"Uxrg