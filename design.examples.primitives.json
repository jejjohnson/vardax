=\"mord mathnormal mtight\">ε</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"wHOPbhOqkc"},{"type":"text","value":"-space forms\n(Sherman-Morrison-Woodbury) based on dimensions.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"zDDKl9z8Ed"}],"key":"mlCu4S4jdu"},{"type":"thematicBreak","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"qicXIHEucg"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Variational cost","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"I7Oy0kCXMC"}],"identifier":"variational-cost","label":"Variational cost","html_id":"variational-cost","implicit":true,"key":"tlpJ4r3U33"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import jax\nimport vardax as vdx\n\n# Shapes: S windows; T times; N state cells\n# Given: state x (S, T, N), batch (y, m), obs_op H, obs_precision Σ_ε⁻¹ op,\n#        background μ_x, prior_precision Σ_x⁻¹ op, ae_prior g_ae\n\n# proposed (D19)\n# 𝒥_o(x) = ½ ‖m ⊙ (y − h(x))‖²_Σ_ε⁻¹\nobs_term = vdx.obs_cost(  # → ()\n    state, batch.input, batch.mask, obs_operator=obs_op, R_inv_op=obs_precision\n)\n\n# today* (vardax)\n# 𝒥_b(x) = ½ ‖x − μ_x‖²_Σ_x⁻¹\nprior_term_classical = vdx.prior_cost(  # → ()\n    state, prior_mean=background, B_inv_op=prior_precision\n)\n\n# today* (vardax)\n# J_prior(x) = ‖x − g_ae(x)‖²\nprior_term_learned = vdx.prior_cost(state, prior_fn=ae_prior)  # → ()\n\n# today* (vardax)\n# 𝒥(x) = α_obs ½ ‖h(x) − y‖²_Σ_ε⁻¹ + α_prior ‖x − g_ae(x)‖²\ntotal_cost = vdx.variational_cost(  # → ()\n    state,\n    batch,\n    prior_fn=ae_prior,\n    obs_operator=obs_op,\n    alpha_obs=1.0,\n    alpha_prior=0.1,\n)\n\n# today* (vardax)\n# ∇ₓ𝒥(x)\ncost_grad = jax.grad(vdx.variational_cost)(  # (S, T, N)\n    state, batch, ae_prior, obs_op, 1.0, 0.1\n)","key":"gO1PrD2ZDF"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-variational-cost","identifier":"code-design-primitives-variational-cost","html_id":"code-design-primitives-variational-cost","enumerator":"2","children":[{"type":"text","value":"Program ","key":"QjvnrXcWfm"},{"type":"text","value":"2","key":"dL68ypoZ1b"},{"type":"text","value":":","key":"beDOqa5yB4"}],"template":"Program %s:","key":"uc5H4Vdwl8"},{"type":"text","value":"Evaluates the observation cost ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"CZyOodzv7I"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"j5JxPwZdP9"},{"type":"text","value":"2.2","key":"sW8Plw57m3"},{"type":"text","value":")","key":"BAuFyvkWNq"}],"identifier":"eq-obs-cost","label":"eq-obs-cost","kind":"equation","template":"(%s)","enumerator":"2.2","resolved":true,"html_id":"eq-obs-cost","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"oN5EeBufx0"},{"type":"text","value":", the classical and learned prior terms of ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"KLuUJsCmEu"},{"type":"crossReference","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"(","key":"nLPR80UwUg"},{"type":"text","value":"5.1","key":"MYKoJuGYU9"},{"type":"text","value":")","key":"Hykpn6iNnD"}],"identifier":"eq-3dvar-cost","label":"eq-3dvar-cost","kind":"equation","template":"(%s)","enumerator":"5.1","resolved":true,"html_id":"eq-3dvar-cost","remote":true,"url":"/threedvar","dataUrl":"/threedvar.json","key":"BZNmIY2bHb"},{"type":"text","value":" and ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}}