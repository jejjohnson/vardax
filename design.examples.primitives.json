vdx.FourDVarNet(\n    prior=ae_prior,\n    obs_op=obs_op,\n    grad_mod=conv_lstm,\n    # proposed (D4)\n    config=vdx.SolverConfig(n_steps=15),\n    solver_adjoint=solver_adjoint,\n)","key":"OGt6o6hFSJ"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-fourdvarnet-adjoint","identifier":"code-design-primitives-fourdvarnet-adjoint","html_id":"code-design-primitives-fourdvarnet-adjoint","enumerator":"6","children":[{"type":"text","value":"Program ","key":"rlF9vPooUV"},{"type":"text","value":"6","key":"oUMkOZQ6xZ"},{"type":"text","value":":","key":"QzkdGOd37X"}],"template":"Program %s:","key":"d5GDVWTRoV"},{"type":"text","value":"Chooses how training gradients flow back through the unrolled 4DVarNet update ","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"M4QZu3b8mX"},{"type":"crossReference","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"(","key":"h6wtjaTRwQ"},{"type":"text","value":"9.2","key":"lpyLgCUi3h"},{"type":"text","value":")","key":"FbpR1vnr65"}],"identifier":"eq-4dvarnet-update","label":"eq-4dvarnet-update","kind":"equation","template":"(%s)","enumerator":"9.2","resolved":true,"html_id":"eq-4dvarnet-update","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"RqleD63DAa"},{"type":"text","value":": full backprop, last step only, or the fixed-point gradient ","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"bd2TImrjqh"},{"type":"crossReference","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"(","key":"nKVCrDuDoW"},{"type":"text","value":"9.4","key":"Y7nH4D9lw3"},{"type":"text","value":")","key":"MsvC3HuTUr"}],"identifier":"eq-fixed-point-grad","label":"eq-fixed-point-grad","kind":"equation","template":"(%s)","enumerator":"9.4","resolved":true,"html_id":"eq-fixed-point-grad","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"TSZgDdotBg"},{"type":"text","value":".","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"IjwAc8N665"}],"key":"VMKEQhKjDE"}],"key":"lmaQqJeCin"}],"label":"code-design-primitives-fourdvarnet-adjoint","identifier":"code-design-primitives-fourdvarnet-adjoint","enumerator":"6","html_id":"code-design-primitives-fourdvarnet-adjoint","key":"LdTjpR0GSW"},{"type":"thematicBreak","position":{"start":{"line":269,"column":1},"end":{"line":269,"column":1}},"key":"xrj3VlPOI1"},{"type":"heading","depth":2,"position":{"start":{"line":271,"column":1},"end":{"line":271,"column":1}},"children":[{"type":"text","value":"Laplace posterior covariance","position":{"start":{"line":271,"column":1},"end":{"line":271,"column":1}},"key":"sp8BuTAqC2"}],"identifier":"laplace-posterior-covariance","label":"Laplace posterior covariance","html_id":"laplace-posterior-covariance","implicit":true,"key":"zTYSisrMSV"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import jax\nimport vardax as vdx\n\n# Shapes: N state cells\n# Given: analysis x⋆ (N,), threedvar_cost 𝒥, batch, forward_model, obs_op,\n#        prior_precision Σ_x⁻¹ op, obs_precision Σ_ε⁻¹ op, prior_cov Σ_x op, obs_cov Σ_ε op\n\n# ∇𝒥\ncost_grad_fn = jax.grad(threedvar_cost)\n\n# proposed (D10; ships today as the vdx.LaplaceCovariance adapter)\n# Laplace at MAP, for ThreeDVar / StrongFourDVar / WeakFourDVar / FourDVarNet\n# Σ_x|y,Laplace = (∇²𝒥(x⋆))⁻¹ ≈ (Σ_x⁻¹ + Hᵀ Σ_ε⁻¹ H)⁻¹\nposterior_cov = vdx.posterior.laplace_covariance(  # (N, N) op\n    analysis,\n    cost_grad_fn=cost_grad_fn,\n    B_inv_op=prior_precision,\n    R_inv_op=obs_precision,\n)\n\n# proposed (D10; ships today as the vdx.GaussNewtonHessian adapter)\n# reused inside IncrementalFourDVar.posterior(batch)\n# Σ_x|y,GN = 𝐇_GN⁻¹, from 50 Lanczos vectors\ngn_posterior_cov = vdx.posterior.gauss_newton_hessian(  # (N, N) op\n    analysis, batch, forward_model, obs_op, prior_cov, obs_cov, n_krylov=50\n)","key":"eqiijOOe7M"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-primitives-laplace","identifier":"code-design-primitives-laplace","html_id":"code-design-primitives-laplace","enumerator":"7","children":[{"type":"text","value":"Program ","key":"nd8d7zNRZ4"},{"type":"text","value":"7","key":"Q9wYwHrPSV"},{"type":"text","value":":","key":"f9V57R7pxd"}],"template":"Program %s:","key":"TLd90eKD6g"},{"type":"text","value":"Builds the Laplace covariance ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"XmCZwtdBRe"},{"type":"crossReference","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"children":[{"type":"text","value":"(","key":"wRFGHJYLWI"},{"type":"text","value":"13.1","key":"K7SYp63GnA"},{"type":"text","value":")","key":"XqqbHMHP6e"}],"identifier":"eq-laplace-cov","label":"eq-laplace-cov","kind":"equation","template":"(%s)","enumerator":"13.1","resolved":true,"html_id":"eq-laplace-cov","remote":true,"url":"/posterior-covariance","dataUrl":"/posterior-covariance.json","key":"oQqQEAdsXx"},{"type":"text","value":" at the MAP and the inverse Gauss-Newton Hessian ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"sdrdbQ13RH"},{"type":"crossReference","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"children":[{"type":"text","value":"(","key":"CbX3dapz7T"},{"type":"text","value":"13.2","key":"hHR9QxUt7m"},{"type":"text","value":")","key":"cUOL6YoeJv"}],"identifier":"eq-gn-cov","label":"eq-gn-cov","kind":"equation","template":"(%s)","enumerator":"13.2","resolved":true,"html_id":"eq-gn-cov","remote":true,"url":"/posterior-covariance","dataUrl":"/posterior-covariance.json","key":"wX6Toiy9PL"},{"type":"text","value":" of ","position":{"start":{"line":274,"column":1},"end":{"line":274,"column":1}},"key":"lRmbvl55qq"},{"type":"crossRef