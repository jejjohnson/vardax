{"version":3,"kind":"Article","sha256":"80f2bc84b2abcab89cd0c8202c27f01b8acd5110ccb7fe5ee0cde973f9e8e883","slug":"design.examples.components","location":"/design/examples/components.md","dependencies":[],"frontmatter":{"title":"Layer 1 — Component Examples","content_includes_title":false,"authors":[{"nameParsed":{"literal":"J. Emmanuel Johnson","given":"J. Emmanuel","family":"Johnson"},"name":"J. Emmanuel Johnson","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/jejjohnson/vardax","math":{"\\vect":{"macro":"\\mathbf{#1}"},"\\mat":{"macro":"\\mathbf{#1}"},"\\gvect":{"macro":"\\boldsymbol{#1}"},"\\gmat":{"macro":"\\boldsymbol{#1}"},"\\op":{"macro":"\\mathrm{#1}"}},"numbering":{"title":{"offset":2}},"source_url":"https://github.com/jejjohnson/vardax/blob/main/docs/design/examples/components.md","edit_url":"https://github.com/jejjohnson/vardax/edit/main/docs/design/examples/components.md","exports":[{"format":"md","filename":"components.md","url":"/vardax/_public/components-04797cdcfaa63045fde4ad42b3bab49c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Implementing protocols and composing ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"N8KRMOYo4S"},{"type":"inlineCode","value":"eqx.Module","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"eyMVOnDD8s"},{"type":"text","value":" operators.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Qjpuk8XSu0"}],"key":"w7vxpzfFBu"},{"type":"thematicBreak","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"GcF9qkgIy9"},{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Implementing ","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"Djfwoz0z9f"},{"type":"inlineCode","value":"Prior","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"RmoHf2q55k"},{"type":"text","value":" — Autoencoder","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"WbE8SntlPS"}],"identifier":"implementing-prior-autoencoder","label":"Implementing Prior — Autoencoder","html_id":"implementing-prior-autoencoder","implicit":true,"key":"uySpqHCRUB"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import equinox as eqx\nimport vardax as vdx\nfrom jaxtyping import Array, Float\n\n# Shapes: T times; N state cells\n# Given: enc, dec (eqx.nn.Sequential encoder and decoder)\n\n\n# user\nclass ConvAEPrior(eqx.Module):\n    \"\"\"Autoencoder prior g_ae(x) = dec(enc(x)).\"\"\"\n\n    encoder: eqx.nn.Sequential\n    decoder: eqx.nn.Sequential\n\n    def __call__(self, x: Float[Array, \"T N\"]) -> Float[Array, \"T N\"]:\n        # z = enc(x)\n        latent = self.encoder(x)\n        # g_ae(x) = dec(z)\n        return self.decoder(latent)\n\n\n# today (vardax)\n# Structural conformance, no inheritance needed (runtime-checkable Protocol)\nassert isinstance(ConvAEPrior(enc, dec), vdx.Prior)","key":"rr5M08u7T8"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-prior","identifier":"code-design-components-prior","html_id":"code-design-components-prior","enumerator":"1","children":[{"type":"text","value":"Program 1:","key":"nATJhkoK0b"}],"template":"Program %s:","key":"RZrkbHCYCZ"},{"type":"text","value":"Implements an autoencoder prior g_ae for the learned prior term of the 4DVarNet cost ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Tuk64w6NSC"},{"type":"crossReference","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"(9.1)","key":"heGTLJqvIK"}],"identifier":"eq-4dvarnet-cost","