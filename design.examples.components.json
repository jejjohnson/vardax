XR"},{"type":"inlineCode","value":"__call__","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"BozY16azVQ"},{"type":"text","value":" and ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"MSb1c0obrM"},{"type":"inlineCode","value":"linearize","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"vYg7dFBndR"},{"type":"text","value":":","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"eUzKuLiCfs"}],"key":"FUU8EFdXmB"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import equinox as eqx\nimport lineax as lx\nimport pipekit_cycle as pc\nfrom jaxtyping import Array, Float\n\n# Shapes: N state cells\n\n\n# user\nclass MaskedIdentity(eqx.Module):\n    \"\"\"h(x) = mask ⊙ x.\"\"\"\n\n    def __call__(\n        self, x: Float[Array, \" N\"], mask: Float[Array, \" N\"] | None = None\n    ) -> Float[Array, \" N\"]:\n        # h(x) = m ⊙ x, or x when no mask is given\n        return x * mask if mask is not None else x\n\n    def linearize(self, x: Float[Array, \" N\"]) -> lx.AbstractLinearOperator:\n        # today (lineax)\n        # h(x) = ∂H/∂x\n        return lx.JacobianLinearOperator(self.__call__, x)  # (N, N) op\n\n\n# today (pipekit_cycle)\nassert isinstance(MaskedIdentity(), pc.ObservationOperator)","key":"DaRS8iBvei"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-masked-identity","identifier":"code-design-components-masked-identity","html_id":"code-design-components-masked-identity","enumerator":"2","children":[{"type":"text","value":"Program 2:","key":"C4MeE34Utl"}],"template":"Program %s:","key":"GAAQ83TYiJ"},{"type":"text","value":"Implements the masked-identity operator ","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"Hkf00hz1OL"},{"type":"crossReference","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"(2.3)","key":"pvmJdkqL1J"}],"identifier":"eq-masked-identity","label":"eq-masked-identity","kind":"equation","template":"(%s)","enumerator":"2.3","resolved":true,"html_id":"eq-masked-identity","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"JuPguy861j"},{"type":"text","value":" with a Jacobian linearisation and checks it against the pipekit_cycle protocol.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"QBvOdbw4jR"}],"key":"F3das1xBNR"}],"key":"xZRlypEHM0"}],"label":"code-design-components-masked-identity","identifier":"code-design-components-masked-identity","enumerator":"2","html_id":"code-design-components-masked-identity","key":"vFlpmaGO4U"},{"type":"thematicBreak","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"g1XcgbtbBd"},{"type":"heading","depth":2,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Implementing ","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"BdUP2lXLGL"},{"type":"inlineCode","value":"ObservationOperator","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"HVqbDUHc7i"},{"type":"text","value":" — Averaging kernel (D9)","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"RQNuaKjoNj"}],"identifier":"implementing-observationoperator-averaging-kernel-d9","label":"Implementing ObservationOperator — Averaging kernel (D9)","html_id":"implementing-observationoperator-averaging-kernel-d9","implicit":true,"key":"dpuNIDCd88"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import lineax as lx\nimport vardax as vdx\n\n# Shapes: N levels\n# Given: A_matrix (N, N), retrieval_prior μ_ret (N,), weighting_vector w (N,),\n#        state x (N,), residual r (N,)\n\n# today (lineax)\n# J_x̂, or a gaussx structured operator\nkernel_op = lx.MatrixLinearOperator(A_matrix)  # (N, N) op\n# today (vardax)\nak = vdx.AveragingKernel(\n    kernel_matrix=kernel_op,\n    prior_profile=retrieval_prior,\n    pressure_weights=weighting_vector,\n)\n\n# today (vardax)\n# h(x) = J_x̂ (w ⊙ x + (1 − w) ⊙ μ_ret)\ny_pred = ak(x)  # (N,) → (N,)\n\n# Tangent-linear operator for incremental 4DVar\n# today (vardax)\n# H = J_x̂ diag(w)\nobs_jacobian = ak.linearize(x)  # (N,) → (N, N) op\n# today (lineax)\n# Hᵀ\nobs_adjoint = obs_jacobian.transpose()  # (N, N) op\n# today (lineax)\n# Hᵀ r\ny_adjoint = obs_adjoint.mv(residual)  # (N,) → (N,)","key":"jpdMaXn8LZ"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-averaging-kernel","identifier":"code-design-components-averaging-kernel","html_id":"code-design-components-averaging-kernel","enumerator":"3","children":[{"type":"text","value":"Program 3:","key":"gW9srVuHvE"}],"template":"Program %s:","key":"QEIDDIZf4N"},{"type":"text","value":"Applies the averaging-kernel operator ","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"DuRjFm7tI7"},{"type":"crossReference","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"(2.5)","key":"Tp5jhcV4XC"}],"identifier":"eq-averaging-kernel","label":"eq-averaging-kernel","kind":"equation","template":"(%s)","enumerator":"2.5","resolved":true,"html_id":"eq-averaging-kernel","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"WgUElzBtPr"},{"type":"text","value":" and its tangent-linear adjoint, the pair checked by ","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"zoApp80po4"},{"type":"crossReference","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"(2.7)","key":"t173fTHJDe"}],"identifier":"eq-adjoint-test","label":"eq-adjoint-test","kind":"equation","template":"(%s)","enumerator":"2.7","resolved":true,"html_id":"eq-adjoint-test","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"yrfKw0kiiy"},{"type":"text","value":".","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"ao51a57BRD"}],"key":"EFOqj1S8MT"}],"key":"lqmeM8loJf"}],"label":"code-design-components-averaging-kernel","identifier":"code-design-components-averaging-kernel","enumerator":"3","html_id":"code-design-components-averaging-kernel","key":"dxLuBn3BXL"},{"type":"thematicBreak","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"uyE6NvtccK"},{"type":"heading","depth":2,"position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"Implementing ","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"XHZTctREjd"},{"type":"inlineCode","value":"ObservationOperator","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"ohoO4aRRYV"},{"type":"text","value":" — Multi-instrument fusion","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"TgoD2aoBHV"}],"identifier":"implementing-observationoperator-multi-instrument-fusion","label":"Implementing ObservationOperator — Multi-instrument fusion","html_id":"implementing-observationoperator-multi-instrument-fusion","implicit":true,"key":"tABMQFeXJY"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import lineax as lx\nimport pipekit_cycle as pc\nimport vardax as vdx\n\n# Shapes: N state cells; Mᵢ observations of instrument i\n# Given: tropomi_A, tropomi_xa, tropomi_h, tropomi_qa_flag,\n#        tropomi_uncertainty (Mᵢ,), state x (N,), batch\n\n# today (vardax)\n# hᵢ(x) = J_x̂,ᵢ (wᵢ ⊙ x + (1 − wᵢ) ⊙ μ_ret,ᵢ)\ntropomi_ak = vdx.AveragingKernel(\n    kernel_matrix=tropomi_A, prior_profile=tropomi_xa, pressure_weights=tropomi_h\n)\n# today (lineax)\n# Σ_ε,ᵢ = diag(σᵢ²)\ntropomi_cov = lx.DiagonalLinearOperator(tropomi_uncertainty)  # (Mᵢ, Mᵢ) op\n# today (vardax)\n# (hᵢ, mᵢ, Σ_ε,ᵢ) for i = TROPOMI\ntropomi_spec = vdx.InstrumentSpec(\n    obs_op=tropomi_ak,\n    mask=tropomi_qa_flag,\n    obs_cov_op=tropomi_cov,\n    instrument_id=\"TROPOMI\",\n)\n# today* (vardax)\nemit_spec = vdx.InstrumentSpec(...)\n# today* (vardax)\nghgsat_spec = vdx.InstrumentSpec(...)\n\n# today (vardax)\nregistry = vdx.InstrumentRegistry(\n    entries={\n        \"TROPOMI\": tropomi_spec,\n        \"EMIT\": emit_spec,\n        \"GHGSat\": ghgsat_spec,\n    }\n)\n# today (vardax)\nfusion = vdx.MultiInstrumentFusion(registry=registry)\n\n# Returns dict[instrument_id, predicted_obs]\n# today* (vardax; __call__ takes the state only)\n# {i: hᵢ(x)}\npredictions = fusion(x, batch)  # (N,) → {i: (Mᵢ,)}\n\n# For strict pipekit_cycle.ObservationOperator contexts, use the adapter:\n# today (vardax)\n# h(x) = [h_TROPOMI(x); h_EMIT(x); h_GHGSat(x)]\nfusion_as_op = fusion.to_observation_operator()\n# today (pipekit_cycle)\nassert isinstance(fusion_as_op, pc.ObservationOperator)","key":"kDNub1k8HE"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-fusion","identifier":"code-design-components-fusion","html_id":"code-design-components-fusion","enumerator":"4","children":[{"type":"text","value":"Program 4:","key":"SmbMbG4D9N"}],"template":"Program %s:","key":"Omem0k6P7v"},{"type":"text","value":"Builds the multi-instrument operator behind the fusion cost ","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"QQ1hw1dgt8"},{"type":"crossReference","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"(2.6)","key":"CfJDuOVuev"}],"identifier":"eq-fusion-cost","label":"eq-fusion-cost","kind":"equation","template":"(%s)","enumerator":"2.6","resolved":true,"html_id":"eq-fusion-cost","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"lILvzo6Jse"},{"type":"text","value":" from per-instrument averaging kernels ","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"OmcV3Vl8wW"},{"type":"crossReference","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"(2.5)","key":"bKmzRozg3F"}],"identifier":"eq-averaging-kernel","label":"eq-averaging-kernel","kind":"equation","template":"(%s)","enumerator":"2.5","resolved":true,"html_id":"eq-averaging-kernel","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"FRc9uaJ9Hw"},{"type":"text","value":".","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"L5zz7bDXIh"}],"key":"h304OXDUXy"}],"key":"C6uAgEaRio"}],"label":"code-design-components-fusion","identifier":"code-design-components-fusion","enumerator":"4","html_id":"code-design-components-fusion","key":"lqtkF1DXHs"},{"type":"thematicBreak","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"k8QxVzwiPq"},{"type":"heading","depth":2,"position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"Implementing ","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"kZ6whMQGEe"},{"type":"inlineCode","value":"GradModulator","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"TW2RYuUenN"},{"type":"text","value":" — ConvLSTM (FourDVarNet only)","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"ArBVU60S7d"}],"identifier":"implementing-gradmodulator-convlstm-fourdvarnet-only","label":"Implementing GradModulator — ConvLSTM (FourDVarNet only)","html_id":"implementing-gradmodulator-convlstm-fourdvarnet-only","implicit":true,"key":"cNtLRmUQMw"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import equinox as eqx\nimport vardax as vdx\nfrom jaxtyping import Array, Float\n\n# Shapes: C channels; G hidden channels; H × W grid\n# Given: lstm (a ConvLSTM cell), proj (an eqx.nn.Conv2d from G to C channels)\n\nCarry = tuple[Float[Array, \"G H W\"], Float[Array, \"G H W\"]]\n\n\n# user\nclass ConvLSTMGradMod(eqx.Module):\n    \"\"\"g_mod(∇ₓ𝒥, h) → (update, h′) with a ConvLSTM cell and a projection.\"\"\"\n\n    conv_lstm: eqx.Module\n    output_proj: eqx.nn.Conv2d\n\n    def __call__(\n        self, grad: Float[Array, \"C H W\"], carry: Carry\n    ) -> tuple[Float[Array, \"C H W\"], Carry]:\n        hidden, cell = carry\n        # (h′, c′) = ConvLSTM(∇ₓ𝒥, (h, c))\n        hidden, cell = self.conv_lstm(grad, (hidden, cell))\n        # g_mod(∇ₓ𝒥, h) = W h′\n        update = self.output_proj(hidden)\n        return update, (hidden, cell)\n\n\n# today* (vardax; the shipped protocol is __call__(grad, state, carry))\nassert isinstance(ConvLSTMGradMod(lstm, proj), vdx.GradModulator)","key":"gs8CP5WPn5"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-grad-mod","identifier":"code-design-components-grad-mod","html_id":"code-design-components-grad-mod","enumerator":"5","children":[{"type":"text","value":"Program 5:","key":"z1rRls8D27"}],"template":"Program %s:","key":"HBVJlRJiNM"},{"type":"text","value":"Implements the learned gradient modulator g_mod of the 4DVarNet update ","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"Sji3helCU2"},{"type":"crossReference","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"children":[{"type":"text","value":"(9.2)","key":"yTmvhKs8HS"}],"identifier":"eq-4dvarnet-update","label":"eq-4dvarnet-update","kind":"equation","template":"(%s)","enumerator":"9.2","resolved":true,"html_id":"eq-4dvarnet-update","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"Dl5l2BFuuR"},{"type":"text","value":" as a ConvLSTM.","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"mWE6BsaG27"}],"key":"yF0YvEL7i2"}],"key":"e91xyL88tN"}],"label":"code-design-components-grad-mod","identifier":"code-design-components-grad-mod","enumerator":"5","html_id":"code-design-components-grad-mod","key":"ye0VEcBCN5"},{"type":"paragraph","position":{"start":{"line":221,"column":1},"end":{"line":222,"column":1}},"children":[{"type":"text","value":"The grad modulator family is ","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"fzbj5xRK1V"},{"type":"inlineCode","value":"FourDVarNet","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"fPXehtKPlO"},{"type":"text","value":"-specific. Classical methods\nuse ","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"gzPXS3t501"},{"type":"inlineCode","value":"optimistix.AbstractMinimiser","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"cRSQNf8VlX"},{"type":"text","value":" for the inner solver instead.","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"p7q4xJxtuy"}],"key":"bUEFsZ9ziL"},{"type":"thematicBreak","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"key":"YLnPIVACCT"},{"type":"heading","depth":2,"position":{"start":{"line":226,"column":1},"end":{"line":226,"column":1}},"children":[{"type":"text","value":"Wrapping a ","position":{"start":{"line":226,"column":1},"end":{"line":226,"column":1}},"key":"yVa06Ibmqu"},{"type":"inlineCode","value":"Minimiser","position":{"start":{"line":226,"column":1},"end":{"line":226,"column":1}},"key":"zGaKQmRrRb"},{"type":"text","value":" (classical methods)","position":{"start":{"line":226,"column":1},"end":{"line":226,"column":1}},"key":"Gk9KkphGiO"}],"identifier":"wrapping-a-minimiser-classical-methods","label":"Wrapping a Minimiser (classical methods)","html_id":"wrapping-a-minimiser-classical-methods","implicit":true,"key":"M3ZiN0ZdvH"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import optimistix as optx\nimport vardax as vdx\n\n# Given: obs_op, background μ_x, prior_cov Σ_x op, obs_cov Σ_ε op\n\n# Pick any optimistix minimiser\n# proposed (D6; vdx.Minimiser ships as a Protocol, the wrapper is\n#   vdx.OptimistixMinimiser(solver), with no adjoint field)\ngn = vdx.Minimiser(\n    optx.GaussNewton(rtol=1e-5, atol=1e-5), adjoint=optx.ImplicitAdjoint()\n)\n# proposed (D6)\nbfgs = vdx.Minimiser(optx.BFGS(rtol=1e-5, atol=1e-5))\n# proposed (D6)\nncg = vdx.Minimiser(optx.NonlinearCG(rtol=1e-5, atol=1e-5))\n\n# today* (vardax; gn.minimiser and gn.adjoint are proposed)\n# x⋆ = argmin 𝒥(x)\nmodel = vdx.ThreeDVar(\n    obs_op=obs_op,\n    prior_mean=background,\n    prior_cov_op=prior_cov,\n    obs_cov_op=obs_cov,\n    # the underlying optimistix solver\n    minimiser=gn.minimiser,\n    minimiser_adjoint=gn.adjoint,\n)","key":"XMoyr1vHzm"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-minimiser","identifier":"code-design-components-minimiser","html_id":"code-design-components-minimiser","enumerator":"6","children":[{"type":"text","value":"Program 6:","key":"lZUiZ1GWb7"}],"template":"Program %s:","key":"kfFuBPbw68"},{"type":"text","value":"Wraps optimistix minimisers for the 3DVar cost ","position":{"start":{"line":229,"column":1},"end":{"line":229,"column":1}},"key":"SmNdcj2CTG"},{"type":"crossReference","position":{"start":{"line":229,"column":1},"end":{"line":229,"column":1}},"children":[{"type":"text","value":"(5.1)","key":"vteHiceK62"}],"identifier":"eq-3dvar-cost","label":"eq-3dvar-cost","kind":"equation","template":"(%s)","enumerator":"5.1","resolved":true,"html_id":"eq-3dvar-cost","remote":true,"url":"/threedvar","dataUrl":"/threedvar.json","key":"Mu8pdoMTQJ"},{"type":"text","value":" and passes one to ThreeDVar.","position":{"start":{"line":229,"colu