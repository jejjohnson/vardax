port diffrax as dfx\nimport somax\nimport vardax as vdx\n\n# Given: grid, params\n\n# not pinned (somax)\n# somax already satisfies pipekit_cycle.ForwardModel\nswm = somax.ShallowWaterModel(grid=grid, params=params)\n\n# Wrap as a Prior (integrates n_steps forward)\n# today* (vardax; ships as DynamicalPrior(model, params, solver, stepsize, adjoint))\n# g_ae(x₀) = f₁₀(x₀)\nprior = vdx.DynamicalPrior(\n    forward=swm,\n    n_steps=10,\n    # memory-efficient\n    forward_adjoint=dfx.BacksolveAdjoint(),\n)","key":"aIsujUrdPF"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-dynamical-prior","identifier":"code-design-components-dynamical-prior","html_id":"code-design-components-dynamical-prior","enumerator":"7","children":[{"type":"text","value":"Program 7:","key":"DHTnuriYC2"}],"template":"Program %s:","key":"GfnIidvd4h"},{"type":"text","value":"Wraps a somax shallow-water forward ","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"key":"A0SYRjmGxD"},{"type":"crossReference","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"children":[{"type":"text","value":"(19.2)","key":"vJzcK6tn53"}],"identifier":"eq-shallow-water","label":"eq-shallow-water","kind":"equation","template":"(%s)","enumerator":"19.2","resolved":true,"html_id":"eq-shallow-water","remote":true,"url":"/physical-models","dataUrl":"/physical-models.json","key":"pXIXpKNGZe"},{"type":"text","value":" as a dynamical prior that rolls the state forward ","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"key":"yV3DqzBgZ4"},{"type":"crossReference","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"children":[{"type":"text","value":"(1.3)","key":"Lhgnx8o9ZM"}],"identifier":"eq-rollout","label":"eq-rollout","kind":"equation","template":"(%s)","enumerator":"1.3","resolved":true,"html_id":"eq-rollout","remote":true,"url":"/problem-setting","dataUrl":"/problem-setting.json","key":"pVdEodv4jH"},{"type":"text","value":".","position":{"start":{"line":268,"column":1},"end":{"line":268,"column":1}},"key":"HmFxpk2un0"}],"key":"FzwlzmH3mh"}],"key":"BEId41cYlX"}],"label":"code-design-components-dynamical-prior","identifier":"code-design-components-dynamical-prior","enumerator":"7","html_id":"code-design-components-dynamical-prior","key":"ntnda2CaNw"},{"type":"paragraph","position":{"start":{"line":291,"column":1},"end":{"line":291,"column":1}},"children":[{"type":"text","value":"For methane / plumax:","position":{"start":{"line":291,"column":1},"end":{"line":291,"column":1}},"key":"iZ1JYVlK3a"}],"key":"vpgTXfXQ0E"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import plumax\nimport vardax as vdx\n\n# Given: met_field\n\n# not pinned (plumax)\nplume = plumax.GaussianPlumeForward(met=met_field, dispersion=\"MO\")\n# today* (vardax; ships as DynamicalPrior(model, params, solver, stepsize, adjoint))\n# single-shot for Tier I: g_ae(x) = f₁(x)\nprior = vdx.DynamicalPrior(forward=plume, n_steps=1)","key":"QGF9NJIRgL"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-plume-prior","identifier":"code-design-components-plume-prior","html_id":"code-design-components-plume-prior","enumerator":"8","children":[{"type":"text","value":"Program 8:","key":"kZ09KN3VXa"}],"template":"Program %s:","key":"LDrW5IVTPV"},{"type":"text","value":"Wraps a single-shot plumax Gaussian-plume forward as a dynamical prior, one step of ","position":{"start":{"line":294,"column":1},"end":{"line":294,"column":1}},"key":"C3aE0YqJCm"},{"type":"crossReference","position":{"start":{"line":294,"column":1},"end":{"line":294,"column":1}},"children":[{"type":"text","value":"(1.3)","key":"AjfUHth3rT"}],"identifier":"eq-rollout","label":"eq-rollout","kind":"equation","template":"(%s)","enumerator":"1.3","resolved":true,"html_id":"eq-rollout","remote":true,"url":"/problem-setting","dataUrl":"/problem-setting.json","key":"awA3MzFcBT"},{"type":"text","value":".","position":{"start":{"line":294,"column":1},"end":{"line":294,"column":1}},"key":"iFMmZNIGRM"}],"key":"sL6PBmvBoS"}],"key":"UxOotRDu25"}],"label":"code-design-components-plume-prior","identifier":"code-design-components-plume-prior","enumerator":"8","html_id":"code-design-components-plume-prior","key":"hBUiyoTIqW"},{"type":"thematicBreak","position":{"start":{"line":308,"column":1},"end":{"line":308,"column":1}},"key":"WHfOzSLm8w"},{"type":"heading","depth":2,"position":{"start":{"line":310,"column":1},"end":{"line":310,"column":1}},"children":[{"type":"text","value":"Composing components into an ","position":{"start":{"line":310,"column":1},"end":{"line":310,"column":1}},"key":"WknpAV8L8P"},{"type":"inlineCode","value":"OptimalInterpolation","position":{"start":{"line":310,"column":1},"end":{"line":310,"column":1}},"key":"LNJ36n8Rp1"}],"identifier":"composing-components-into-an-optimalinterpolation","label":"Composing components into an OptimalInterpolation","html_id":"composing-components-into-an-optimalinterpolation","implicit":true,"key":"ho5LxT5UjM"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import gaussx as gx\nimport lineax as lx\nimport vardax as vdx\n\n# Shapes: S windows; N state cells; M observations; D = 2 coordinates\n# Given: H_lin_op (M, N) lineax op, background μ_x (N,), coords (N, D),\n#        obs_uncertainty (M,), batch\n\n# today (vardax)\n# h(x) = H x, must be linear\nobs_op = vdx.LinearObs(operator=H_lin_op)\n# proposed (gaussx)\n# (Σ_x)ᵢⱼ = k_Matérn(sᵢ, sⱼ; ℓ = 10, σ = 0.1)\nprior_cov = gx.MaternLinearOperator(  # (N, D) → (N, N) PSD op\n    coords, length_scale=10.0, sigma=0.1\n)\n# today (lineax)\n# Σ_ε = diag(σ²)\nobs_cov = lx.DiagonalLinearOperator(obs_uncertainty)  # (M,) → (M, M) op\n\n# today (vardax)\nmodel = vdx.OptimalInterpolation(\n    obs_op=obs_op,\n    prior_mean=background,\n    prior_cov_op=prior_cov,\n    obs_cov_op=obs_cov,\n)\n\n# today (vardax)\n# closed form: x⋆ = μ_x + G (y − H μ_x)\nanalysis = model(batch)  # → (S, N)\n# today (vardax)\n# closed form: Σ_x|y = (I − G H) Σ_x, with mean and provenance\nposterior = model.posterior(batch)  # Posterior(mean (N,), cov (N, N) op)","key":"ma7P6dF4Gb"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-oi","identifier":"code-design-components-oi","html_id":"code-design-components-oi","enumerator":"9","children":[{"type":"text","value":"Program 9:","key":"KYKF3zofyx"}],"template":"Program %s:","key":"ro2c3PZrZY"},{"type":"text","value":"Composes a linear operator and a Matérn prior into OptimalInterpolation for the closed-form mean ","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"key":"sl0uAOfaku"},{"type":"crossReference","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"text","value":"(4.4)","key":"Jz5N2cq6Ap"}],"identifier":"eq-blue-mean","label":"eq-blue-mean","kind":"equation","template":"(%s)","enumerator":"4.4","resolved":true,"html_id":"eq-blue-mean","remote":true,"url":"/oi-blue","dataUrl":"/oi-blue.json","key":"ofyHkubTiu"},{"type":"text","value":" and covariance ","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"key":"enzSVUFnof"},{"type":"crossReference","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"children":[{"type":"text","value":"(4.5)","key":"CtSrnbGp7t"}],"identifier":"eq-blue-cov","label":"eq-blue-cov","kind":"equation","template":"(%s)","enumerator":"4.5","resolved":true,"html_id":"eq-blue-cov","remote":true,"url":"/oi-blue","dataUrl":"/oi-blue.json","key":"B3dWTbz9JL"},{"type":"text","value":".","position":{"start":{"line":313,"column":1},"end":{"line":313,"column":1}},"key":"xJk9tk9NCA"}],"key":"A2xNIPDIL9"}],"key":"oDTJL7yNvI"}],"label":"code-design-components-oi","identifier":"code-design-components-oi","enumerator":"9","html_id":"code-design-components-oi","key":"cL3heRXFw1"},{"type":"thematicBreak","position":{"start":{"line":351,"column":1},"end":{"line":351,"column":1}},"key":"hlnhh0ybXe"},{"type":"heading","depth":2,"position":{"start":{"line":353,"column":1},"end":{"line":353,"column":1}},"children":[{"type":"text","value":"Composing components into a ","position":{"start":{"line":353,"column":1},"end":{"line":353,"column":1}},"key":"x3m8MzsyTk"},{"type":"inlineCode","value":"ThreeDVar","position":{"start":{"line":353,"column":1},"end":{"line":353,"column":1}},"key":"QcN6F4d6CZ"}],"identifier":"composing-components-into-a-threedvar","label":"Composing components into a ThreeDVar","html_id":"composing-components-into-a-threedvar","implicit":true,"key":"E9Opu2s0Qm"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import optimistix as optx\nimport vardax as vdx\n\n# Shapes: S windows; N levels\n# Given: J_x̂ (N, N) lineax op, xa μ_ret (N,), w (N,), background μ_x (N,),\n#        prior_cov Σ_x op, obs_cov Σ_ε op, batch\n\n# today (vardax)\n# h(x) = J_x̂ (w ⊙ x + (1 − w) ⊙ μ_ret), nonlinear via the w ⊙ x term\nobs_op = vdx.AveragingKernel(kernel_matrix=A, prior_profile=xa, pressure_weights=h)\n\n# today* (vardax; optx.GaussNewton is a least-squares solver, not an\n#   AbstractMinimiser, so the model rejects it: use optx.BFGS or NonlinearCG)\n# 𝒥(x) = ½ ‖x − μ_x‖²_Σ_x⁻¹ + ½ ‖y − h(x)‖²_Σ_ε⁻¹\nmodel = vdx.ThreeDVar(\n    obs_op=obs_op,\n    prior_mean=background,\n    prior_cov_op=prior_cov,\n    obs_cov_op=obs_cov,\n    minimiser=optx.GaussNewton(rtol=1e-5, atol=1e-5),\n    minimiser_adjoint=optx.ImplicitAdjoint(),\n)\n# today (vardax)\n# x⋆ = argmin 𝒥(x)\nanalysis = model(batch)  # → (S, N)","key":"Ihi9Ijq2qj"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-threedvar","identifier":"code-design-components-threedvar","html_id":"code-design-components-threedvar","enumerator":"10","children":[{"type":"text","value":"Program 10:","key":"sTYagWj02b"}],"template":"Program %s:","key":"qT2qeC7TJ3"},{"type":"text","value":"Composes an averaging kernel ","position":{"start":{"line":356,"column":1},"end":{"line":356,"column":1}},"key":"sa77YSA5jA"},{"type":"crossReference","position":{"start":{"line":356,"column":1},"end":{"line":356,"column":1}},"children":[{"type":"text","value":"(2.5)","key":"QAi3mn6adw"}],"identifier":"eq-averaging-kernel","label":"eq-averaging-kernel","kind":"equation","template":"(%s)","enumerator":"2.5","resolved":true,"html_id":"eq-averaging-kernel","remote":true,"url":"/observation-model","dataUrl":"/observation-model.json","key":"VX4n05FSLy"},{"type":"text","value":" and Gauss-Newton into ThreeDVar for the cost ","position":{"start":{"line":356,"column":1},"end":{"line":356,"column":1}},"key":"TrwOvNdl9B"},{"type":"crossReference","position":{"start":{"line":356,"column":1},"end":{"line":356,"column":1}},"children":[{"type":"text","value":"(5.1)","key":"YoYKb3UxIL"}],"identifier":"eq-3dvar-cost","label":"eq-3dvar-cost","kind":"equation","template":"(%s)","enumerator":"5.1","resolved":true,"html_id":"eq-3dvar-cost","remote":true,"url":"/threedvar","dataUrl":"/threedvar.json","key":"QBTHcQJOjr"},{"type":"text","value":".","position":{"start":{"line":356,"column":1},"end":{"line":356,"column":1}},"key":"p5c8a1nUvs"}],"key":"sjBeQ6ISs2"}],"key":"B0ShVCrlAa"}],"label":"code-design-components-threedvar","identifier":"code-design-components-threedvar","enumerator":"10","html_id":"code-design-components-threedvar","key":"CsuktCH9oW"},{"type":"thematicBreak","position":{"start":{"line":385,"column":1},"end":{"line":385,"column":1}},"key":"DfPEn6hEpD"},{"type":"heading","depth":2,"position":{"start":{"line":387,"column":1},"end":{"line":387,"column":1}},"children":[{"type":"text","value":"Composing components into an ","position":{"start":{"line":387,"column":1},"end":{"line":387,"column":1}},"key":"aueoleG1NM"},{"type":"inlineCode","value":"IncrementalFourDVar","position":{"start":{"line":387,"column":1},"end":{"line":387,"column":1}},"key":"h3kFR0X9nD"}],"identifier":"composing-components-into-an-incrementalfourdvar","label":"Composing components into an IncrementalFourDVar","html_id":"composing-components-into-an-incrementalfourdvar","implicit":true,"key":"aFxKfUQjNY"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import diffrax as dfx\nimport vardax as vdx\n\n# Shapes: S windows; T times; N state cells\n# Given: somax_model, J_x̂ (N, N) lineax op, xa μ_ret (N,), w (N,),\n#        background μ_x (N,), prior_cov Σ_x op, obs_cov Σ_ε op, batch\n\n# today (vardax)\n# h(x) = J_x̂ (w ⊙ x + (1 − w) ⊙ μ_ret)\nobs_op = vdx.AveragingKernel(kernel_matrix=A, prior_profile=xa, pressure_weights=h)\n\n# today (vardax)\n# 3 outer relinearisations, 20 CG steps each, in z with x₀ − μ_x = L_x z\nmodel = vdx.IncrementalFourDVar(\n    forward=somax_model,\n    obs_op=obs_op,\n    prior_mean=background,\n    prior_cov_op=prior_cov,\n    obs_cov_op=obs_cov,\n    config=vdx.IncrementalConfig(n_outer=3, n_inner=20, cvt=True),\n    forward_adjoint=dfx.BacksolveAdjoint(),\n)\n\n# today (vardax)\n# x₀⋆ after the last outer iteration\nanalysis = model(batch)  # → (S, N)\n# today (vardax)\n# Σ_x|y,GN = 𝐇_GN⁻¹, reusing the Hessian of the last outer iteration\nposterior = model.posterior(batch)  # Posterior(mean (N,), cov (N, N) op)","key":"UBL88KKtgg"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-incremental","identifier":"code-design-components-incremental","html_id":"code-design-components-incremental","enumerator":"11","children":[{"type":"text","value":"Program 11:","key":"D80IjOT7oH"}],"template":"Program %s:","key":"ZNfGHQ8KnG"},{"type":"text","value":"Composes IncrementalFourDVar for the incremental cost ","position":{"start":{"line":390,"column":1},"end":{"line":390,"column":1}},"key":"E7h6rYRoni"},{"type":"crossReference","position":{"start":{"line":390,"column":1},"end":{"line":390,"column":1}},"children":[{"type":"text","value":"(8.3)","key":"QHg92udv8E"}],"identifier":"eq-incremental-cost","label":"eq-incremental-cost","kind":"equation","template":"(%s)","enumerator":"8.3","resolved":true,"html_id":"eq-incremental-cost","remote":true,"url":"/incremental-4dvar","dataUrl":"/incremental-4dvar.json","key":"uoWQpxmkYw"},{"type":"text","value":" in control variables ","position":{"start":{"line":390,"column":1},"end":{"line":390,"column":1}},"key":"JCL1NjkIP3"},{"type":"crossReference","position":{"start":{"line":390,"column":1},"end":{"line":390,"column":1}},"children":[{"type":"text","value":"(8.6)","key":"xNvsxJYbH0"}],"identifier":"eq-cvt","label":"eq-cvt","kind":"equation","template":"(%s)","enumerator":"8.6","resolved":true,"html_id":"eq-cvt","remote":true,"url":"/incremental-4dvar","dataUrl":"/incremental-4dvar.json","key":"HwexH1VO1D"},{"type":"text","value":" and reads the Gauss-Newton posterior ","position":{"start":{"line":390,"column":1},"end":{"line":390,"column":1}},"key":"QXHzlrhLj8"},{"type":"crossReference","position":{"start":{"line":390,"column":1},"end":{"line":390,"column":1}},"children":[{"type":"text","value":"(13.2)","key":"jTEI1FjQM1"}],"identifier":"eq-gn-cov","label":"eq-gn-cov","kind":"equation","template":"(%s)","enumerator":"13.2","resolved":true,"html_id":"eq-gn-cov","remote":true,"url":"/posterior-covariance","dataUrl":"/posterior-covariance.json","key":"KLp6CedhaY"},{"type":"text","value":".","position":{"start":{"line":390,"column":1},"end":{"line":390,"column":1}},"key":"iiG8qbbYY6"}],"key":"s8O0w6bpcn"}],"key":"YQfUSamWoi"}],"label":"code-design-components-incremental","identifier":"code-design-components-incremental","enumerator":"11","html_id":"code-design-components-incremental","key":"t4lcoL7XhG"},{"type":"thematicBreak","position":{"start":{"line":423,"column":1},"end":{"line":423,"column":1}},"key":"LYO2nMXSQd"},{"type":"heading","depth":2,"position":{"start":{"line":425,"column":1},"end":{"line":425,"column":1}},"children":[{"type":"text","value":"Composing components into a ","position":{"start":{"line":425,"column":1},"end":{"line":425,"column":1}},"key":"KXpiGOZyQX"},{"type":"inlineCode","value":"FourDVarNet","position":{"start":{"line":425,"column":1},"end":{"line":425,"column":1}},"key":"Hrtso526ik"}],"identifier":"composing-components-into-a-fourdvarnet","label":"Composing components into a FourDVarNet","html_id":"composing-components-into-a-fourdvarnet","implicit":true,"key":"nIHZCCRN56"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import vardax as vdx\n\n# Shapes: K = 15 inner steps\n# Given: enc, dec, lstm, proj, and the page's ConvAEPrior, MaskedIdentity and\n#        ConvLSTMGradMod\n\n# proposed (D14; ships today as vdx.FourDVarNet1D / vdx.FourDVarNet2D)\n# x⁽ⁱ⁺¹⁾ = x⁽ⁱ⁾ − g_mod(∇ₓ𝒥(x⁽ⁱ⁾), c⁽ⁱ⁾), i = 0 … N_iter − 1\nmodel = vdx.FourDVarNet(\n    prior=ConvAEPrior(encoder=enc, decoder=dec),\n    obs_op=MaskedIdentity(),\n    grad_mod=ConvLSTMGradMod(lstm, proj),\n    # proposed (D4)\n    config=vdx.SolverConfig(n_steps=15, alpha=0.2),\n    # O(1) memory training\n    solver_adjoint=vdx.adjoints.OneStepAdjoint(),\n)","key":"ODcbddrVHn"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-fourdvarnet","identifier":"code-design-components-fourdvarnet","html_id":"code-design-components-fourdvarnet","enumerator":"12","children":[{"type":"text","value":"Program 12:","key":"KXVWNgxOGL"}],"template":"Program %s:","key":"lUviMD4KMV"},{"type":"text","value":"Composes the page’s prior and gradient modulator into a FourDVarNet that minimises ","position":{"start":{"line":428,"column":1},"end":{"line":428,"column":1}},"key":"nirX20JhGN"},{"type":"crossReference","position":{"start":{"line":428,"column":1},"end":{"line":428,"column":1}},"children":[{"type":"text","value":"(9.1)","key":"hWX622bMeu"}],"identifier":"eq-4dvarnet-cost","label":"eq-4dvarnet-cost","kind":"equation","template":"(%s)","enumerator":"9.1","resolved":true,"html_id":"eq-4dvarnet-cost","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"qia4DNHNQ0"},{"type":"text","value":" by the learned update ","position":{"start":{"line":428,"column":1},"end":{"line":428,"column":1}},"key":"ZckL8S0JPb"},{"type":"crossReference","position":{"start":{"line":428,"column":1},"end":{"line":428,"column":1}},"children":[{"type":"text","value":"(9.2)","key":"CYSELlsD6g"}],"identifier":"eq-4dvarnet-update","label":"eq-4dvarnet-update","kind":"equation","template":"(%s)","enumerator":"9.2","resolved":true,"html_id":"eq-4dvarnet-update","remote":true,"url":"/dvarnet","dataUrl":"/dvarnet.json","key":"vfuCguLd09"},{"type":"text","value":".","position":{"start":{"line":428,"column":1},"end":{"line":428,"column":1}},"key":"PfVJL8oKqM"}],"key":"WVzgV7pHwF"}],"key":"tATindk7nn"}],"label":"code-design-components-fourdvarnet","identifier":"code-design-components-fourdvarnet","enumerator":"12","html_id":"code-design-components-fourdvarnet","key":"jBEzjogMEi"},{"type":"thematicBreak","position":{"start":{"line":449,"column":1},"end":{"line":449,"column":1}},"key":"YBJBMhm12n"},{"type":"heading","depth":2,"position":{"start":{"line":451,"column":1},"end":{"line":451,"column":1}},"children":[{"type":"text","value":"Posterior adapters","position":{"start":{"line":451,"column":1},"end":{"line":451,"column":1}},"key":"qxnPfE6TF5"}],"identifier":"posterior-adapters","label":"Posterior adapters","html_id":"posterior-adapters","implicit":true,"key":"keauUv7lQR"},{"type":"container","kind":"code","children":[{"type":"code","lang":"python","value":"import vardax as vdx\n\n# Shapes: N state cells\n# Given: strong_4dvar, oi, incremental (built as above), batch\n\n# Classical: pair with explicit adapter\n# today (vardax)\n# x₀⋆ = argmin 𝒥(x₀)\nanalysis = strong_4dvar(batch)  # → (S, N)\n# today* (vardax; the adapter takes one window's analysis, e.g. analysis[0])\n# Σ_x|y,Laplace = (Σ_x⁻¹ + Hᵀ Σ_ε⁻¹ H)⁻¹ at x₀⋆\nposterior = vdx.LaplaceCovariance()(analysis, strong_4dvar.as_analysis_step(), batch)\n\n# OI / Incremental: direct call, no adapter\n# today (vardax)\n# Σ_x|y = (I − G H) Σ_x\nposterior = oi.posterior(batch)\n# today (vardax)\n# Σ_x|y,GN = 𝐇_GN⁻¹\nposterior = incremental.posterior(batch)\n\n# Export to population model\n# today (vardax)\nmark_likelihood = vdx.GaussianMarkLikelihood(\n    posterior=posterior,\n    event_metadata={\"event_id\": \"ev_001\", \"time\": ..., \"geometry\": ...},\n)\n# today (vardax)\nmark = mark_likelihood.to_dict()","key":"FfpPptylkI"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"code","label":"code-design-components-posterior-adapters","identifier":"code-design-components-posterior-adapters","html_id":"code-design-components-posterior-adapters","enumerator":"13","children":[{"type":"text","value":"Program 13:","key":"HBLrmmwYoe"}],"template":"Program %s:","key":"JdnaJkO4H1"},{"type":"text","value":"Builds the Laplace posterior ","position":{"start":{"line":454,"column":1},"end":{"line":454,"column":1}},"key":"qRWd5YerCs"},{"type":"crossReference","position":{"start":{"line":454,"column":1},"end":{"line":454,"column":1}},"children":[{"type":"text","value":"(13.1)","key":"CunxwbaE0e"}],"identifier":"eq-laplace-cov","label":"eq-laplace-cov","kind":"equation","template":"(%s)","enumerator":"13.1","resolved":true,"html_id":"eq-laplace-cov","remote":true,"url":"/posterior-covariance","dataUrl":"/posterior-covariance.json","key":"Solwu1Dvgq"},{"type":"text","value":" with an adapter, reads the closed-form posteriors ","position":{"start":{"line":454,"column":1},"end":{"line":454,"column":1}},"key":"qvNqRap5Kv"},{"type":"crossReference","position":{"start":{"l